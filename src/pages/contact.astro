---
const channels = [
  {
    number: "01",
    label: "EMAIL",
    title: "For work that needs room.",
    description:
      "Use email for project inquiries, research conversations, partnerships, funding questions, accessibility needs, press, and anything that deserves a thoughtful written response.",
    href: "mailto:BarklyLabs@outlook.com",
    action: "OPEN EMAIL",
    meta: "BEST FOR · PROJECTS / PARTNERSHIPS / RESEARCH",
  },
  {
    number: "02",
    label: "DISCORD",
    title: "For people building alongside us.",
    description:
      "Discord is the conversational layer of the lab. Bring ideas, experiments, questions, weird prototypes, builds, and community discussion.",
    href: "https://discord.gg/barklylabs",
    action: "JOIN DISCORD",
    meta: "BEST FOR · COMMUNITY / BUILDERS / DISCUSSION",
  },
  {
    number: "03",
    label: "TEXT MESSAGE",
    title: "For direct communication.",
    description:
      "SMS is for people who already have Barkly's contact number or have been given a direct texting channel.",
    href: "sms:+1(313) 314-1581",
    action: "START A TEXT",
    meta: "BEST FOR · DIRECT / OPERATIONAL COORDINATION",
  },
];

const messageRules = [
  {
    number: "01",
    title: "SAY WHAT THIS IS ABOUT",
    text: "Give your message a useful subject or opening line. A human should know what they're looking at immediately.",
  },
  {
    number: "02",
    title: "GIVE US THE CONTEXT",
    text: "Tell us what you're working on, what happened, or what you're trying to accomplish. A few useful details beat a wall of text.",
  },
  {
    number: "03",
    title: "SAY WHAT YOU NEED",
    text: "If you're asking a question, proposing collaboration, requesting something, or reporting a problem, say that clearly.",
  },
  {
    number: "04",
    title: "LINK THE WORK",
    text: "When relevant, include the repository, document, prototype, screenshot, or other material that lets us understand the work.",
  },
  {
    number: "05",
    title: "WRITE LIKE A HUMAN",
    text: "You don't need corporate language. You don't need perfect grammar. Clarity, kindness, and enough context are what matter.",
  },
];

const principles = [
  "HUMAN FIRST",
  "UNDERSTANDABLE",
  "ACCESSIBLE",
  "RESPECTFUL",
  "OPEN WHERE PRACTICAL",
  "PRIVACY-AWARE",
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>Contact · Barkly Labs</title>

    <meta
      name="description"
      content="Talk to Barkly Labs through email, Discord, or direct communication."
    />
  </head>

  <body>
    <div class="page">

      <!-- =========================================
           TOP BAR
      ========================================== -->

      <header class="topbar">

        <a href="/" class="brand">
          <span class="brand-mark">✦</span>
          <span>BARKLY LABS</span>
        </a>

        <div class="status">
          <span class="status-dot"></span>
          COMMUNICATIONS OPEN
        </div>

      </header>


      <main>

        <!-- =========================================
             HERO
        ========================================== -->

        <section class="hero">

          <div class="eyebrow">
            BARKLY COMMUNICATIONS · 00
          </div>

          <h1>
            TALK TO
            <em>THE LAB.</em>
          </h1>

          <p class="lede">
            Barkly is built by humans, for humans.
            If you want to ask a question, share a project,
            propose a collaboration, report a problem, or simply
            see what we're building — there's a door open.
          </p>

          <div class="hero-note">
            <span>↳</span>
            <span>YOU DO NOT NEED TO KNOW THE RIGHT WORDS.</span>
          </div>

        </section>


        <!-- =========================================
             COMMUNICATION PHILOSOPHY
        ========================================== -->

        <section class="manifesto">

          <div class="section-label">
            01 · WHY COMMUNICATION MATTERS
          </div>

          <div class="big">
            GOOD COMMUNICATION SHOULD
            <span>REDUCE THE WORK</span>
            OF BEING UNDERSTOOD.
          </div>

          <p class="body-copy">
            The Barkly Standard treats communication as part of
            the system. A contact channel shouldn't make a person
            fight through unnecessary forms, jargon, or hidden
            expectations just to reach another human.
          </p>

          <p class="body-copy">
            We still care about professional communication.
            We just don't think professional needs to mean cold,
            robotic, or difficult to understand.
          </p>

        </section>


        <!-- =========================================
             OPEN CHANNELS
        ========================================== -->

        <section class="channels">

          <div class="section-label">
            02 · OPEN CHANNELS
          </div>

          <div class="channel-grid">

            {channels.map((channel) => (
              <article class="channel">

                <div class="channel-top">
                  <span class="number">
                    {channel.number}
                  </span>

                  <span>
                    {channel.label}
                  </span>
                </div>

                <h2>
                  {channel.title}
                </h2>

                <p>
                  {channel.description}
                </p>

                <div class="channel-meta">
                  {channel.meta}
                </div>

                <a
                  class="channel-button"
                  href={channel.href}
                >
                  {channel.action}

                  <span>↗</span>
                </a>

              </article>
            ))}

          </div>

        </section>


        <!-- =========================================
             MESSAGE GUIDE
        ========================================== -->

        <section class="message-guide">

          <div class="section-label">
            03 · MAKE THE MESSAGE EASY TO RECEIVE
          </div>

          <div class="guide-head">

            <h2>
              PROFESSIONAL
              <em>DOESN'T MEAN FORMAL.</em>
            </h2>

            <p>
              The best message is one that lets another human
              understand the situation without making them
              reconstruct the entire story.
            </p>

          </div>


          <div class="rules">

            {messageRules.map((rule) => (
              <div class="rule">

                <span class="rule-number">
                  {rule.number}
                </span>

                <div>

                  <h3>
                    {rule.title}
                  </h3>

                  <p>
                    {rule.text}
                  </p>

                </div>

              </div>
            ))}

          </div>

        </section>


        <!-- =========================================
             MESSAGE EXAMPLE
        ========================================== -->

        <section class="example">

          <div class="section-label">
            04 · A USEFUL MESSAGE
          </div>

          <div class="terminal">

            <div class="terminal-bar">
              <span class="terminal-dot"></span>

              BARKLY / COMMUNICATIONS / EXAMPLE
            </div>

            <div class="terminal-body">

              <div class="subject">
                SUBJECT:
                Collaboration · Human-centered documentation
              </div>

              <p>
                Hi Barkly Labs,
              </p>

              <p>
                I'm building a small open-source project that helps
                people understand their local computer systems.
                I found Barkly Docs and think there may be some
                overlap.
              </p>

              <p>
                I'd like to talk about whether the projects could
                work together.
              </p>

              <p>
                Here's the repository:
                <span class="pink">
                  github.com/example/project
                </span>
              </p>

              <p>
                I'm mainly looking for feedback and a possible
                collaboration. No rush — I just wanted to put
                the idea in front of you.
              </p>

              <p>
                Thanks,<br />
                A human who likes making weird computers
              </p>

            </div>

          </div>


          <p class="example-note">
            Notice what isn't required: corporate language,
            a perfect pitch, or twenty paragraphs of biography.
            Context + intent + something concrete to look at
            is usually enough.
          </p>

        </section>


        <!-- =========================================
             CHANNEL ROUTING
        ========================================== -->

        <section class="routing">

          <div class="section-label">
            05 · WHICH DOOR?
          </div>

          <div class="routing-grid">

            <div>

              <span class="route-key">
                EMAIL
              </span>

              <strong>
                When it should be findable later.
              </strong>

              <p>
                Projects, partnerships, research,
                funding, and formal requests.
              </p>

            </div>


            <div>

              <span class="route-key">
                DISCORD
              </span>

              <strong>
                When conversation is useful.
              </strong>

              <p>
                Community, builders, questions,
                experiments, and collaboration.
              </p>

            </div>


            <div>

              <span class="route-key">
                SMS
              </span>

              <strong>
                When the relationship is already direct.
              </strong>

              <p>
                Coordination and direct communication
                with established contacts.
              </p>

            </div>

          </div>

        </section>


        <!-- =========================================
             PRIVACY
        ========================================== -->

        <section class="privacy">

          <div class="section-label">
            06 · HUMAN + PRIVATE
          </div>

          <div class="privacy-grid">

            <h2>
              SAY WHAT YOU
              <em>NEED.</em>
            </h2>

            <div>

              <p>
                Please don't send passwords, authentication codes,
                financial credentials, or other highly sensitive
                information through ordinary contact channels.
              </p>

              <p>
                If a conversation needs a more appropriate secure
                process, we'll help establish one.
              </p>

              <p>
                Privacy is part of good system design —
                not an afterthought.
              </p>

            </div>

          </div>

        </section>


        <!-- =========================================
             BARKLY STANDARD
        ========================================== -->

        <section class="standard">

          <div class="section-label">
            07 · BARKLY STANDARD
          </div>

          <h2>
            COMMUNICATION IS
            <em>PART OF THE DESIGN.</em>
          </h2>

          <div class="principles">

            {principles.map((principle) => (
              <span>
                {principle}
              </span>
            ))}

          </div>

        </section>


        <!-- =========================================
             CLOSING
        ========================================== -->

        <section class="closing">

          <div class="closing-mark">
            ✦
          </div>

          <div class="section-label">
            BARKLY LABS / ENDPOINT
          </div>

          <h2>
            COME TALK.
            <em>COME BUILD.</em>
          </h2>

          <p>
            The lab is still becoming itself.
            That's the fun part.
            Bring an idea, a question, a prototype, a problem,
            or just curiosity.
          </p>

        </section>

      </main>


      <!-- =========================================
           FOOTER
      ========================================== -->

      <footer>

        <span>
          BARKLY LABS
        </span>

        <span>
          HUMAN-FIRST · OPEN · EXPERIMENTAL
        </span>

        <span>
          COMMUNICATIONS / ONLINE
        </span>

      </footer>

    </div>
  </body>
</html>


<style>

  /* =========================================
     BASE
  ========================================== */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #050505;
    color: #f2f2f2;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;

    background: #050505;
    color: #f2f2f2;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(a) {
    color: inherit;
  }


  /* =========================================
     PAGE
  ========================================== */

  .page {
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(255, 79, 163, .09),
        transparent 34rem
      ),
      #050505;
  }


  /* =========================================
     TOP BAR
  ========================================== */

  .topbar {
    min-height: 70px;

    padding: 0 5vw;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom:
      1px solid rgba(255,255,255,.12);

    font-size: 11px;

    letter-spacing: .14em;

    font-weight: 700;
  }

  .brand {
    display: flex;
    align-items: center;

    gap: 12px;

    text-decoration: none;
  }

  .brand-mark {
    color: #ff4fa3;

    font-size: 20px;
  }

  .status {
    color:
      rgba(255,255,255,.5);
  }

  .status-dot {
    display: inline-block;

    width: 7px;
    height: 7px;

    margin-right: 8px;

    border-radius: 50%;

    background: #ff4fa3;

    box-shadow:
      0 0 15px
      rgba(255,79,163,.75);
  }


  /* =========================================
     HERO
  ========================================== */

  .hero {
    min-height: 78vh;

    padding:
      11vh 8vw
      9vh;

    display: flex;

    flex-direction: column;

    justify-content: center;

    border-bottom:
      1px solid rgba(255,255,255,.1);

    position: relative;
  }

  .hero::before {
    content: "";

    position: absolute;

    inset: 0;

    pointer-events: none;

    background-image:
      linear-gradient(
        rgba(255,79,163,.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,79,163,.035) 1px,
        transparent 1px
      );

    background-size: 42px 42px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 80%
      );
  }

  .eyebrow,
  .section-label {
    color: #ff4fa3;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .2em;

    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    position: relative;
  }

  h1 {
    max-width: 1100px;

    margin:
      25px 0
      32px;

    font-size:
      clamp(4.5rem, 12vw, 12rem);

    line-height: .79;

    letter-spacing: -.075em;

    font-weight: 900;
  }

  h1 em,
  h2 em {
    display: block;

    color: #ff4fa3;

    font-style: normal;
  }

  .lede {
    max-width: 670px;

    margin: 0;

    color:
      rgba(255,255,255,.68);

    font-size:
      clamp(17px, 2vw, 23px);

    line-height: 1.55;
  }

  .hero-note {
    display: flex;

    gap: 12px;

    margin-top: 45px;

    color:
      rgba(255,255,255,.42);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .15em;
  }

  .hero-note span:first-child {
    color: #ff4fa3;
  }


  /* =========================================
     SECTIONS
  ========================================== */

  section {
    padding:
      110px 8vw;

    border-bottom:
      1px solid rgba(255,255,255,.1);
  }


  /* =========================================
     MANIFESTO
  ========================================== */

  .manifesto .big {
    max-width: 1100px;

    margin:
      60px 0
      35px;

    font-size:
      clamp(3rem, 7vw, 7.5rem);

    line-height: .88;

    letter-spacing: -.06em;

    font-weight: 900;
  }

  .big span {
    color: #ff4fa3;
  }

  .body-copy {
    max-width: 700px;

    color:
      rgba(255,255,255,.57);

    font-size: 16px;

    line-height: 1.75;
  }


  /* =========================================
     CHANNELS
  ========================================== */

  .channel-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 1px;

    margin-top: 55px;

    background:
      rgba(255,255,255,.13);

    border:
      1px solid rgba(255,255,255,.13);
  }

  .channel {
    min-height: 470px;

    padding: 35px;

    background: #090909;

    display: flex;

    flex-direction: column;
  }

  .channel:hover {
    background: #0e0e0e;
  }

  .channel-top {
    display: flex;

    justify-content: space-between;

    color:
      rgba(255,255,255,.42);

    font-size: 10px;

    letter-spacing: .15em;

    font-weight: 800;
  }

  .number {
    color: #ff4fa3;
  }

  .channel h2 {
    margin:
      65px 0
      20px;

    font-size:
      clamp(2rem, 3vw, 3.2rem);

    line-height: .95;

    letter-spacing: -.05em;
  }

  .channel p {
    color:
      rgba(255,255,255,.55);

    line-height: 1.65;

    font-size: 14px;
  }

  .channel-meta {
    margin-top: auto;

    padding:
      20px 0;

    color:
      rgba(255,255,255,.32);

    font-size: 9px;

    letter-spacing: .13em;

    line-height: 1.5;
  }

  .channel-button {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding:
      16px 17px;

    color: #050505;

    background: #ff4fa3;

    text-decoration: none;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: .13em;

    transition:
      transform .15s ease,
      box-shadow .15s ease;
  }

  .channel-button:hover {
    transform:
      translateY(-2px);

    box-shadow:
      0 8px 30px
      rgba(255,79,163,.2);
  }


  /* =========================================
     MESSAGE GUIDE
  ========================================== */

  .guide-head {
    margin-top: 55px;

    display: grid;

    grid-template-columns:
      1.2fr .8fr;

    gap: 8vw;

    align-items: end;
  }

  .guide-head h2,
  .standard h2,
  .closing h2 {
    margin: 0;

    font-size:
      clamp(3rem, 6vw, 7rem);

    line-height: .83;

    letter-spacing: -.065em;

    font-weight: 900;
  }

  .guide-head > p {
    margin: 0;

    color:
      rgba(255,255,255,.55);

    line-height: 1.7;
  }

  .rules {
    margin-top: 75px;

    border-top:
      1px solid
      rgba(255,255,255,.13);
  }

  .rule {
    display: grid;

    grid-template-columns:
      80px 1fr;

    gap: 25px;

    padding:
      28px 0;

    border-bottom:
      1px solid
      rgba(255,255,255,.13);
  }

  .rule-number {
    color: #ff4fa3;

    font-size: 11px;

    font-weight: 900;

    letter-spacing: .15em;
  }

  .rule h3 {
    margin:
      0 0
      8px;

    font-size: 13px;

    letter-spacing: .13em;
  }

  .rule p {
    max-width: 750px;

    margin: 0;

    color:
      rgba(255,255,255,.5);

    line-height: 1.65;
  }


  /* =========================================
     TERMINAL
  ========================================== */

  .terminal {
    max-width: 950px;

    margin-top: 55px;

    border:
      1px solid
      rgba(255,79,163,.4);

    background: #070707;

    box-shadow:
      0 0 50px
      rgba(255,79,163,.06);
  }

  .terminal-bar {
    padding:
      13px 17px;

    border-bottom:
      1px solid
      rgba(255,255,255,.1);

    color:
      rgba(255,255,255,.4);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Consolas,
      monospace;

    font-size: 10px;

    letter-spacing: .12em;
  }

  .terminal-dot {
    display: inline-block;

    width: 6px;
    height: 6px;

    margin-right: 10px;

    border-radius: 50%;

    background: #ff4fa3;
  }

  .terminal-body {
    padding: 35px;

    color:
      rgba(255,255,255,.65);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Consolas,
      monospace;

    font-size: 13px;

    line-height: 1.8;
  }

  .terminal-body .subject {
    margin-bottom: 28px;

    color: #ff4fa3;
  }

  .pink {
    color: #ff4fa3;
  }

  .example-note {
    max-width: 750px;

    margin-top: 25px;

    color:
      rgba(255,255,255,.4);

    line-height: 1.7;

    font-size: 13px;
  }


  /* =========================================
     ROUTING
  ========================================== */

  .routing-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 35px;

    margin-top: 55px;
  }

  .routing-grid > div {
    border-top:
      2px solid #ff4fa3;

    padding-top: 20px;
  }

  .route-key {
    display: block;

    margin-bottom: 25px;

    color: #ff4fa3;

    font-size: 10px;

    letter-spacing: .18em;

    font-weight: 900;
  }

  .routing strong {
    display: block;

    font-size: 19px;
  }

  .routing p {
    color:
      rgba(255,255,255,.45);

    line-height: 1.6;
  }


  /* =========================================
     PRIVACY
  ========================================== */

  .privacy-grid {
    margin-top: 55px;

    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 10vw;
  }

  .privacy-grid h2 {
    margin: 0;

    font-size:
      clamp(3rem, 6vw, 7rem);

    line-height: .82;

    letter-spacing: -.065em;
  }

  .privacy-grid p {
    color:
      rgba(255,255,255,.55);

    line-height: 1.75;
  }


  /* =========================================
     BARKLY STANDARD
  ========================================== */

  .standard h2 {
    margin-top: 50px;
  }

  .principles {
    display: flex;

    flex-wrap: wrap;

    gap: 9px;

    margin-top: 45px;
  }

  .principles span {
    padding:
      10px 13px;

    border:
      1px solid
      rgba(255,79,163,.35);

    color:
      rgba(255,255,255,.6);

    font-size: 10px;

    letter-spacing: .12em;

    font-weight: 800;
  }


  /* =========================================
     CLOSING
  ========================================== */

  .closing {
    min-height: 70vh;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;
  }

  .closing-mark {
    color: #ff4fa3;

    font-size: 42px;

    margin-bottom: 30px;
  }

  .closing h2 {
    margin-top: 30px;
  }

  .closing p {
    max-width: 600px;

    margin-top: 35px;

    color:
      rgba(255,255,255,.55);

    line-height: 1.7;

    font-size: 17px;
  }


  /* =========================================
     FOOTER
  ========================================== */

  footer {
    padding:
      28px 5vw;

    display: flex;

    justify-content: space-between;

    gap: 20px;

    color:
      rgba(255,255,255,.28);

    font-size: 9px;

    font-weight: 800;

    letter-spacing: .15em;
  }


  /* =========================================
     MOBILE
  ========================================== */

  @media (max-width: 850px) {

    .channel-grid,
    .routing-grid,
    .guide-head,
    .privacy-grid {
      grid-template-columns: 1fr;
    }

    .channel {
      min-height: 400px;
    }

    .hero {
      min-height: 70vh;
    }

    section {
      padding:
        80px 6vw;
    }

    .terminal-body {
      padding: 22px;
    }

    footer {
      flex-direction: column;

      line-height: 1.6;
    }

  }

</style>