    <meta
      name="description"
      content="Barkly Labs project registry. A live index of projects, experiments, infrastructure, and research repositories."
    />

    <title>Projects // Barkly Labs</title>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Barkly Labs home">
        <span>BARKLY</span>
        <span>LABS</span>
      </a>

      <nav>
        <a href="/">HOME</a>
        <a href="/projects" aria-current="page">PROJECTS</a>
        <a href="/docs">DOCS</a>
        <a
          href={`https://github.com/${GITHUB_ORG}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          GITHUB ↗
        </a>
      </nav>

      <div class="status">
        <span class="status-dot"></span>
        LIVE REGISTRY
      </div>
    </header>

    <main>
      <!-- HERO -->

      <section class="hero">
        <div class="eyebrow">
          BARKLY LABS // PROJECT REGISTRY
        </div>

        <h1 class="hero-title">
          THE<br />
          <span>PROJECTS.</span>
        </h1>

        <div class="hero-bottom">
          <p class="hero-description">
            A live index of the systems, experiments, tools, standards,
            interfaces, and research being developed across Barkly Labs.
          </p>

          <div class="hero-mark" aria-hidden="true">
            <span>B</span><span>/</span><span>L</span>
          </div>
        </div>
      </section>

      <!-- REGISTRY SUMMARY -->

      <section class="registry-summary">
        <div class="section-number">01</div>

        <div class="summary-content">
          <div class="summary-heading">
            <h2>THE WORK.</h2>

            <p>
              Barkly projects are built as parts of a larger ecosystem.
              GitHub provides the repository data; Barkly provides the
              human-readable structure around it.
            </p>
          </div>

          <div class="stats">
            <div class="stat">
              <span class="stat-number">{repositories.length}</span>
              <span class="stat-label">REPOSITORIES</span>
            </div>

            <div class="stat">
              <span class="stat-number">{activeRepositories.length}</span>
              <span class="stat-label">ACTIVE</span>
            </div>

            <div class="stat">
              <span class="stat-number">{languages.length}</span>
              <span class="stat-label">LANGUAGES</span>
            </div>

            <div class="stat">
              <span class="stat-number">{archivedRepositories.length}</span>
              <span class="stat-label">ARCHIVED</span>
            </div>
          </div>
        </div>
      </section>

      <!-- PROJECTS -->

      <section class="projects-section">
        <div class="section-heading">
          <div class="section-number">02</div>

          <div>
            <p class="section-tag">PROJECT INDEX</p>
            <h2>
              ALL<br />
              <span>PROJECTS.</span>
            </h2>
          </div>
        </div>

        {
          repositories.length === 0 ? (
            <div class="empty-state">
              <span class="empty-code">ERR / 001</span>
              <strong>NO REPOSITORIES RETURNED.</strong>
              <p>
                GitHub did not return any repositories for this organization.
              </p>
            </div>
          ) : (
            <div class="project-grid">
              {repositories.map((repo, index) => (
                <article class="project-card">
                  <div class="card-top">
                    <span class="card-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span class={`card-status ${statusClass(repo)}`}>
                      <span class="status-dot"></span>
                      {status(repo)}
                    </span>
                  </div>

                  <div class="card-main">
                    <p class="project-type">
                      {projectType(repo)}
                    </p>

                    <h3>{repo.name}</h3>

                    <p class="project-description">
                      {repo.description ||
                        "No repository description provided."}
                    </p>
                  </div>

                  <div class="card-data">
                    <div>
                      <span>LANGUAGE</span>
                      <strong>
                        {repo.language || "UNSPECIFIED"}
                      </strong>
                    </div>

                    <div>
                      <span>UPDATED</span>
                      <strong>{formatDate(repo.updated_at)}</strong>
                    </div>

                    <div>
                      <span>STARS</span>
                      <strong>{repo.stargazers_count}</strong>
                    </div>

                    <div>
                      <span>FORKS</span>
                      <strong>{repo.forks_count}</strong>
                    </div>
                  </div>

                  {
                    repo.topics?.length > 0 && (
                      <div class="topics">
                        {repo.topics.slice(0, 5).map((topic) => (
                          <span>{topic}</span>
                        ))}
                      </div>
                    )
                  }

                  <div class="card-footer">
                    <span>
                      {repo.full_name}
                    </span>

                    <a
                      href={repo.html_url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      GITHUB ↗
                    </a>
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </section>

      <!-- ARCHITECTURE -->

      <section class="architecture">
        <div class="section-number">03</div>

        <div class="architecture-content">
          <p class="section-tag">REGISTRY ARCHITECTURE</p>

          <h2>
            ONE SOURCE.<br />
            <span>HUMAN INTERFACE.</span>
          </h2>

          <div class="pipeline">
            <div>
              <span>01</span>
              <strong>GITHUB</strong>
              <small>REPOSITORY DATA</small>
            </div>

            <div class="arrow">→</div>

            <div>
              <span>02</span>
              <strong>REGISTRY</strong>
              <small>NORMALIZATION</small>
            </div>

            <div class="arrow">→</div>

            <div>
              <span>03</span>
              <strong>BARKLY</strong>
              <small>HUMAN INTERFACE</small>
            </div>

            <div class="arrow">→</div>

            <div>
              <span>04</span>
              <strong>PROJECT CARD</strong>
              <small>UNDERSTANDABLE OUTPUT</small>
            </div>
          </div>
        </div>
      </section>

      <!-- GITHUB LINK -->

      <section class="github-section">
        <div class="github-copy">
          <p class="section-tag">SOURCE</p>

          <h2>
            THE CODE<br />
            <span>IS PUBLIC.</span>
          </h2>

          <p>
            The project registry is generated directly from the Barkly Labs
            GitHub organization. Repository metadata remains connected to the
            source rather than being manually duplicated on the website.
          </p>
        </div>

        <a
          class="github-button"
          href={`https://github.com/${GITHUB_ORG}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          OPEN BARKLY ON GITHUB ↗
        </a>
      </section>
    </main>

    <footer>
      <div class="footer-brand">
        <strong>
          <span>BARKLY</span> <span>LABS</span>
        </strong>

        <span>PROJECT REGISTRY</span>
      </div>

      <div>
        GITHUB // {GITHUB_ORG}
      </div>

      <div>
        © 2026 BARKLY LABS
      </div>
    </footer>
  </body>
</html>

