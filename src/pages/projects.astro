---
export const prerender = false;

const GITHUB_ORG = "Barkly-Labs";

type GitHubRepository = {
  id: number;
  name: string;
  full_name: string;
  html_url: string;
  description: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  updated_at: string;
  created_at: string;
  archived: boolean;
  fork: boolean;
  topics?: string[];
};

type Project = GitHubRepository & {
  projectType: string;
  projectStatus: string;
  statusClass: string;
};

async function getRepositories(): Promise<Project[]> {
  const repositories: GitHubRepository[] = [];

  let page = 1;
  const perPage = 100;

  try {
    while (true) {
      const response = await fetch(
        `https://api.github.com/orgs/${GITHUB_ORG}/repos?per_page=${perPage}&page=${page}&sort=updated`,
        {
          headers: {
            Accept: "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
          },
        },
      );

      if (!response.ok) {
        console.error(
          `GitHub API error: ${response.status} ${response.statusText}`,
        );
        break;
      }

      const data = (await response.json()) as GitHubRepository[];

      if (!Array.isArray(data) || data.length === 0) {
        break;
      }

      repositories.push(...data);

      if (data.length < perPage) {
        break;
      }

      page++;

      // Safety limit so a broken API response cannot loop forever.
      if (page > 10) {
        break;
      }
    }
  } catch (error) {
    console.error("Failed to fetch Barkly Labs repositories:", error);
  }

  return repositories
    .filter((repo) => !repo.archived)
    .map((repo) => ({
      ...repo,
      projectType: getProjectType(repo),
      projectStatus: getProjectStatus(repo),
      statusClass: getStatusClass(repo),
    }));
}

function getProjectType(repo: GitHubRepository): string {
  const name = repo.name.toLowerCase();
  const description = (repo.description ?? "").toLowerCase();
  const topics = (repo.topics ?? []).map((topic) => topic.toLowerCase());

  const text = [name, description, ...topics].join(" ");

  if (
    text.includes("ai") ||
    text.includes("llm") ||
    text.includes("model") ||
    text.includes("cyn-x") ||
    text.includes("cynx")
  ) {
    return "INTELLIGENCE";
  }

  if (
    text.includes("docs") ||
    text.includes("documentation") ||
    text.includes("standard")
  ) {
    return "DOCUMENTATION";
  }

  if (
    text.includes("hardware") ||
    text.includes("board") ||
    text.includes("gpio") ||
    text.includes("pcb")
  ) {
    return "HARDWARE";
  }

  if (
    text.includes("api") ||
    text.includes("backend") ||
    text.includes("server")
  ) {
    return "INFRASTRUCTURE";
  }

  if (
    text.includes("web") ||
    text.includes("site") ||
    text.includes("astro") ||
    text.includes("frontend")
  ) {
    return "INTERFACE";
  }

  return "RESEARCH";
}

function getProjectStatus(repo: GitHubRepository): string {
  if (repo.archived) {
    return "ARCHIVED";
  }

  if (repo.fork) {
    return "FORK";
  }

  return "ACTIVE";
}

function getStatusClass(repo: GitHubRepository): string {
  if (repo.archived) {
    return "archived";
  }

  if (repo.fork) {
    return "fork";
  }

  return "active";
}

function formatDate(date: string): string {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(new Date(date));
}

const repositories = await getRepositories();

const activeProjects = repositories.filter(
  (repo) => !repo.archived && !repo.fork,
);

const archivedProjects = repositories.filter(
  (repo) => repo.archived,
);

const forkedProjects = repositories.filter(
  (repo) => repo.fork,
);

const languageCounts = repositories.reduce<Record<string, number>>(
  (counts, repo) => {
    if (repo.language) {
      counts[repo.language] = (counts[repo.language] ?? 0) + 1;
    }

    return counts;
  },
  {},
);

const primaryLanguages = Object.entries(languageCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
