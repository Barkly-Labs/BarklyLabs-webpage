---
import SEO from "../components/SEO.astro";

export const prerender = true;

const GITHUB_ORG = "Barkly-Labs";

/*
 * Barkly Project Registry
 *
 * The registry does not treat GitHub repository metadata alone
 * as the project's current state.
 *
 * Barkly checks the repository's actual Git history and uses
 * the most recent commit to determine whether a project is stale.
 *
 * Barkly standard:
 *
 * Show the shape first.
 * Front-load the hard stuff for humans.
 * Do not pretend an old experiment is an active system.
 */

const STALE_DAYS = 365;
const STALE_MS = STALE_DAYS * 24 * 60 * 60 * 1000;

/*
 * GitHub API authentication
 *
 * The VPS may provide:
 *
 * GITHUB_TOKEN=...
 *
 * Authenticated GitHub API requests receive a much higher
 * rate limit than anonymous requests.
 *
 * The registry still works without a token.
 */

const GITHUB_TOKEN =
  import.meta.env.GITHUB_TOKEN?.trim() || "";

function githubHeaders(): Record<string, string> {
  const headers: Record<string, string> = {
    Accept: "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28",
  };

  if (GITHUB_TOKEN) {
    headers.Authorization = `Bearer ${GITHUB_TOKEN}`;
  }

  return headers;
}

type GitHubRepository = {
  id: number;
  name: string;
  full_name: string;
  html_url: string;
  description: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  watchers_count: number;
  open_issues_count: number;
  updated_at: string;
  created_at: string;
  pushed_at: string | null;
  archived: boolean;
  fork: boolean;
  topics?: string[];
  default_branch: string;
};

type GitHubCommit = {
  sha: string;
  commit: {
    author: {
      date: string | null;
    } | null;
    committer: {
      date: string | null;
    } | null;
    message: string;
  };
};

type GitHubRepositoryWithCommit = GitHubRepository & {
  latestCommitDate: string | null;
  latestCommitSha: string | null;
  latestCommitMessage: string | null;
};

type Project = GitHubRepositoryWithCommit & {
  projectType: string;
  projectStatus: string;
  statusClass: string;
};

async function getLatestCommit(
  repo: GitHubRepository,
): Promise<{
  latestCommitDate: string | null;
  latestCommitSha: string | null;
  latestCommitMessage: string | null;
}> {
  try {
    const response = await fetch(
      `https://api.github.com/repos/${repo.full_name}/commits?per_page=1`,
      {
        headers: githubHeaders(),
      },
    );

    if (!response.ok) {
      console.error(
        `GitHub commit API error for ${repo.name}: ${response.status} ${response.statusText}`,
      );

      /*
       * GitHub may rate-limit an unauthenticated request.
       *
       * Do not pretend that repository metadata is a real commit.
       * The pushed_at timestamp is retained only as a graceful
       * availability fallback so the public registry can still build.
       */
      return {
        latestCommitDate: repo.pushed_at ?? repo.updated_at,
        latestCommitSha: null,
        latestCommitMessage: null,
      };
    }

    const data = (await response.json()) as unknown;

    if (!Array.isArray(data)) {
      console.error(
        `GitHub commit API returned unexpected data for ${repo.name}.`,
      );

      return {
        latestCommitDate: repo.pushed_at ?? repo.updated_at,
        latestCommitSha: null,
        latestCommitMessage: null,
      };
    }

    const latest = data[0] as GitHubCommit | undefined;

    if (!latest) {
      return {
        latestCommitDate: repo.pushed_at ?? repo.updated_at,
        latestCommitSha: null,
        latestCommitMessage: null,
      };
    }

    const latestCommitDate =
      latest.commit?.author?.date ??
      latest.commit?.committer?.date ??
      repo.pushed_at ??
      repo.updated_at;

    return {
      latestCommitDate,
      latestCommitSha: latest.sha ?? null,
      latestCommitMessage:
        latest.commit?.message ?? null,
    };
  } catch (error) {
    console.error(
      `Failed to retrieve latest commit for ${repo.name}:`,
      error,
    );

    return {
      latestCommitDate: repo.pushed_at ?? repo.updated_at,
      latestCommitSha: null,
      latestCommitMessage: null,
    };
  }
}

async function getRepositories(): Promise<Project[]> {
  const repositories: GitHubRepository[] = [];

  let page = 1;
  const perPage = 100;

  try {
    while (true) {
      const response = await fetch(
        `https://api.github.com/orgs/${GITHUB_ORG}/repos?per_page=${perPage}&page=${page}&sort=updated&direction=desc`,
        {
          headers: githubHeaders(),
        },
      );

      if (!response.ok) {
        console.error(
          `GitHub API error: ${response.status} ${response.statusText}`,
        );

        /*
         * GitHub returns an object such as:
         *
         * {
         *   "message": "API rate limit exceeded..."
         * }
         *
         * Do not cast that object into GitHubRepository[].
         * That was the source of the TypeError you saw when
         * piping the API response into Python.
         */

        break;
      }

      const data = (await response.json()) as unknown;

      if (!Array.isArray(data)) {
        console.error(
          "GitHub repository API returned unexpected data.",
        );

        break;
      }

      if (data.length === 0) {
        break;
      }

      const validRepositories =
        data.filter(
          (repo): repo is GitHubRepository =>
            typeof repo === "object" &&
            repo !== null &&
            "name" in repo &&
            "full_name" in repo &&
            "html_url" in repo,
        );

      repositories.push(...validRepositories);

      if (data.length < perPage) {
        break;
      }

      page++;

      // Safety limit.
      if (page > 10) {
        break;
      }
    }
  } catch (error) {
    console.error(
      "Failed to fetch Barkly Labs repositories:",
      error,
    );
  }

  const projects = await Promise.all(
    repositories.map(async (repo) => {
      const commit = await getLatestCommit(repo);

      const project = {
        ...repo,
        ...commit,
      };

      return {
        ...project,
        projectType: getProjectType(project),
        projectStatus: getProjectStatus(project),
        statusClass: getStatusClass(project),
      };
    }),
  );

  return projects;
}

function getProjectType(
  repo: GitHubRepository,
): string {
  const name = repo.name.toLowerCase();

  const description = (
    repo.description ?? ""
  ).toLowerCase();

  const topics = (repo.topics ?? []).map(
    (topic) => topic.toLowerCase(),
  );

  const text = [
    name,
    description,
    ...topics,
  ].join(" ");

  if (
    text.includes("ai") ||
    text.includes("llm") ||
    text.includes("model") ||
    text.includes("cyn-x") ||
    text.includes("cynx") ||
    text.includes("intelligence")
  ) {
    return "INTELLIGENCE";
  }

  if (
    text.includes("docs") ||
    text.includes("documentation") ||
    text.includes("standard")
  ) {
    return "DOCUMENTATION";
  }

  if (
    text.includes("hardware") ||
    text.includes("board") ||
    text.includes("gpio") ||
    text.includes("pcb") ||
    text.includes("embedded")
  ) {
    return "HARDWARE";
  }

  if (
    text.includes("api") ||
    text.includes("backend") ||
    text.includes("server") ||
    text.includes("service")
  ) {
    return "INFRASTRUCTURE";
  }

  if (
    text.includes("web") ||
    text.includes("site") ||
    text.includes("astro") ||
    text.includes("frontend") ||
    text.includes("interface")
  ) {
    return "INTERFACE";
  }

  if (
    text.includes("vision") ||
    text.includes("opencv") ||
    text.includes("image") ||
    text.includes("camera")
  ) {
    return "VISION";
  }

  return "RESEARCH";
}

function getProjectStatus(
  repo: GitHubRepositoryWithCommit,
): string {
  if (repo.archived) {
    return "ARCHIVED";
  }

  if (repo.fork) {
    return "FORK";
  }

  if (!repo.latestCommitDate) {
    return "UNKNOWN";
  }

  const latestCommitTime = new Date(
    repo.latestCommitDate,
  ).getTime();

  if (
    Date.now() - latestCommitTime >
    STALE_MS
  ) {
    return "STALE";
  }

  return "ACTIVE";
}

function getStatusClass(
  repo: GitHubRepositoryWithCommit,
): string {
  if (repo.archived) {
    return "archived";
  }

  if (repo.fork) {
    return "fork";
  }

  if (!repo.latestCommitDate) {
    return "unknown";
  }

  const latestCommitTime = new Date(
    repo.latestCommitDate,
  ).getTime();

  if (
    Date.now() - latestCommitTime >
    STALE_MS
  ) {
    return "stale";
  }

  return "active";
}

function formatDate(date: string): string {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(new Date(date));
}

const repositories = await getRepositories();

const activeRepositories = repositories.filter(
  (repo) => repo.projectStatus === "ACTIVE",
);

const staleRepositories = repositories.filter(
  (repo) => repo.projectStatus === "STALE",
);

const archivedRepositories = repositories.filter(
  (repo) => repo.projectStatus === "ARCHIVED",
);

const forkedRepositories = repositories.filter(
  (repo) => repo.projectStatus === "FORK",
);

const languageCounts = repositories.reduce<
  Record<string, number>
>(
  (counts, repo) => {
    if (repo.language) {
      counts[repo.language] =
        (counts[repo.language] ?? 0) + 1;
    }

    return counts;
  },
  {},
);

const languages = Object.entries(languageCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);

const totalStars = repositories.reduce(
  (total, repo) =>
    total + repo.stargazers_count,
  0,
);

const totalForks = repositories.reduce(
  (total, repo) =>
    total + repo.forks_count,
  0,
);

const lastUpdated =
  repositories.length > 0
    ? repositories.reduce((latest, repo) => {
        const latestDate =
          latest.latestCommitDate ??
          latest.updated_at;

        const repoDate =
          repo.latestCommitDate ??
          repo.updated_at;

        return new Date(repoDate) >
          new Date(latestDate)
          ? repo
          : latest;
      })
    : null;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <SEO />
</head>

<body>
  <header class="topbar">
    <a
      href={import.meta.env.BASE_URL}
      class="brand"
    >
      <span>BARKLY</span>
      <span>LABS</span>
    </a>

    <div class="top-status">
      PROJECT REGISTRY / PUBLIC RESEARCH
    </div>

    <a
      href={import.meta.env.BASE_URL}
      class="back"
    >
      ← RETURN TO LABS
    </a>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>

      <div class="hero-orbit orbit-one"></div>
      <div class="hero-orbit orbit-two"></div>

      <div class="hero-content">
        <div class="eyebrow">
          <span>01</span>
          BARKLY PROJECT REGISTRY
        </div>

        <h1>
          THE LAB
          <span>IN MOTION.</span>
        </h1>

        <p>
          A live view of the software, systems,
          experiments, documentation, hardware,
          and research being built inside
          Barkly Labs.
        </p>

        <p class="hero-dim">
          This registry is generated directly
          from the public Barkly Labs GitHub
          organization and checks repository
          history to understand project activity.
        </p>

        <div class="hero-actions">
          <a
            class="primary"
            href={`https://github.com/${GITHUB_ORG}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            OPEN GITHUB ↗
          </a>

          <a href="#registry">
            EXPLORE PROJECTS ↓
          </a>
        </div>
      </div>

      <div class="hero-side">
        PUBLIC REPOSITORIES<br />
        GIT HISTORY AWARE<br />
        AUTOMATED REGISTRY<br />
        BARKLY LABS
      </div>

      <div class="hero-scroll">
        DISCOVER / BUILD / DOCUMENT / SHARE
        <b></b>
      </div>
    </section>

    <!-- CENTRAL QUESTION -->
    <section class="section question">
      <header class="section-header">
        <small>02</small>

        <div>
          <label>THE CENTRAL QUESTION</label>

          <h2>
            WHAT ARE WE
            <span>BUILDING?</span>
          </h2>
        </div>
      </header>

      <div class="question-grid">
        <div class="question-large">
          The repository is only the beginning.
        </div>

        <div class="question-copy">
          <p>
            Barkly Labs treats software repositories
            as pieces of a larger research ecosystem.
          </p>

          <p>
            A project can become a tool, an experiment,
            infrastructure, a hardware platform,
            documentation, or something nobody
            expected when it started.
          </p>

          <p class="bright">
            The registry shows the shape of the lab
            as it actually exists.
          </p>
        </div>
      </div>
    </section>

    <!-- REGISTRY -->
    <section id="registry" class="section">
      <header class="section-header">
        <small>03</small>

        <div>
          <label>LIVE GITHUB REGISTRY</label>

          <h2>
            THE
            <span>PROJECTS.</span>
          </h2>
        </div>
      </header>

      <!-- STATS -->
      <div class="stats">
        <div class="stat">
          <span class="stat-number">
            {repositories.length}
          </span>

          <span class="stat-label">
            TOTAL REPOSITORIES
          </span>
        </div>

        <div class="stat">
          <span class="stat-number">
            {activeRepositories.length}
          </span>

          <span class="stat-label">
            ACTIVE PROJECTS
          </span>
        </div>

        <div class="stat">
          <span class="stat-number">
            {staleRepositories.length}
          </span>

          <span class="stat-label">
            STALE PROJECTS
          </span>
        </div>

        <div class="stat">
          <span class="stat-number">
            {totalStars}
          </span>

          <span class="stat-label">
            STARS
          </span>
        </div>
      </div>

      <!-- ACTIVITY -->
      <div class="activity-strip">
        <div class="activity-title">
          PROJECT ACTIVITY
        </div>

        <div class="activity-list">
          <span class="activity active">
            <b>{activeRepositories.length}</b>
            ACTIVE
          </span>

          <span class="activity stale">
            <b>{staleRepositories.length}</b>
            STALE
          </span>

          <span class="activity archived">
            <b>{archivedRepositories.length}</b>
            ARCHIVED
          </span>

          <span class="activity fork">
            <b>{forkedRepositories.length}</b>
            FORKS
          </span>
        </div>

        <div class="activity-rule">
          STALE = NO COMMIT FOR {STALE_DAYS} DAYS
        </div>
      </div>

      <!-- LANGUAGES -->
      {languages.length > 0 && (
        <div class="language-strip">
          <div class="language-title">
            DETECTED LANGUAGES
          </div>

          <div class="language-list">
            {languages.map(
              ([language, count]) => (
                <span class="language">
                  <b>{language}</b>

                  <small>
                    {count}
                    {count === 1
                      ? " REPO"
                      : " REPOS"}
                  </small>
                </span>
              ),
            )}
          </div>
        </div>
      )}

      <!-- PROJECT CARDS -->
      {repositories.length > 0 ? (
        <div class="project-grid">
          {repositories.map((project, index) => (
            <a
              class="project-card"
              href={project.html_url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${project.name} repository on GitHub`}
            >
              <!-- IDENTITY -->
              <div class="project-top">
                <span class="project-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span
                  class={`status ${project.statusClass}`}
                >
                  {project.projectStatus}
                </span>
              </div>

              <!-- TYPE -->
              <div class="project-type">
                {project.projectType}
              </div>

              <!-- PROJECT -->
              <h3>
                {project.name}
              </h3>

              <p class="project-description">
                {project.description ||
                  "No repository description has been provided yet."}
              </p>

              <!-- METADATA -->
              <div class="project-meta">
                <div>
                  <span>LANGUAGE</span>

                  <strong>
                    {project.language || "—"}
                  </strong>
                </div>

                <div>
                  <span>LAST COMMIT</span>

                  <strong>
                    {project.latestCommitDate
                      ? formatDate(
                          project.latestCommitDate,
                        )
                      : "UNKNOWN"}
                  </strong>
                </div>

                <div>
                  <span>STARS</span>

                  <strong>
                    {project.stargazers_count}
                  </strong>
                </div>

                <div>
                  <span>FORKS</span>

                  <strong>
                    {project.forks_count}
                  </strong>
                </div>
              </div>

              <!-- GIT HISTORY -->
              <div class="commit-info">
                <span>GIT HISTORY</span>

                <strong>
                  {project.latestCommitDate
                    ? new Date(
                        project.latestCommitDate,
                      ).getFullYear()
                    : "UNKNOWN"}
                </strong>
              </div>

              <!-- TOPICS -->
              {project.topics &&
                project.topics.length > 0 && (
                  <div class="topics">
                    {project.topics
                      .slice(0, 6)
                      .map((topic) => (
                        <span>
                          #{topic}
                        </span>
                      ))}
                  </div>
                )}

              <!-- ACTION -->
              <div class="project-link">
                <span>VIEW REPOSITORY</span>

                <span
                  class="project-link-arrow"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty">
          <div class="empty-mark">
            [ ! ]
          </div>

          <h3>
            NO REPOSITORIES RETURNED.
          </h3>

          <p>
            GitHub did not return any public
            repositories for the Barkly Labs
            organization.
          </p>
        </div>
      )}
    </section>

    <!-- ARCHITECTURE -->
    <section class="section architecture">
      <header class="section-header">
        <small>04</small>

        <div>
          <label>REGISTRY ARCHITECTURE</label>

          <h2>
            GITHUB
            <span>→ BARKLY.</span>
          </h2>
        </div>
      </header>

      <div class="pipeline">
        <div class="pipeline-node">
          <span>01</span>

          <strong>
            GITHUB
          </strong>

          <p>
            Public source repositories,
            descriptions, metadata,
            languages, topics, and history.
          </p>
        </div>

        <div class="pipeline-arrow">
          →
        </div>

        <div class="pipeline-node">
          <span>02</span>

          <strong>
            GIT HISTORY
          </strong>

          <p>
            Barkly checks the repository's
            latest commit to determine
            current project activity.
          </p>
        </div>

        <div class="pipeline-arrow">
          →
        </div>

        <div class="pipeline-node">
          <span>03</span>

          <strong>
            BARKLY
          </strong>

          <p>
            Repository information becomes
            a human-readable research
            registry.
          </p>
        </div>
      </div>
    </section>

    <!-- METADATA -->
    <section class="section metadata">
      <header class="section-header">
        <small>05</small>

        <div>
          <label>
            WHAT THE REGISTRY KNOWS
          </label>

          <h2>
            SHOW THE
            <span>SHAPE.</span>
          </h2>
        </div>
      </header>

      <div class="metadata-grid">
        <article>
          <span>01</span>

          <h3>
            IDENTITY
          </h3>

          <p>
            Repository name, organization,
            description, and GitHub URL.
          </p>
        </article>

        <article>
          <span>02</span>

          <h3>
            TECHNOLOGY
          </h3>

          <p>
            Primary programming language
            and repository topics.
          </p>
        </article>

        <article>
          <span>03</span>

          <h3>
            ACTIVITY
          </h3>

          <p>
            Actual Git commit history,
            last commit date, and
            repository lifecycle state.
          </p>
        </article>

        <article>
          <span>04</span>

          <h3>
            COMMUNITY
          </h3>

          <p>
            Stars, forks, and public
            participation signals.
          </p>
        </article>
      </div>
    </section>

    <!-- BARKLY STANDARD -->
    <section class="section standard">
      <header class="section-header">
        <small>06</small>

        <div>
          <label>
            BARKLY STANDARD
          </label>

          <h2>
            MAKE THE
            <span>MACHINE LEGIBLE.</span>
          </h2>
        </div>
      </header>

      <div class="standard-grid">
        <div class="standard-statement">
          Show the shape first.
        </div>

        <div class="standard-copy">
          <p>
            GitHub contains enormous amounts
            of technical information, but humans
            should not have to dig through every
            repository to understand what a lab
            is building.
          </p>

          <p>
            Barkly adds a human-facing layer over
            the raw repository structure and
            repository history.
          </p>

          <p class="bright">
            The computer already has the data.
            Barkly makes the data understandable.
          </p>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="footer-brand">
        <strong>
          BARKLY
          <span>LABS</span>
        </strong>

        <p>
          PUBLIC PROJECT REGISTRY
        </p>
      </div>

      <div class="footer-links">
        <a
          href={import.meta.env.BASE_URL}
        >
          BARKLY LABS
        </a>

        <a
          href={`https://github.com/${GITHUB_ORG}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          GITHUB ↗
        </a>

        <a
          href={
            import.meta.env.BASE_URL +
            "docs"
          }
        >
          DOCUMENTATION
        </a>
      </div>

      <div class="footer-meta">
        <span>
          {activeRepositories.length}
          ACTIVE
        </span>

        <span>
          {staleRepositories.length}
          STALE
        </span>

        <span>
          {archivedRepositories.length}
          ARCHIVED
        </span>

        <span>
          {forkedRepositories.length}
          FORKS
        </span>

        {lastUpdated && (
          <span>
            LAST COMMIT:
            {formatDate(
              lastUpdated.latestCommitDate ??
                lastUpdated.updated_at,
            )}
          </span>
        )}
      </div>

      <p class="copyright">
        © 2026 BARKLY LABS ·
        TECHNOLOGY SHOULD ADAPT TO HUMANS.
      </p>
    </footer>
  </main>
</body>
</html>

<style>
:root {
  --bg: #050505;
  --surface: #0a0a0a;
  --surface-2: #0f0f0f;
  --surface-hover: #131313;
  --white: #f1f1f1;
  --text: #f1f1f1;
  --muted: #a1a1a1;
  --dim: #686868;
