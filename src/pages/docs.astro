---
import SEO from "../components/SEO.astro";
import fs from "node:fs";
import path from "node:path";

const docsRoot = path.join(process.cwd(), "public", "docs");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

type DocEntry = {
  title: string;
  slug: string;
  href: string;
  category: string;
  relativePath: string;
  type: string;
};

type DocType = {
  key: string;
  label: string;
  description: string;
};

const docs: DocEntry[] = [];
const docTypes: DocType[] = [
  {
    key: "technical",
    label: "TECHNICAL DOCUMENTATION",
    description:
      "Implementation details, generated references, APIs, modules, dependencies, and system behavior.",
  },
  {
    key: "requirements",
    label: "FUNCTIONAL REQUIREMENTS",
    description:
      "Functional requirements describing what systems should do, how they should behave, and how success is verified.",
  },
  {
    key: "open-standards",
    label: "OPEN STANDARDS",
    description:
      "Public specifications, shared data formats, interoperability rules, and conformance tests developed for people and systems to build upon.",
  },
];

function titleFromPath(relativePath: string) {
  const parts = relativePath.split(path.sep).filter(Boolean);
  const leaf = parts.at(-1) === "index.html" ? parts.at(-2) : parts.at(-1);
  if (!leaf) return "DOCUMENTATION";
  return leaf.replace(/[-_]+/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function categoryFromPath(relativePath: string) {
  const parts = relativePath.split(path.sep).filter(Boolean);
  if (parts.length <= 1) return "BARKLY";
  return parts[0].replace(/[-_]+/g, " ").toUpperCase();
}

function typeFromPath(relativePath: string) {
  const normalized = relativePath.replaceAll(path.sep, "/").toLowerCase();
  const root = normalized.split("/").filter(Boolean)[0] ?? "";

  if (["technical", "technical-docs", "technical-documentation"].includes(root)) {
    return "technical";
  }
  if (["functional-requirements", "requirements", "frd"].includes(root)) {
    return "requirements";
  }
  if (["open-standards", "standards"].includes(root)) {
    return "open-standards";
  }
  return "unclassified";
}

function scanDirectory(directory: string, relative = "") {
  if (!fs.existsSync(directory)) return;

  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
    const absolutePath = path.join(directory, entry.name);
    const relativePath = path.join(relative, entry.name);

    if (entry.isDirectory()) {
      scanDirectory(absolutePath, relativePath);
      continue;
    }

    if (!entry.isFile() || entry.name.toLowerCase() !== "index.html") continue;

    const normalized = relativePath.replaceAll(path.sep, "/");
    const slug = normalized.replace(/index\.html$/i, "").replace(/\/$/, "");
    docs.push({
      title: titleFromPath(relativePath),
      slug,
      href: `${baseUrl}/docs/${normalized}`.replace(/\/+/g, "/").replace(/^https?:\//, (match) => match),
      category: categoryFromPath(relativePath),
      type: typeFromPath(relativePath),
      relativePath: normalized,
    });
  }
}

scanDirectory(docsRoot);
docs.sort((a, b) => a.relativePath.localeCompare(b.relativePath));

const categories = [...new Set(docs.map((doc) => doc.category))];
const activeTypes = docTypes.filter((type) => docs.some((doc) => doc.type === type.key));
const year = new Date().getFullYear();
const totalDocuments = docs.length;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO />
    <meta name="description" content="Barkly Docs is an automated documentation system designed to make software architecture, requirements, open standards, and project knowledge easier for humans to understand." />
    <meta property="og:site_name" content="Barkly Labs" />
    <meta property="og:url" content="https://www.barklylabs.space/docs/" />
    <meta property="og:title" content="Barkly Labs — Barkly Docs" />
    <meta property="og:description" content="Technical documentation, functional requirements, open standards, and knowledge from the Barkly ecosystem." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Barkly Labs — Barkly Docs" />
    <meta name="twitter:description" content="Technical documentation, functional requirements, open standards, and knowledge from the Barkly ecosystem." />
    <link rel="canonical" href="https://www.barklylabs.space/docs/" />
    <meta name="robots" content="index, follow" />
    <title>Barkly Labs — Barkly Docs</title>
  </head>
  <body>
    <header class="topbar">
      <a href={import.meta.env.BASE_URL} class="brand" aria-label="Barkly Labs home">
        <span class="brand-symbol">◆</span><span>BARKLY LABS</span>
      </a>
      <div class="topbar-center">DOCUMENTATION SYSTEM</div>
      <a href={import.meta.env.BASE_URL} class="back-link">← RETURN TO LABS</a>
    </header>

    <main>
      <section class="docs-hero" aria-labelledby="page-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-content">
          <div class="system-status"><span class="status-dot"></span> KNOWLEDGE SYSTEM / ONLINE</div>
          <div class="hero-label">BARKLY / DOCS</div>
          <h1 id="page-title">KNOWLEDGE <span>ARCHIVE.</span></h1>
          <p>Technical documentation, functional requirements, open standards, research, and system knowledge from across the Barkly ecosystem.</p>
          <div class="hero-meta">
            <span>{String(totalDocuments).padStart(2, "0")} DOCUMENTS</span>
            <span>{String(categories.length).padStart(2, "0")} SYSTEMS</span>
            <span>BUILD / DOCUMENT / LEARN</span>
          </div>
        </div>
      </section>

      <nav class="section-nav" aria-label="Documentation categories">
        <span class="section-nav-label">BROWSE BY TYPE</span>
        {docTypes.map((type, index) => (
          <a href={`#${type.key}`} class:list={["section-nav-link", { muted: !activeTypes.some((active) => active.key === type.key) }]}>
            <span>{String(index + 1).padStart(2, "0")}</span>{type.label}
          </a>
        ))}
      </nav>

      {activeTypes.map((type, typeIndex) => {
        const typeDocs = docs.filter((doc) => doc.type === type.key);
        return (
          <section class="type-section" id={type.key} aria-labelledby={`heading-${type.key}`}>
            <div class="type-container">
              <div class="type-header">
                <div class="type-header-main">
                  <span class="section-number">{String(typeIndex + 1).padStart(2, "0")}</span>
                  <div>
                    <span class="section-kicker">BARKLY / KNOWLEDGE TYPE</span>
                    <h2 id={`heading-${type.key}`}>{type.label}</h2>
                  </div>
                </div>
                <div class="type-count"><span>DOCUMENTS</span><strong>{String(typeDocs.length).padStart(2, "0")}</strong></div>
              </div>
              <div class="type-description"><p>{type.description}</p></div>
              <div class="type-document-list">
                {typeDocs.length === 0 ? (
                  <div class="empty-type"><span>[ 00 ]</span><p>NO DOCUMENTATION FOUND.</p></div>
                ) : (
                  typeDocs.map((doc, index) => (
                    <a href={doc.href} class="type-document" aria-label={`Open ${doc.title}`}>
                      <span class="type-document-number">{String(index + 1).padStart(2, "0")}</span>
                      <span class="type-document-main">
                        <span class="document-category">{doc.category}</span>
                        <strong>{doc.title}</strong>
                        <span class="document-path">/{doc.relativePath}</span>
                      </span>
                      <span class="type-document-open">OPEN →</span>
                    </a>
                  ))
                )}
              </div>
            </div>
          </section>
        );
      })}

      <section class="system-map" aria-labelledby="map-title">
        <div class="map-header">
          <span class="section-number">04</span>
          <div><span class="section-kicker">KNOWLEDGE GRAPH</span><h2 id="map-title">ONE ECOSYSTEM.<span>MANY SYSTEMS.</span></h2></div>
        </div>
        <div class="map-grid" aria-label="Barkly knowledge areas: research, engineering, systems, and people">
          <div class="map-core"><span class="core-label">BARKLY</span><strong>KNOWLEDGE</strong><small>DOCUMENTATION CORE</small></div>
          <div class="map-node node-a"><span>01</span><strong>RESEARCH</strong></div>
          <div class="map-node node-b"><span>02</span><strong>ENGINEERING</strong></div>
          <div class="map-node node-c"><span>03</span><strong>SYSTEMS</strong></div>
          <div class="map-node node-d"><span>04</span><strong>PEOPLE</strong></div>
          <div class="map-line line-a"></div><div class="map-line line-b"></div><div class="map-line line-c"></div><div class="map-line line-d"></div>
        </div>
      </section>

      <section class="docs-principle">
        <div class="principle-number">05</div>
        <div><span class="section-kicker">BARKLY PRINCIPLE</span><h2>DOCUMENTATION <span>IS INFRASTRUCTURE.</span></h2><p>A system should not depend on one person's memory. Documentation makes architecture, decisions, experiments, failures, and knowledge understandable enough for other people to use, question, modify, and improve.</p></div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-main"><div><div class="footer-logo">BARKLY</div><div class="footer-labs">LABS / DOCS</div></div><div class="footer-tagline">KNOWLEDGE<br />BECOMES INFRASTRUCTURE.</div></div>
      <div class="footer-bottom"><span>© {year} BARKLY LABS</span><span>MICHIGAN NONPROFIT CORPORATION</span><span>TECHNOLOGY SHOULD ADAPT TO HUMANS.</span><a href={import.meta.env.BASE_URL}>BARKLY LABS ↗</a></div>
    </footer>
  </body>
</html>

<style>
  :global(:root){--bg:#050505;--panel:#0a0a0a;--panel-raised:#0f0f0f;--panel-hover:#131313;--border:#242424;--border-strong:#383838;--text:#f1f1f1;--muted:#a1a1a1;--dim:#686868;--pink:#ff2f92;--pink-soft:rgba(255,47,146,.10);--pink-line:rgba(255,47,146,.42)}
  :global(*){box-sizing:border-box} :global(html){background:var(--bg);scroll-behavior:smooth;scroll-padding-top:90px} :global(body){margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden} :global(a){color:inherit;text-decoration:none} :global(a:focus-visible){outline:2px solid var(--pink);outline-offset:5px} ::selection{background:var(--pink);color:#050505}
  .topbar{position:sticky;top:0;z-index:50;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:72px;padding:0 5vw;border-bottom:1px solid var(--border);background:rgba(5,5,5,.94);backdrop-filter:blur(14px)}
  .brand{display:flex;align-items:center;gap:10px;font-family:"Courier New",monospace;font-size:11px;font-weight:700;letter-spacing:.18em}.brand-symbol{color:var(--pink);font-size:8px;text-shadow:0 0 12px rgba(255,47,146,.45)}.topbar-center,.back-link{font-family:"Courier New",monospace;font-size:9px;letter-spacing:.15em}.topbar-center{color:var(--dim)}.back-link{justify-self:end;color:var(--muted);transition:color .2s}.back-link:hover{color:var(--pink)}
  .docs-hero{position:relative;min-height:600px;display:flex;align-items:center;padding:120px 10vw;overflow:hidden;border-bottom:1px solid var(--border);background:radial-gradient(circle at 80% 40%,rgba(255,47,146,.07),transparent 25%),var(--bg)}.hero-grid{position:absolute;inset:0;opacity:.12;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:60px 60px;mask-image:linear-gradient(90deg,black,transparent 75%)}.hero-content{position:relative;z-index:2;width:min(1000px,100%)}.system-status{display:flex;align-items:center;gap:10px;margin-bottom:40px;color:var(--muted);font:9px "Courier New",monospace;letter-spacing:.15em}.status-dot{width:6px;height:6px;border-radius:50%;background:var(--pink);box-shadow:0 0 10px rgba(255,47,146,.75)}.hero-label,.section-kicker{color:var(--pink);font:10px "Courier New",monospace;letter-spacing:.2em}.docs-hero h1{margin:28px 0;color:var(--text);font-size:clamp(60px,10vw,145px);line-height:.82;letter-spacing:-.08em}.docs-hero h1 span{display:block;margin-left:10vw;color:var(--pink)}.docs-hero p{max-width:650px;margin:45px 0 35px;color:var(--muted);font-size:15px;line-height:1.8}.hero-meta{display:flex;flex-wrap:wrap;gap:30px;color:var(--dim);font:8px "Courier New",monospace;letter-spacing:.14em}.hero-meta span:first-child{color:var(--pink)}
  .section-nav{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;padding:24px 10vw;border-bottom:1px solid var(--border);background:var(--panel)}.section-nav-label{width:100%;color:var(--dim);font:8px "Courier New",monospace;letter-spacing:.18em}.section-nav-link{display:flex;gap:10px;align-items:center;color:var(--muted);font:9px "Courier New",monospace;letter-spacing:.08em;transition:color .2s}.section-nav-link span{color:var(--pink)}.section-nav-link:hover{color:var(--pink)}.section-nav-link.muted{opacity:.45}
  .section-number,.principle-number{color:var(--pink);font:11px "Courier New",monospace;letter-spacing:.08em}.type-section{padding:70px 6vw;background:var(--bg);border-top:1px solid var(--border);scroll-margin-top:80px}.type-container{width:100%;max-width:1400px;margin:0 auto;padding:clamp(24px,4vw,50px);background:var(--panel);border:1px solid var(--border);overflow:hidden}.type-header{display:flex;justify-content:space-between;align-items:end;gap:30px;padding-bottom:25px;border-bottom:1px solid var(--border-strong)}.type-header-main{display:flex;gap:35px;align-items:flex-start}.type-header h2{margin:15px 0 0;color:var(--text);font-size:clamp(30px,4vw,60px);line-height:.95;letter-spacing:-.055em}.type-count{display:flex;flex-direction:column;align-items:flex-end;gap:7px;color:var(--dim);font:8px "Courier New",monospace;letter-spacing:.12em}.type-count strong{color:var(--pink);font-size:20px;font-weight:400}.type-description{padding:25px 0;border-bottom:1px solid var(--border)}.type-description p{max-width:750px;margin:0;color:var(--muted);font-size:13px;line-height:1.7}.type-document{display:grid;grid-template-columns:55px minmax(0,1fr) 110px;gap:30px;align-items:center;min-height:115px;border-bottom:1px solid var(--border);transition:background .25s,padding .25s,border-color .25s}.type-document:last-child{border-bottom:0}.type-document:hover{padding-inline:15px;background:var(--pink-soft);border-color:var(--pink-line)}.type-document-number{color:var(--pink);font:10px "Courier New",monospace}.type-document-main{display:flex;flex-direction:column;gap:7px;min-width:0}.document-category{color:var(--pink);font:8px "Courier New",monospace;letter-spacing:.14em}.type-document-main strong{color:var(--text);font-size:22px;letter-spacing:-.035em}.document-path{overflow-wrap:anywhere;color:var(--dim);font:8px "Courier New",monospace;letter-spacing:.04em}.type-document-open{justify-self:end;color:var(--dim);font:8px "Courier New",monospace;letter-spacing:.12em;transition:color .2s,transform .2s}.type-document:hover .type-document-open{color:var(--pink);transform:translateX(3px)}.empty-type{padding:55px 0;color:var(--dim);font:9px "Courier New",monospace;letter-spacing:.12em;text-align:center}.empty-type span{color:var(--pink)}.empty-type p{margin:15px 0 0}
  .system-map{position:relative;min-height:650px;padding:120px 10vw;background:var(--panel);border-block:1px solid var(--border);overflow:hidden}.map-header{display:grid;grid-template-columns:100px 1fr;gap:40px;position:relative;z-index:3}.map-header h2{margin:18px 0 0;max-width:850px;font-size:clamp(42px,7vw,90px);line-height:.88;letter-spacing:-.06em}.map-header h2 span{display:block;color:var(--pink)}.map-grid{position:relative;width:min(800px,80vw);height:420px;margin:70px auto 0}.map-core{position:absolute;top:50%;left:50%;width:180px;height:180px;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:translate(-50%,-50%);border:1px solid var(--pink-line);background:var(--panel);text-align:center}.core-label{color:var(--pink);font:8px "Courier New",monospace;letter-spacing:.18em}.map-core strong{margin:10px 0;font-size:23px;letter-spacing:-.04em}.map-core small{color:var(--dim);font:7px "Courier New",monospace;letter-spacing:.12em}.map-node{position:absolute;display:flex;flex-direction:column;gap:7px;padding:15px;min-width:150px;border:1px solid var(--border-strong);background:rgba(10,10,10,.92)}.map-node span{color:var(--pink);font:8px "Courier New",monospace}.map-node strong{font:9px "Courier New",monospace;letter-spacing:.12em}.node-a{top:10px;left:0}.node-b{top:10px;right:0}.node-c{bottom:10px;left:0}.node-d{bottom:10px;right:0}.map-line{position:absolute;height:1px;width:260px;background:var(--pink-line);opacity:.55}.line-a{top:34%;left:12%;transform:rotate(25deg)}.line-b{top:34%;right:12%;transform:rotate(-25deg)}.line-c{bottom:34%;left:12%;transform:rotate(-25deg)}.line-d{bottom:34%;right:12%;transform:rotate(25deg)}
  .docs-principle{display:grid;grid-template-columns:100px 1fr;gap:40px;padding:130px 10vw;background:var(--bg)}.docs-principle h2{max-width:900px;margin:25px 0 35px;font-size:clamp(46px,7vw,95px);line-height:.88;letter-spacing:-.065em}.docs-principle h2 span{display:block;color:var(--pink)}.docs-principle p{max-width:650px;color:var(--muted);font-size:16px;line-height:1.8}
  .footer{padding:70px 5vw 30px;border-top:1px solid var(--border);background:var(--bg)}.footer-main{display:flex;align-items:end;justify-content:space-between;padding-bottom:70px}.footer-logo{font-size:55px;font-weight:900;line-height:.8;letter-spacing:-.07em}.footer-labs{margin-top:12px;color:var(--pink);font:10px "Courier New",monospace;letter-spacing:.4em}.footer-tagline{color:var(--muted);font:10px/1.7 "Courier New",monospace;letter-spacing:.12em;text-align:right}.footer-bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:18px;padding-top:20px;border-top:1px solid var(--border);color:var(--dim);font:8px "Courier New",monospace;letter-spacing:.1em}.footer-bottom a:hover{color:var(--pink)}
  @media(max-width:800px){.topbar{grid-template-columns:1fr auto}.topbar-center{display:none}.docs-hero{min-height:540px;padding:90px 7vw 70px}.section-nav,.type-section,.system-map,.docs-principle{padding-left:7vw;padding-right:7vw}.type-header{align-items:flex-start;flex-direction:column;gap:22px}.type-count{align-items:flex-start}.type-document{grid-template-columns:35px minmax(0,1fr);gap:15px;padding:20px 0}.type-document-open{grid-column:2;justify-self:start}.map-header,.docs-principle{grid-template-columns:1fr;gap:20px}.map-grid{width:100%;height:520px}.map-core{width:145px;height:145px}.map-node{min-width:120px}.map-line{width:130px}.footer-main,.footer-bottom{align-items:flex-start;flex-direction:column;gap:28px}.footer-tagline{text-align:left}}
  @media(max-width:520px){.topbar{min-height:60px;padding:0 6vw}.back-link{font-size:8px}.docs-hero h1{font-size:clamp(52px,13vw,68px)}.hero-meta{flex-direction:column;gap:10px}.type-container{padding:22px}.type-header-main{gap:18px}.type-header h2{font-size:clamp(27px,8vw,38px)}.type-document-main strong{font-size:19px}.map-grid{height:430px}.map-node{min-width:105px;padding:11px}.map-line{display:none}.map-core{width:125px;height:125px}.map-core strong{font-size:18px}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
</style>
