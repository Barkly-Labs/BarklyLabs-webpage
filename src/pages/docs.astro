---
import fs from "node:fs";
import path from "node:path";

const docsRoot = path.join(process.cwd(), "public", "docs");

type DocType = {
  key: string;
  label: string;
  description: string;
};

type DocEntry = {
  title: string;
  slug: string;
  href: string;
  category: string;
  type: string;
  relativePath: string;
};

const docTypes: DocType[] = [
  {
    key: "technical",
    label: "TECHNICAL DOCUMENTATION",
    description:
      "Implementation details, generated references, APIs, modules, dependencies, and system behavior.",
  },
  {
    key: "requirements",
    label: "FUNCTIONAL REQUIREMENTS",
    description:
      "Requirements describing what systems should do, how they should behave, and what they are intended to accomplish.",
  },
  {
    key: "specifications",
    label: "SPECIFICATIONS",
    description:
      "Defined technical specifications, interfaces, protocols, formats, and system contracts.",
  },
  {
    key: "research",
    label: "RESEARCH & PAPERS",
    description:
      "Research notes, papers, investigations, findings, experiments, and supporting knowledge.",
  },
  {
    key: "architecture",
    label: "ARCHITECTURE & DESIGN",
    description:
      "System architecture, design decisions, relationships, components, and structural documentation.",
  },
  {
    key: "implementation",
    label: "IMPLEMENTATION & REFERENCE",
    description:
      "Implementation references generated from real project source code and system structure.",
  },
  {
    key: "testing",
    label: "TESTING & VALIDATION",
    description:
      "Tests, validation procedures, benchmarks, verification results, and known limitations.",
  },
  {
    key: "experiments",
    label: "EXPERIMENTS & NOTES",
    description:
      "Experiments, prototypes, observations, development notes, and lessons learned.",
  },
  {
    key: "guides",
    label: "GUIDES & HOW-TO",
    description:
      "Practical guides for using, developing, operating, modifying, and extending Barkly systems.",
  },
  {
    key: "history",
    label: "HISTORY & CHANGELOGS",
    description:
      "Development history, changes, milestones, releases, decisions, and project evolution.",
  },
];

const docs: DocEntry[] = [];

/* =========================================================
   HELPERS
   ========================================================= */

function normalizePath(value: string) {
  return value.replaceAll(path.sep, "/");
}

function titleFromPath(relativePath: string) {
  const normalized = normalizePath(relativePath);
  const parts = normalized.split("/").filter(Boolean);

  const index =
    parts[parts.length - 1]?.toLowerCase() === "index.html"
      ? parts[parts.length - 2]
      : parts[parts.length - 1];

  if (!index) {
    return "DOCUMENTATION";
  }

  return index
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

/*
 * The first folder underneath /public/docs is authoritative.
 *
 * Example:
 *
 * public/docs/technical/CYN-X/index.html
 *                  ^^^^^^^^
 *
 * public/docs/Functional-requirements/CYN-X/index.html
 *                  ^^^^^^^^^^^^^^^^^^^^^
 */
function typeFromPath(relativePath: string) {
  const normalized = normalizePath(relativePath).toLowerCase();

  const parts = normalized.split("/").filter(Boolean);

  const root = parts[0] ?? "";

  if (
    root === "technical" ||
    root === "technical-docs" ||
    root === "technical-documentation"
  ) {
    return "technical";
  }

  if (
    root === "functional-requirements" ||
    root === "requirements" ||
    root === "frd"
  ) {
    return "requirements";
  }

  if (
    root === "specifications" ||
    root === "specs"
  ) {
    return "specifications";
  }

  if (
    root === "research" ||
    root === "papers" ||
    root === "research-papers"
  ) {
    return "research";
  }

  if (
    root === "architecture" ||
    root === "design"
  ) {
    return "architecture";
  }

  if (
    root === "implementation" ||
    root === "reference"
  ) {
    return "implementation";
  }

  if (
    root === "testing" ||
    root === "tests" ||
    root === "validation"
  ) {
    return "testing";
  }

  if (
    root === "experiments" ||
    root === "notes"
  ) {
    return "experiments";
  }

  if (
    root === "guides" ||
    root === "how-to" ||
    root === "howto"
  ) {
    return "guides";
  }

  if (
    root === "history" ||
    root === "changelog" ||
    root === "changelogs"
  ) {
    return "history";
  }

  /*
   * Documents that are directly inside public/docs
   * are not automatically assigned to a knowledge type.
   *
   * They remain in the global Documentation Index.
   */
  return "unclassified";
}

function categoryFromPath(relativePath: string) {
  const normalized = normalizePath(relativePath);
  const parts = normalized.split("/").filter(Boolean);

  if (parts.length <= 1) {
    return "BARKLY";
  }

  return parts[0]
    .replace(/[-_]+/g, " ")
    .toUpperCase();
}

/* =========================================================
   RECURSIVE DOCUMENT SCANNER
   ========================================================= */

function scanDirectory(directory: string, relative = "") {
  if (!fs.existsSync(directory)) {
    return;
  }

  const entries = fs.readdirSync(directory, {
    withFileTypes: true,
  });

  for (const entry of entries) {
    const absolutePath = path.join(directory, entry.name);
    const relativePath = path.join(relative, entry.name);

    if (entry.isDirectory()) {
      scanDirectory(absolutePath, relativePath);
      continue;
    }

    if (
      entry.isFile() &&
      entry.name.toLowerCase() === "index.html"
    ) {
      const normalized = normalizePath(relativePath);

      docs.push({
        title: titleFromPath(relativePath),

        slug: normalized
          .replace(/\/index\.html$/i, "")
          .replace(/^index\.html$/i, ""),

        href: `/docs/${normalized}`,

        category: categoryFromPath(relativePath),

        type: typeFromPath(relativePath),

        relativePath: normalized,
      });
    }
  }
}

scanDirectory(docsRoot);

/* =========================================================
   SORTING
   ========================================================= */

docs.sort((a, b) =>
  a.relativePath.localeCompare(
    b.relativePath,
    undefined,
    {
      sensitivity: "base",
    }
  )
);

const categories = [
  ...new Set(
    docs
      .filter((doc) => doc.type !== "unclassified")
      .map((doc) => doc.category)
  ),
];

/*
 * Only display knowledge-type sections that actually
 * contain documents.
 */
const activeTypes = docTypes.filter((type) =>
  docs.some((doc) => doc.type === type.key)
);

const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Barkly Labs / Documentation</title>

    <meta
      name="description"
      content="Barkly Labs documentation, technical knowledge, functional requirements, research, architecture, experiments, and engineering references."
    />
  </head>

  <body>

    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <header class="topbar">

      <a href="/" class="brand">
        <span class="brand-symbol">◆</span>
        <span>BARKLY LABS</span>
      </a>

      <div class="topbar-center">
        DOCUMENTATION SYSTEM
      </div>

      <a href="/" class="back-link">
        ← RETURN TO LABS
      </a>

    </header>


    <main>

      <!-- =====================================================
           HERO
           ===================================================== -->

      <section class="docs-hero">

        <div class="hero-grid"></div>

        <div class="hero-content">

          <div class="system-status">
            <span class="status-dot"></span>
            KNOWLEDGE SYSTEM / ONLINE
          </div>

          <div class="hero-label">
            BARKLY / DOCS
          </div>

          <h1>
            KNOWLEDGE
            <span>ARCHIVE.</span>
          </h1>

          <p>
            Technical documentation, functional requirements,
            research notes, system architecture, experiments,
            references, and knowledge generated throughout
            the Barkly ecosystem.
          </p>

          <div class="hero-meta">
            <span>
              {docs.length.toString().padStart(2, "0")}
              DOCUMENTS
            </span>

            <span>
              {categories.length.toString().padStart(2, "0")}
              SYSTEMS
            </span>

            <span>
              {activeTypes.length.toString().padStart(2, "0")}
              KNOWLEDGE TYPES
            </span>

            <span>
              BUILD / DOCUMENT / LEARN
            </span>
          </div>

        </div>

      </section>


      <!-- =====================================================
           DOCUMENTATION INDEX
           GLOBAL MASTER INDEX
           ===================================================== -->

      <section class="archive">

        <div class="archive-header">

          <div>
            <span class="section-number">
              01
            </span>

            <span class="section-kicker">
              DOCUMENTATION INDEX
            </span>
          </div>

          <div class="archive-count">
            {docs.length.toString().padStart(2, "0")}
            ENTRIES
          </div>

        </div>


        {
          docs.length === 0 ? (

            <div class="empty-state">

              <span class="empty-symbol">
                [ 00 ]
              </span>

              <h2>
                NO DOCUMENTATION FOUND.
              </h2>

              <p>
                The Barkly Docs generator has not produced
                any <code>index.html</code> files yet.
              </p>

            </div>

          ) : (

            <div class="document-list">

              {docs.map((doc, index) => (

                <a
                  href={doc.href}
                  class="document-row"
                  data-type={doc.type}
                  data-category={doc.category}
                >

                  <span class="document-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="document-main">

                    <span class="document-category">
                      {doc.category}
                    </span>

                    <strong>
                      {doc.title}
                    </strong>

                    <span class="document-path">
                      /{doc.relativePath}
                    </span>

                  </span>

                  <span class="document-open">
                    OPEN →
                  </span>

                </a>

              ))}

            </div>

          )
        }

      </section>


      <!-- =====================================================
           KNOWLEDGE TYPE SECTIONS
           ===================================================== -->

      {
        activeTypes.map((type, typeIndex) => {

          /*
           * IMPORTANT:
           *
           * This list is local to THIS knowledge type.
           *
           * It is NOT the global docs array.
           *
           * Therefore:
           *
           * TECHNICAL:
           * 01 CYN-X
           * 02 SecuServe
           *
           * REQUIREMENTS:
           * 01 CYN-X
           * 02 PawBoard
           */

          const typeDocs = docs.filter(
            (doc) => doc.type === type.key
          );

          const sectionNumber =
            typeIndex + 2;

          return (

            <section
              class="knowledge-section"
              id={type.key}
            >

              <div class="knowledge-container">

                <!-- SECTION HEADER -->

                <div class="knowledge-header">

                  <div class="knowledge-header-left">

                    <span class="section-number">
                      {String(sectionNumber).padStart(2, "0")}
                    </span>

                    <div>

                      <span class="section-kicker">
                        BARKLY / KNOWLEDGE TYPE
                      </span>

                      <h2>
                        {type.label}
                      </h2>

                    </div>

                  </div>

                  <div class="knowledge-count">

                    <span>
                      DOCUMENTS
                    </span>

                    <strong>
                      {typeDocs.length
                        .toString()
                        .padStart(2, "0")}
                    </strong>

                  </div>

                </div>


                <!-- DESCRIPTION -->

                <div class="knowledge-description">

                  <p>
                    {type.description}
                  </p>

                  <span class="knowledge-path">
                    /docs/
                    {type.key}
                  </span>

                </div>


                <!-- DOCUMENTS FOR THIS TYPE ONLY -->

                <div class="knowledge-document-list">

                  {typeDocs.map((doc, index) => (

                    <a
                      href={doc.href}
                      class="knowledge-document"
                    >

                      <!-- LOCAL COUNTER -->

                      <span class="knowledge-document-number">
                        {String(index + 1).padStart(2, "0")}
                      </span>


                      <!-- DOCUMENT INFO -->

                      <span class="knowledge-document-main">

                        <span class="knowledge-document-category">
                          {doc.category}
                        </span>

                        <strong>
                          {doc.title}
                        </strong>

                        <span class="knowledge-document-path">
                          /{doc.relativePath}
                        </span>

                      </span>


                      <!-- OPEN -->

                      <span class="knowledge-document-open">
                        OPEN ↗
                      </span>

                    </a>

                  ))}

                </div>

              </div>

            </section>

          );
        })
      }


      <!-- =====================================================
           SYSTEM MAP
           ===================================================== -->

      <section class="system-map">

        <div class="map-header">

          <span class="section-number">
            {String(activeTypes.length + 2).padStart(2, "0")}
          </span>

          <div>

            <span class="section-kicker">
              KNOWLEDGE GRAPH
            </span>

            <h2>
              ONE ECOSYSTEM.
              <span>MANY SYSTEMS.</span>
            </h2>

          </div>

        </div>


        <div class="map-grid">

          <div class="map-core">

            <span class="core-label">
              BARKLY
            </span>

            <strong>
              KNOWLEDGE
            </strong>

            <small>
              DOCUMENTATION CORE
            </small>

          </div>


          <div class="map-node node-a">
            <span>01</span>
            <strong>RESEARCH</strong>
          </div>

          <div class="map-node node-b">
            <span>02</span>
            <strong>ENGINEERING</strong>
          </div>

          <div class="map-node node-c">
            <span>03</span>
            <strong>SYSTEMS</strong>
          </div>

          <div class="map-node node-d">
            <span>04</span>
            <strong>PEOPLE</strong>
          </div>


          <div class="map-line line-a"></div>
          <div class="map-line line-b"></div>
          <div class="map-line line-c"></div>
          <div class="map-line line-d"></div>

        </div>

      </section>


      <!-- =====================================================
           PRINCIPLE
           ===================================================== -->

      <section class="docs-principle">

        <div class="principle-number">

          {String(activeTypes.length + 3).padStart(2, "0")}

        </div>

        <div>

          <span class="section-kicker">
            BARKLY PRINCIPLE
          </span>

          <h2>
            DOCUMENTATION
            <span>IS INFRASTRUCTURE.</span>
          </h2>

          <p>
            A system should not depend on one person's memory.
            Documentation makes the architecture, decisions,
            experiments, failures, and knowledge of a system
            understandable enough for other people to use,
            question, modify, and improve it.
          </p>

        </div>

      </section>

    </main>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="footer">

      <div class="footer-main">

        <div>

          <div class="footer-logo">
            BARKLY
          </div>

          <div class="footer-labs">
            LABS / DOCS
          </div>

        </div>


        <div class="footer-tagline">

          KNOWLEDGE
          <br />
          BECOMES INFRASTRUCTURE.

        </div>

      </div>


      <div class="footer-bottom">

        <span>
          © {year} BARKLY LABS
        </span>

        <span>
          DETROIT, MICHIGAN
        </span>

        <a href="/">
          BARKLY LABS ↗
        </a>

      </div>

    </footer>

  </body>
</html>


<style>

  /* =========================================================
     GLOBAL
     ========================================================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #050505;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;

    background: #050505;
    color: #f2f2f2;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    overflow-x: hidden;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: #f2f2f2;
    color: #050505;
  }


  /* =========================================================
     TOPBAR
     ========================================================= */

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    min-height: 72px;

    padding: 0 5vw;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.1);

    background:
      rgba(5, 5, 5, 0.92);

    backdrop-filter: blur(14px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;

    font-family: "Courier New", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .brand-symbol {
    font-size: 8px;
  }

  .topbar-center {
    color: rgba(255, 255, 255, 0.35);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
  }

  .back-link {
    justify-self: end;

    color: rgba(255, 255, 255, 0.5);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.12em;

    transition: color 0.2s;
  }

  .back-link:hover {
    color: #fff;
  }


  /* =========================================================
     HERO
     ========================================================= */

  .docs-hero {
    position: relative;

    min-height: 650px;

    display: flex;
    align-items: center;

    padding: 130px 10vw;

    overflow: hidden;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-grid {
    position: absolute;
    inset: 0;

    opacity: 0.12;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      );

    background-size: 60px 60px;

    mask-image:
      linear-gradient(
        90deg,
        black,
        transparent 75%
      );
  }

  .docs-hero::after {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      radial-gradient(
        circle at 80% 40%,
        rgba(255, 255, 255, 0.07),
        transparent 28%
      ),
      linear-gradient(
        90deg,
        #050505 10%,
        transparent 85%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;

    width: min(950px, 100%);
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 45px;

    color: rgba(255, 255, 255, 0.38);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
  }

  .status-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #fff;

    box-shadow:
      0 0 12px rgba(255, 255, 255, 0.7);
  }

  .hero-label {
    color: rgba(255, 255, 255, 0.3);

    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
  }

  .docs-hero h1 {
    margin: 28px 0;

    font-size: clamp(70px, 11vw, 160px);
    line-height: 0.78;
    letter-spacing: -0.08em;
  }

  .docs-hero h1 span {
    display: block;

    margin-left: 12vw;

    color: rgba(255, 255, 255, 0.3);
  }

  .docs-hero p {
    max-width: 650px;

    margin: 50px 0 35px;

    color: rgba(255, 255, 255, 0.52);

    font-size: 15px;
    line-height: 1.8;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;

    color: rgba(255, 255, 255, 0.25);

    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 0.14em;
  }


  /* =========================================================
     SHARED SECTION LABELS
     ========================================================= */

  .section-number {
    color: rgba(255, 255, 255, 0.25);

    font-family: "Courier New", monospace;
    font-size: 10px;
  }

  .section-kicker {
    color: rgba(255, 255, 255, 0.4);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
  }


  /* =========================================================
     MASTER DOCUMENTATION INDEX
     ========================================================= */

  .archive {
    padding: 120px 10vw;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.08);
  }

  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: end;

    padding-bottom: 25px;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.15);
  }

  .archive-header > div:first-child {
    display: flex;
    gap: 35px;
  }

  .archive-count {
    color: rgba(255, 255, 255, 0.25);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .document-list {
    border-bottom:
      1px solid rgba(255, 255, 255, 0.1);
  }

  .document-row {
    display: grid;
    grid-template-columns: 70px 1fr 110px;
    gap: 30px;
    align-items: center;

    min-height: 125px;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.08);

    transition:
      background 0.25s,
      padding 0.25s;
  }

  .document-row:last-child {
    border-bottom: 0;
  }

  .document-row:hover {
    padding-left: 15px;
    padding-right: 15px;

    background:
      rgba(255, 255, 255, 0.025);
  }

  .document-number {
    color: rgba(255, 255, 255, 0.2);

    font-family: "Courier New", monospace;
    font-size: 10px;
  }

  .document-main {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .document-category {
    color: rgba(255, 255, 255, 0.3);

    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 0.15em;
  }

  .document-main strong {
    font-size: 22px;
    letter-spacing: -0.035em;
  }

  .document-path {
    color: rgba(255, 255, 255, 0.2);

    font-family: "Courier New", monospace;
    font-size: 9px;
  }

  .document-open {
    justify-self: end;

    color: rgba(255, 255, 255, 0.4);

    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 0.12em;

    transition: color 0.2s;
  }

  .document-row:hover .document-open {
    color: #fff;
  }


  /* =========================================================
     EMPTY STATE
     ========================================================= */

  .empty-state {
    padding: 100px 0;

    text-align: center;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.1);
  }

  .empty-symbol {
    color: rgba(255, 255, 255, 0.2);

    font-family: "Courier New", monospace;
    font-size: 11px;
  }

  .empty-state h2 {
    margin: 25px 0 15px;

    font-size: 30px;
    letter-spacing: -0.04em;
  }

  .empty-state p {
    color: rgba(255, 255, 255, 0.4);

    font-size: 13px;
  }


  /* =========================================================
     KNOWLEDGE TYPE SECTIONS
     ========================================================= */

  .knowledge-section {
    padding: 100px 10vw;

    background: #050505;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.1);
  }

  /*
   * THIS is the independent visual container.
   *
   * Every knowledge type gets its own box.
   */

