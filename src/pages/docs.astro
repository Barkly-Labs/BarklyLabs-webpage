---
import fs from "node:fs";
import path from "node:path";

const docsRoot = path.join(process.cwd(), "public", "docs");

type DocType = {
  key: string;
  label: string;
  description: string;
};

type DocEntry = {
  title: string;
  slug: string;
  href: string;
  category: string;
  type: string;
  relativePath: string;
};

const docTypes: DocType[] = [
  {
    key: "technical",
    label: "TECHNICAL DOCUMENTATION",
    description:
      "Implementation details, technical references, APIs, modules, dependencies, and system behavior.",
  },
  {
    key: "specifications",
    label: "SPECIFICATIONS",
    description:
      "Defined technical specifications, interfaces, protocols, formats, and system contracts.",
  },
  {
    key: "research",
    label: "RESEARCH & PAPERS",
    description:
      "Research notes, papers, literature, investigations, findings, and supporting knowledge.",
  },
  {
    key: "requirements",
    label: "FUNCTIONAL REQUIREMENTS",
    description:
      "Functional requirements describing what systems should do and how they should behave.",
  },
  {
    key: "architecture",
    label: "ARCHITECTURE & DESIGN",
    description:
      "System architecture, design decisions, relationships, components, and structural documentation.",
  },
  {
    key: "implementation",
    label: "IMPLEMENTATION & REFERENCE",
    description:
      "Implementation references generated from real project source code and system structure.",
  },
  {
    key: "testing",
    label: "TESTING & VALIDATION",
    description:
      "Tests, validation procedures, benchmarks, verification results, and known limitations.",
  },
  {
    key: "experiments",
    label: "EXPERIMENTS & NOTES",
    description:
      "Experiments, prototypes, observations, development notes, and lessons learned.",
  },
  {
    key: "guides",
    label: "GUIDES & HOW-TO",
    description:
      "Practical guides for using, developing, operating, modifying, and extending Barkly systems.",
  },
  {
    key: "history",
    label: "HISTORY & CHANGELOGS",
    description:
      "Development history, changes, milestones, releases, decisions, and project evolution.",
  },
];

const docs: DocEntry[] = [];

function titleFromPath(relativePath: string) {
  const parts = relativePath.split(path.sep).filter(Boolean);

  const index =
    parts[parts.length - 1] === "index.html"
      ? parts[parts.length - 2]
      : parts[parts.length - 1];

  if (!index) return "DOCUMENTATION";

  return index
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function categoryFromPath(relativePath: string) {
  const parts = relativePath.split(path.sep).filter(Boolean);

  if (parts.length <= 1) {
    return "BARKLY";
  }

  return parts[0]
    .replace(/[-_]+/g, " ")
    .toUpperCase();
}

function typeFromPath(relativePath: string) {
  const normalized = relativePath.toLowerCase();

  if (
    normalized.includes("/technical/") ||
    normalized.includes("/technical-docs/") ||
    normalized.includes("/technical-documentation/")
  ) {
    return "technical";
  }

  if (
    normalized.includes("/specifications/") ||
    normalized.includes("/specs/")
  ) {
    return "specifications";
  }

  if (
    normalized.includes("/research/") ||
    normalized.includes("/papers/") ||
    normalized.includes("/research-papers/")
  ) {
    return "research";
  }

  if (
    normalized.includes("/requirements/") ||
    normalized.includes("/functional-requirements/") ||
    normalized.includes("/frd/")
  ) {
    return "requirements";
  }

  if (
    normalized.includes("/architecture/") ||
    normalized.includes("/design/")
  ) {
    return "architecture";
  }

  if (
    normalized.includes("/implementation/") ||
    normalized.includes("/reference/")
  ) {
    return "implementation";
  }

  if (
    normalized.includes("/testing/") ||
    normalized.includes("/tests/") ||
    normalized.includes("/validation/")
  ) {
    return "testing";
  }

  if (
    normalized.includes("/experiments/") ||
    normalized.includes("/notes/")
  ) {
    return "experiments";
  }

  if (
    normalized.includes("/guides/") ||
    normalized.includes("/how-to/") ||
    normalized.includes("/howto/")
  ) {
    return "guides";
  }

  if (
    normalized.includes("/history/") ||
    normalized.includes("/changelog/") ||
    normalized.includes("/changelogs/")
  ) {
    return "history";
  }

  return "technical";
}

function scanDirectory(directory: string, relative = "") {
  if (!fs.existsSync(directory)) return;

  const entries = fs.readdirSync(directory, {
    withFileTypes: true,
  });

  for (const entry of entries) {
    const absolutePath = path.join(directory, entry.name);
    const relativePath = path.join(relative, entry.name);

    if (entry.isDirectory()) {
      scanDirectory(absolutePath, relativePath);
      continue;
    }

    if (
      entry.isFile() &&
      entry.name.toLowerCase() === "index.html"
    ) {
      const normalized = relativePath.replaceAll(path.sep, "/");

      docs.push({
        title: titleFromPath(relativePath),
        slug: normalized
          .replace(/\/index\.html$/i, "")
          .replace(/^index\.html$/i, ""),
        href: `/docs/${normalized}`,
        category: categoryFromPath(relativePath),
        type: typeFromPath(relativePath),
        relativePath: normalized,
      });
    }
  }
}

scanDirectory(docsRoot);

docs.sort((a, b) =>
  a.relativePath.localeCompare(b.relativePath)
);

const categories = [
  ...new Set(docs.map((doc) => doc.category)),
];

const activeTypes = docTypes.filter((type) =>
  docs.some((doc) => doc.type === type.key)
);

const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Barkly Labs / Documentation</title>

    <meta
      name="description"
      content="Barkly Labs documentation, technical knowledge, research, specifications, requirements, architecture, experiments, and engineering references."
    />
  </head>

  <body>
    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <header class="topbar">
      <a href="/" class="brand">
        <span class="brand-symbol">◆</span>
        <span>BARKLY LABS</span>
      </a>

      <div class="topbar-center">
        DOCUMENTATION SYSTEM
      </div>

      <a href="/" class="back-link">
        ← RETURN TO LABS
      </a>
    </header>

    <main>
      <!-- =====================================================
           HERO
           ===================================================== -->

      <section class="docs-hero">
        <div class="hero-grid"></div>

        <div class="hero-content">
          <div class="system-status">
            <span class="status-dot"></span>
            KNOWLEDGE SYSTEM / ONLINE
          </div>

          <div class="hero-label">
            BARKLY / DOCS
          </div>

          <h1>
            KNOWLEDGE
            <span>ARCHIVE.</span>
          </h1>

          <p>
            Technical documentation, specifications, research,
            functional requirements, architecture, experiments,
            implementation references, and knowledge generated
            throughout the Barkly ecosystem.
          </p>

          <div class="hero-meta">
            <span>
              {docs.length.toString().padStart(2, "0")} DOCUMENTS
            </span>

            <span>
              {categories.length.toString().padStart(2, "0")} SYSTEMS
            </span>

            <span>
              {activeTypes.length.toString().padStart(2, "0")} KNOWLEDGE TYPES
            </span>

            <span>
              BUILD / DOCUMENT / LEARN
            </span>
          </div>
        </div>
      </section>

      <!-- =====================================================
           KNOWLEDGE LIBRARY
           ===================================================== -->

      <section class="knowledge-library">
        <div class="library-header">
          <div>
            <span class="section-number">01</span>

            <span class="section-kicker">
              KNOWLEDGE LIBRARY
            </span>

            <h2>
              MANY TYPES.
              <span>ONE SYSTEM.</span>
            </h2>
          </div>

          <div class="library-description">
            Barkly Docs treats documentation as more than source-code
            reference. Technical knowledge, requirements, research,
            specifications, architecture, experiments, and history
            all become part of the system.
          </div>
        </div>

        <div class="knowledge-grid">
          {
            docTypes.map((type, index) => {
              const count = docs.filter(
                (doc) => doc.type === type.key
              ).length;

              return (
                <a
                  href={
                    count > 0
                      ? `#${type.key}`
                      : undefined
                  }
                  class:list={[
                    "knowledge-card",
                    { "knowledge-card-empty": count === 0 },
                  ]}
                >
                  <span class="knowledge-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="knowledge-card-content">
                    <span class="knowledge-card-label">
                      {type.label}
                    </span>

                    <strong>
                      {count.toString().padStart(2, "0")}
                    </strong>

                    <span class="knowledge-card-description">
                      {type.description}
                    </span>
                  </span>

                  <span class="knowledge-card-arrow">
                    {count > 0 ? "VIEW →" : "READY"}
                  </span>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- =====================================================
           DOCUMENTATION INDEX
           ===================================================== -->

      <section class="archive">
        <div class="archive-header">
          <div>
            <span class="section-number">02</span>

            <span class="section-kicker">
              DOCUMENTATION INDEX
            </span>
          </div>

          <div class="archive-count">
            {docs.length.toString().padStart(2, "0")} ENTRIES
          </div>
        </div>

        {
          docs.length === 0 ? (
            <div class="empty-state">
              <span class="empty-symbol">[ 00 ]</span>

              <h2>
                NO DOCUMENTATION FOUND.
              </h2>

              <p>
                The Barkly Docs generator has not produced any
                <code>index.html</code> files yet.
              </p>
            </div>
          ) : (
            <div class="document-list">
              {docs.map((doc, index) => (
                <a
                  href={doc.href}
                  class="document-row"
                  data-category={doc.category}
                  data-type={doc.type}
                >
                  <span class="document-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="document-main">
                    <span class="document-category">
                      {doc.category}
                    </span>

                    <strong>
                      {doc.title}
                    </strong>

                    <span class="document-type">
                      {
                        docTypes.find(
                          (type) => type.key === doc.type
                        )?.label
                      }
                    </span>

                    <span class="document-path">
                      /{doc.relativePath}
                    </span>
                  </span>

                  <span class="document-open">
                    OPEN →
                  </span>
                </a>
              ))}
            </div>
          )
        }
      </section>

      <!-- =====================================================
           KNOWLEDGE TYPE INDEX
           ===================================================== -->

      {
        activeTypes.map((type, typeIndex) => {
          const typeDocs = docs.filter(
            (doc) => doc.type === type.key
          );

          return (
            <section
              class="type-section"
              id={type.key}
            >
              <div class="type-header">
                <div>
                  <span class="section-number">
                    {String(typeIndex + 3).padStart(2, "0")}
                  </span>

                  <span class="section-kicker">
                    KNOWLEDGE TYPE
                  </span>
                </div>

                <span class="type-count">
                  {typeDocs.length
                    .toString()
                    .padStart(2, "0")}{" "}
                  DOCUMENTS
                </span>
              </div>

              <div class="type-heading">
                <h2>
                  {type.label}
                </h2>

                <p>
                  {type.description}
                </p>
              </div>

              <div class="type-document-list">
                {typeDocs.map((doc) => (
                  <a
                    href={doc.href}
                    class="type-document"
                  >
                    <span class="type-document-category">
                      {doc.category}
                    </span>

                    <strong>
                      {doc.title}
                    </strong>

                    <span class="type-document-path">
                      /{doc.relativePath}
                    </span>

                    <span class="type-document-open">
                      →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          );
        })
      }

      <!-- =====================================================
           SYSTEM MAP
           ===================================================== -->

      <section class="system-map">
        <div class="map-header">
          <span class="section-number">13</span>

          <div>
            <span class="section-kicker">
              KNOWLEDGE GRAPH
            </span>

            <h2>
              ONE ECOSYSTEM.
              <span>MANY SYSTEMS.</span>
            </h2>
          </div>
        </div>

        <div class="map-grid">
          <div class="map-core">
            <span class="core-label">
              BARKLY
            </span>

            <strong>
              KNOWLEDGE
            </strong>

            <small>
              DOCUMENTATION CORE
            </small>
          </div>

          <div class="map-node node-a">
            <span>01</span>
            <strong>RESEARCH</strong>
          </div>

          <div class="map-node node-b">
            <span>02</span>
            <strong>ENGINEERING</strong>
          </div>

          <div class="map-node node-c">
            <span>03</span>
            <strong>SYSTEMS</strong>
          </div>

          <div class="map-node node-d">
            <span>04</span>
            <strong>PEOPLE</strong>
          </div>

          <div class="map-line line-a"></div>
          <div class="map-line line-b"></div>
          <div class="map-line line-c"></div>
          <div class="map-line line-d"></div>
        </div>
      </section>

      <!-- =====================================================
           DOCUMENTATION PRINCIPLE
           ===================================================== -->

      <section class="docs-principle">
        <div class="principle-number">
          14
        </div>

        <div>
          <span class="section-kicker">
            BARKLY PRINCIPLE
          </span>

          <h2>
            DOCUMENTATION
            <span>IS INFRASTRUCTURE.</span>
          </h2>

          <p>
            A system should not depend on one person's memory.
            Documentation makes the architecture, requirements,
            decisions, experiments, failures, implementation,
            research, and knowledge of a system understandable
            enough for other people to use, question, modify,
            validate, and improve it.
          </p>

          <p>
            Barkly Docs treats knowledge as part of the engineering
            system itself. Documentation is created alongside the
            systems it describes and evolves as those systems change.
          </p>
        </div>
      </section>
    </main>

    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="footer">
      <div class="footer-main">
        <div>
          <div class="footer-logo">
            BARKLY
          </div>

          <div class="footer-labs">
            LABS / DOCS
          </div>
        </div>

        <div class="footer-tagline">
          KNOWLEDGE
          <br />
          BECOMES INFRASTRUCTURE.
        </div>
      </div>

      <div class="footer-bottom">
        <span>
          © {year} BARKLY LABS
        </span>

        <span>
          DETROIT, MICHIGAN
        </span>

        <a href="/">
          BARKLY LABS ↗
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #050505;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #050505;
    color: #f2f2f2;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    overflow-x: hidden;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: #f2f2f2;
    color: #050505;
  }

  /* =========================================================
     TOPBAR
     ========================================================= */

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    min-height: 72px;
    padding: 0 5vw;

    border-bottom: 1px solid rgba(255, 255, 255, 0.1);

    background: rgba(5, 5, 5, 0.92);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;

    font-family: "Courier New", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .brand-symbol {
    font-size: 8px;
  }

  .topbar-center {
    color: rgba(255, 255, 255, 0.35);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
  }

  .back-link {
    justify-self: end;

    color: rgba(255, 255, 255, 0.5);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.12em;

    transition: color 0.2s;
  }

  .back-link:hover {
    color: #fff;
  }

  /* =========================================================
     HERO
     ========================================================= */

  .docs-hero {
    position: relative;

    min-height: 650px;

    display: flex;
    align-items: center;

    padding: 130px 10vw;

    overflow: hidden;

    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-grid {
    position: absolute;
    inset: 0;

    opacity: 0.12;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      );

    background-size: 60px 60px;

    mask-image: linear-gradient(
      90deg,
      black,
      transparent 75%
    );
  }

  .docs-hero::after {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      radial-gradient(
        circle at 80% 40%,
        rgba(255, 255, 255, 0.07),
        transparent 28%
      ),
      linear-gradient(
        90deg,
        #050505 10%,
        transparent 85%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;

    width: min(950px, 100%);
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 45px;

    color: rgba(255, 255, 255, 0.38);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
  }

  .status-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #fff;

    box-shadow:
      0 0 12px rgba(255, 255, 255, 0.7);
  }

  .hero-label {
    color: rgba(255, 255, 255, 0.3);

    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
  }

  .docs-hero h1 {
    margin: 28px 0;

    font-size: clamp(70px, 11vw, 160px);
    line-height: 0.78;
    letter-spacing: -0.08em;
  }

  .docs-hero h1 span {
    display: block;
    margin-left: 12vw;

    color: rgba(255, 255, 255, 0.3);
  }

  .docs-hero p {
    max-width: 700px;

    margin: 50px 0 35px;

    color: rgba(255, 255, 255, 0.52);

    font-size: 15px;
    line-height: 1.8;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;

    color: rgba(255, 255, 255, 0.25);

    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 0.14em;
  }

  /* =========================================================
     KNOWLEDGE LIBRARY
     ========================================================= */

  .knowledge-library {
    padding: 130px 10vw;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .library-header {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 80px;

    align-items: end;

    margin-bottom: 70px;
  }

  .section-number,
  .section-kicker {
    font-family: "Courier New", monospace;
  }

  .section-number {
    display: block;

    margin-bottom: 10px;

    color: rgba(255, 255, 255, 0.25);
    font-size: 10px;
  }

  .section-kicker {
    color: rgba(255, 255, 255, 0.4);

    font-size: 9px;
    letter-spacing: 0.16em;
  }

  .library-header h2 {
    margin: 22px 0 0;

    max-width: 900px;

    font-size: clamp(50px, 7vw, 100px);
    line-height: 0.86;
    letter-spacing: -0.06em;
  }

  .library-header h2 span {
    display: block;

    color: rgba(255, 255, 255, 0.3);
  }

  .library-description {
    color: rgba(255, 255, 255, 0.5);

    font-size: 14px;
    line-height: 1.8;
  }

  .knowledge-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .knowledge-card {
    position: relative;

    display: grid;
    grid-template-columns: 50px 1fr auto;
    gap: 20px;

    min-height: 190px;
    padding: 28px;

    border-right: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);

    transition:
      background 0.25s,
      transform 0.25s;
  }

  .knowledge-card:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .knowledge-card-empty {
    opacity: 0.55;
  }

  .knowledge-number {
    color: rgba(255, 255, 255, 0.22);

    font-family: "Courier New", monospace;
    font-size: 9px;
  }

  .knowledge-card-content {
    display: flex;
    flex-direction: column;
  }

  .knowledge-card-label {
    color: rgba(255, 255, 255, 0.42);

    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .knowledge-card-content strong {
    margin: 18px 0 10px;

    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .knowledge-card-description {
    max-width: 400px;

    color: rgba(255, 255, 255, 0.4);

    font-size: 12px;
    line-height: 1.7;
  }

  .knowledge-card-arrow {
    align-self: end;

    color: rgba(255, 255, 255, 0.3);

    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  /* =========================================================
     ARCHIVE
     ========================================================= */

  .archive {
    padding: 120px 10vw;
  }

  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: end;

    padding-bottom: 25px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .archive-header > div:first-child {
    display: flex;
    gap: 35px;
  }

  .archive-header .section-number {
    margin: 0;
  }

  .archive-count,
  .type-count {
    color: rgba(255, 255, 255, 0.25);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .document-list {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .document-row {
    display: grid;
    grid-template-columns: 70px 1fr 110px;
    gap: 30px;
