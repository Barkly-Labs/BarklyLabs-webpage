---
import SEO from "../components/SEO.astro";
import fs from "node:fs";
import path from "node:path";

const docsRoot = path.join(process.cwd(), "public", "docs");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

type DocEntry = {
  title: string;
  slug: string;
  href: string;
  category: string;
  relativePath: string;
  type: string;
};

const docs: DocEntry[] = [];

const docTypes = [
  {
    key: "technical",
    label: "TECHNICAL DOCUMENTATION",
    description:
      "Implementation details, generated references, APIs, modules, dependencies, and system behavior.",
  },
  {
    key: "requirements",
    label: "FUNCTIONAL REQUIREMENTS",
    description:
      "Functional requirements describing what systems should do and how they should behave.",
  },
];

function titleFromPath(relativePath: string) {
  const parts = relativePath.split(path.sep).filter(Boolean);

  const index =
    parts[parts.length - 1] === "index.html"
      ? parts[parts.length - 2]
      : parts[parts.length - 1];

  if (!index) return "DOCUMENTATION";

  return index
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function categoryFromPath(relativePath: string) {
  const parts = relativePath.split(path.sep).filter(Boolean);

  if (parts.length <= 1) {
    return "BARKLY";
  }

  return parts[0]
    .replace(/[-_]+/g, " ")
    .toUpperCase();
}

function typeFromPath(relativePath: string) {
  const normalized = relativePath.replaceAll(path.sep, "/").toLowerCase();
  const root = normalized.split("/").filter(Boolean)[0] ?? "";

  if (
    root === "technical" ||
    root === "technical-docs" ||
    root === "technical-documentation"
  ) {
    return "technical";
  }

  if (
    root === "functional-requirements" ||
    root === "requirements" ||
    root === "frd"
  ) {
    return "requirements";
  }

  return "unclassified";
}

function scanDirectory(directory: string, relative = "") {
  if (!fs.existsSync(directory)) return;

  const entries = fs.readdirSync(directory, {
    withFileTypes: true,
  });

  for (const entry of entries) {
    const absolutePath = path.join(directory, entry.name);
    const relativePath = path.join(relative, entry.name);

    if (entry.isDirectory()) {
      scanDirectory(absolutePath, relativePath);
      continue;
    }

    if (
      entry.isFile() &&
      entry.name.toLowerCase() === "index.html"
    ) {
      const normalized = relativePath.replaceAll(path.sep, "/");

      docs.push({
        title: titleFromPath(relativePath),

        slug: normalized
          .replace(/\/index\.html$/i, "")
          .replace(/^index\.html$/i, ""),

        href: `${baseUrl}/docs/${normalized}`,

        category: categoryFromPath(relativePath),

        type: typeFromPath(relativePath),

        relativePath: normalized,
      });
    }
  }
}

scanDirectory(docsRoot);

docs.sort((a, b) =>
  a.relativePath.localeCompare(b.relativePath)
);

const categories = [
  ...new Set(docs.map((doc) => doc.category)),
];

const activeTypes = docTypes.filter((type) =>
  docs.some((doc) => doc.type === type.key)
);

const year = 2026;
---

<!doctype html>
<html lang="en">

  <head>
<meta name="twitter:description" content="Barkly Docs is an automated documentation system designed to make software architecture and project structure easier for humans to understand.">
<meta name="twitter:title" content="Barkly Labs — Barkly Docs">
<meta name="twitter:card" content="summary_large_image">
<meta property="og:site_name" content="Barkly Labs">
<meta property="og:url" content="https://www.barklylabs.space/docs/">
<meta property="og:description" content="Barkly Docs is an automated documentation system designed to make software architecture and project structure easier for humans to understand.">
<meta property="og:title" content="Barkly Labs — Barkly Docs">
<meta property="og:type" content="website">
<link rel="canonical" href="https://www.barklylabs.space/docs/">
<meta name="robots" content="index, follow">
<meta name="description" content="Barkly Docs is an automated documentation system designed to make software architecture and project structure easier for humans to understand.">
<title>Barkly Labs — Barkly Docs</title>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <SEO />


    

  </head>

  <body>

    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <header class="topbar">

      <a href={import.meta.env.BASE_URL + ""} class="brand">

        <span class="brand-symbol">◆</span>

        <span>BARKLY LABS</span>

      </a>

      <div class="topbar-center">
        DOCUMENTATION SYSTEM
      </div>

      <a href={import.meta.env.BASE_URL + ""} class="back-link">
        ← RETURN TO LABS
      </a>

    </header>


    <main>

      <!-- =====================================================
           HERO
           ===================================================== -->

      <section class="docs-hero">

        <div class="hero-grid"></div>

        <div class="hero-content">

          <div class="system-status">

            <span class="status-dot"></span>

            KNOWLEDGE SYSTEM / ONLINE

          </div>

          <div class="hero-label">
            BARKLY / DOCS
          </div>

          <h1>
            KNOWLEDGE
            <span>ARCHIVE.</span>
          </h1>

          <p>
            Technical documentation, research notes, system
            architecture, experiments, references, and knowledge
            generated throughout the Barkly ecosystem.
          </p>

          <div class="hero-meta">

            <span>
              {docs.length.toString().padStart(2, "0")} DOCUMENTS
            </span>

            <span>
              {categories.length.toString().padStart(2, "0")} SYSTEMS
            </span>

            <span>
              BUILD / DOCUMENT / LEARN
            </span>

          </div>

        </div>

      </section>


      <!-- =====================================================
           KNOWLEDGE TYPE SECTIONS
           ===================================================== -->

      {
        activeTypes.map((type, typeIndex) => {

          const typeDocs = docs.filter(
            (doc) => doc.type === type.key
          );

          return (

            <section
              class="type-section"
              id={type.key}
            >

              <div class="type-container">

                <div class="type-header">

                  <div class="type-header-main">

                    <span class="section-number">
                      {String(typeIndex + 1).padStart(2, "0")}
                    </span>

                    <div>

                      <span class="section-kicker">
                        BARKLY / KNOWLEDGE TYPE
                      </span>

                      <h2>{type.label}</h2>

                    </div>

                  </div>

                  <div class="type-count">

                    <span>DOCUMENTS</span>

                    <strong>
                      {typeDocs.length.toString().padStart(2, "0")}
                    </strong>

                  </div>

                </div>


                <div class="type-description">

                  <p>{type.description}</p>

                </div>


                <div class="type-document-list">

                  {
                    typeDocs.length === 0 ? (

                      <div class="empty-type">

                        <span>[ 00 ]</span>

                        <p>
                          NO DOCUMENTATION FOUND.
                        </p>

                      </div>

                    ) : (

                      typeDocs.map((doc, index) => (

                        <a
                          href={doc.href}
                          class="type-document"
                        >

                          <span class="type-document-number">
                            {String(index + 1).padStart(2, "0")}
                          </span>

                          <span class="type-document-main">

                            <span class="document-category">
                              {doc.category}
                            </span>

                            <strong>
                              {doc.title}
                            </strong>

                            <span class="document-path">
                              /{doc.relativePath}
                            </span>

                          </span>

                          <span class="type-document-open">
                            OPEN →
                          </span>

                        </a>

                      ))

                    )
                  }

                </div>

              </div>

            </section>

          );

        })
      }


      <!-- =====================================================
           SYSTEM MAP
           ===================================================== -->

      <section class="system-map">

        <div class="map-header">

          <span class="section-number">
            03
          </span>

          <div>

            <span class="section-kicker">
              KNOWLEDGE GRAPH
            </span>

            <h2>
              ONE ECOSYSTEM.
              <span>MANY SYSTEMS.</span>
            </h2>

          </div>

        </div>


        <div class="map-grid">

          <div class="map-core">

            <span class="core-label">
              BARKLY
            </span>

            <strong>
              KNOWLEDGE
            </strong>

            <small>
              DOCUMENTATION CORE
            </small>

          </div>


          <div class="map-node node-a">

            <span>01</span>

            <strong>
              RESEARCH
            </strong>

          </div>


          <div class="map-node node-b">

            <span>02</span>

            <strong>
              ENGINEERING
            </strong>

          </div>


          <div class="map-node node-c">

            <span>03</span>

            <strong>
              SYSTEMS
            </strong>

          </div>


          <div class="map-node node-d">

            <span>04</span>

            <strong>
              PEOPLE
            </strong>

          </div>


          <div class="map-line line-a"></div>

          <div class="map-line line-b"></div>

          <div class="map-line line-c"></div>

          <div class="map-line line-d"></div>

        </div>

      </section>


      <!-- =====================================================
           PRINCIPLE
           ===================================================== -->

      <section class="docs-principle">

        <div class="principle-number">
          04
        </div>

        <div>

          <span class="section-kicker">
            BARKLY PRINCIPLE
          </span>

          <h2>
            DOCUMENTATION
            <span>IS INFRASTRUCTURE.</span>
          </h2>

          <p>
            A system should not depend on one person's memory.
            Documentation makes the architecture, decisions,
            experiments, failures, and knowledge of a system
            understandable enough for other people to use,
            question, modify, and improve it.
          </p>

        </div>

      </section>

    </main>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="footer">

      <div class="footer-main">

        <div>

          <div class="footer-logo">
            BARKLY
          </div>

          <div class="footer-labs">
            LABS / DOCS
          </div>

        </div>

        <div class="footer-tagline">
          KNOWLEDGE
          <br />
          BECOMES INFRASTRUCTURE.
        </div>

      </div>


      <div class="footer-bottom">

       <span>© {year} BARKLY LABS</span>
          <span>© 2026 Barkly Labs · Michigan nonprofit corporation -  Sept 29, 2026</span>
          <span>TECHNOLOGY SHOULD ADAPT TO HUMANS.</span>

        <a href={import.meta.env.BASE_URL + ""}>
          BARKLY LABS ↗
        </a>

      </div>

    </footer>


  </body>

</html>


<style>

  /* =========================================================
     BARKLY COLOR SYSTEM
     ========================================================= */

  :global(:root) {
    --bg: #050505;

    --panel: #0a0a0a;

    --panel-raised: #0f0f0f;

    --panel-hover: #131313;

    --border: #242424;

    --border-strong: #383838;

    --text: #f1f1f1;

    --muted: #a1a1a1;

    --dim: #686868;

    --faint: #444;

    --pink: #ff2f92;

    --pink-soft: rgba(255, 47, 146, 0.10);

    --pink-line: rgba(255, 47, 146, 0.42);
  }


  /* =========================================================
     GLOBAL
     ========================================================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--bg);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;

    background: var(--bg);

    color: var(--text);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    overflow-x: hidden;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: var(--pink);
    color: #050505;
  }


  /* =========================================================
     TOPBAR
     ========================================================= */

  .topbar {

    position: sticky;

    top: 0;

    z-index: 50;

    display: grid;

    grid-template-columns: 1fr auto 1fr;

    align-items: center;

    min-height: 72px;

    padding: 0 5vw;

    border-bottom: 1px solid var(--border);

    background: rgba(5, 5, 5, 0.92);

    backdrop-filter: blur(14px);
  }


  .brand {

    display: flex;

    align-items: center;

    gap: 10px;

    font-family: "Courier New", monospace;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.18em;
  }


  .brand-symbol {

    color: var(--pink);

    font-size: 8px;

    text-shadow:
      0 0 12px rgba(255, 47, 146, 0.45);
  }


  .topbar-center {

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 9px;

    letter-spacing: 0.18em;
  }


  .back-link {

    justify-self: end;

    color: var(--muted);

    font-family: "Courier New", monospace;

    font-size: 9px;

    letter-spacing: 0.12em;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }


  .back-link:hover {

    color: var(--pink);

    transform: translateX(-2px);
  }


  /* =========================================================
     HERO
     ========================================================= */

  .docs-hero {

    position: relative;

    min-height: 650px;

    display: flex;

    align-items: center;

    padding: 130px 10vw;

    overflow: hidden;

    border-bottom: 1px solid var(--border);

    background:
      radial-gradient(
        circle at 80% 40%,
        rgba(255, 47, 146, 0.07),
        transparent 25%
      ),
      var(--bg);
  }


  .hero-grid {

    position: absolute;

    inset: 0;

    opacity: 0.12;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      );

    background-size: 60px 60px;

    mask-image:
      linear-gradient(
        90deg,
        black,
        transparent 75%
      );
  }


  .docs-hero::after {

    content: "";

    position: absolute;

    inset: 0;

    pointer-events: none;

    background:
      radial-gradient(
        circle at 82% 42%,
        rgba(255, 47, 146, 0.07),
        transparent 25%
      ),
      linear-gradient(
        90deg,
        #050505 10%,
        transparent 85%
      );
  }


  .hero-content {

    position: relative;

    z-index: 2;

    width: min(950px, 100%);
  }


  .system-status {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 45px;

    color: var(--muted);

    font-family: "Courier New", monospace;

    font-size: 9px;

    letter-spacing: 0.15em;
  }


  .status-dot {

    width: 6px;

    height: 6px;

    border-radius: 50%;

    background: var(--pink);

    box-shadow:
      0 0 10px rgba(255, 47, 146, 0.75),
      0 0 20px rgba(255, 47, 146, 0.3);
  }


  .hero-label {

    color: var(--pink);

    font-family: "Courier New", monospace;

    font-size: 10px;

    letter-spacing: 0.2em;
  }


  .docs-hero h1 {

    margin: 28px 0;

    color: var(--text);

    font-size: clamp(70px, 11vw, 160px);

    line-height: 0.78;

    letter-spacing: -0.08em;
  }


  .docs-hero h1 span {

    display: block;

    margin-left: 12vw;

    color: var(--pink);

    text-shadow:
      0 0 35px rgba(255, 47, 146, 0.12);
  }


  .docs-hero p {

    max-width: 650px;

    margin: 50px 0 35px;

    color: var(--muted);

    font-size: 15px;

    line-height: 1.8;
  }


  .hero-meta {

    display: flex;

    flex-wrap: wrap;

    gap: 30px;

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 8px;

    letter-spacing: 0.14em;
  }


  .hero-meta span:first-child {

    color: var(--pink);
  }


  /* =========================================================
     SECTION SYSTEM
     ========================================================= */

  .section-number {

    color: var(--pink);

    font-family: "Courier New", monospace;

    font-size: 11px;

    letter-spacing: 0.08em;
  }


  .section-kicker {

    display: block;

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 8px;

    letter-spacing: 0.18em;
  }


  /* =========================================================
     KNOWLEDGE TYPE CARDS
     ========================================================= */

  .type-section {

    padding: 80px 10vw;

    background: var(--bg);

    border-top: 1px solid var(--border);
  }


  .type-container {

    width: 100%;

    max-width: 1400px;

    margin: 0 auto;

    padding: 50px;

    background: var(--panel);

    border: 1px solid var(--border);

    overflow: hidden;
  }


  .type-header {

    display: flex;

    justify-content: space-between;

    align-items: end;

    gap: 40px;

    padding-bottom: 25px;

    border-bottom: 1px solid var(--border-strong);
  }


  .type-header-main {

    display: flex;

    gap: 35px;
  }


  .type-header h2 {

    margin: 15px 0 0;

    color: var(--text);

    font-size: clamp(34px, 4vw, 60px);

    line-height: 0.9;

    letter-spacing: -0.055em;
  }


  .type-count {

    display: flex;

    flex-direction: column;

    align-items: flex-end;

    gap: 7px;

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 8px;

    letter-spacing: 0.12em;
  }


  .type-count strong {

    color: var(--pink);

    font-size: 20px;

    font-weight: 400;
  }


  .type-description {

    padding: 25px 0;

    border-bottom: 1px solid var(--border);
  }


  .type-description p {

    max-width: 700px;

    margin: 0;

    color: var(--muted);

    font-size: 13px;

    line-height: 1.7;
  }


  .type-document-list {

    width: 100%;
  }


  .type-document {

    display: grid;

    grid-template-columns: 55px 1fr 110px;

    gap: 30px;

    align-items: center;

    min-height: 115px;

    border-bottom: 1px solid var(--border);

    transition:
      background 0.25s ease,
      padding 0.25s ease,
      border-color 0.25s ease;
  }


  .type-document:last-child {

    border-bottom: 0;
  }


  .type-document:hover {

    padding-left: 15px;

    padding-right: 15px;

    background: var(--pink-soft);

    border-color: var(--pink-line);
  }


  .type-document-number {

    color: var(--pink);

    font-family: "Courier New", monospace;

    font-size: 10px;
  }


  .type-document-main {

    display: flex;

    flex-direction: column;

    gap: 7px;
  }


  .document-category {

    color: var(--pink);

    font-family: "Courier New", monospace;

    font-size: 8px;

    letter-spacing: 0.14em;
  }


  .type-document-main strong {

    color: var(--text);

    font-size: 22px;

    letter-spacing: -0.035em;
  }


  .document-path {

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 8px;

    letter-spacing: 0.05em;
  }


  .type-document-open {

    justify-self: end;

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 8px;

    letter-spacing: 0.12em;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }


  .type-document:hover .type-document-open {

    color: var(--pink);

    transform: translateX(3px);
  }


  .empty-type {

    padding: 70px 0;

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 9px;

    letter-spacing: 0.12em;

    text-align: center;
  }


  .empty-type span {

    color: var(--pink);
  }


  .empty-type p {

    margin: 15px 0 0;
  }


  /* =========================================================
     SYSTEM MAP
     ========================================================= */

  .system-map {

    position: relative;

    min-height: 750px;

    padding: 140px 10vw;

    background: var(--panel);

    border-top: 1px solid var(--border);

    border-bottom: 1px solid var(--border);

    overflow: hidden;
  }


  .map-header {

    display: grid;

    grid-template-columns: 100px 1fr;

    gap: 40px;

    position: relative;

    z-index: 3;
  }


  .map-header h2 {

    margin: 18px 0 0;

    max-width: 850px;

    color: var(--text);

    font-size: clamp(45px, 7vw, 95px);

    line-height: 0.86;

    letter-spacing: -0.06em;
  }


  .map-header h2 span {

    display: block;

    color: var(--pink);
  }


  .map-grid {

    position: relative;

    width: min(800px, 80vw);

    height: 480px;

    margin: 80px auto 0;
  }


  .map-core {

    position: absolute;

    top: 50%;

    left: 50%;

    width: 180px;

    height: 180px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    transform: translate(-50%, -50%);

    border: 1px solid var(--pink-line);

    background: var(--panel);

    box-shadow:
      0 0 40px rgba(255, 47, 146, 0.05);

    text-align: center;
  }


  .core-label {

    color: var(--pink);

    font-family: "Courier New", monospace;

    font-size: 8px;

    letter-spacing: 0.18em;
  }


  .map-core strong {

    margin: 10px 0;

    color: var(--text);

    font-size: 23px;

    letter-spacing: -0.04em;
  }


  .map-core small {

    color: var(--dim);

    font-family: "Courier New", monospace;

    font-size: 7px;

    letter-spacing: 0.12em;
  }


  .map-node {

    position: absolute;

    display: flex;

    flex-direction: column;

    gap: 7px;

    padding: 15px;

    min-width: 150px;

    border: 1px solid var(--border-strong);

    background: rgba(10, 10, 10, 0.92);

    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }


  .map-node:hover {

    border-color: var(--pink-line);

    background: var(--pink-soft);
  }


  .map-node span {

    color: var(--pink);

    font-family: "Courier New", monospace;

    font-size: 8px;
  }


  .map-node strong {

    color: var(--text);

    font-family: "Courier New", monospace;

    font-size: 9px;

    letter-spacing: 0.12em;
  }


  .node-a {

    top: 20px;

    left: 0;
  }


  .node-b {

    top: 20px;

    right: 0;
  }


  .node-c {

    bottom: 20px;

    left: 0;
  }


  .node-d {

    bottom: 20px;

    right: 0;
  }


  .map-line {

    position: absolute;

    background: var(--pink-line);

    transform-origin: center;

    opacity: 0.55;
  }


  .line-a,
  .line-b {

    top: 34%;

    width: 260px;

    height: 1px;
