---
const capabilities = [
  {
    id: "01",
    name: "LOCAL INTELLIGENCE",
    category: "INTELLIGENCE",
    description:
      "Run capable AI locally, keeping computation close to the person, the machine, and the data.",
    features: [
      "LOCAL INFERENCE",
      "OLLAMA SUPPORT",
      "MODEL SELECTION",
      "PRIVATE PROCESSING",
    ],
  },
  {
    id: "02",
    name: "REASONING",
    category: "INTELLIGENCE",
    description:
      "Turn messy human input into structured thought, explanations, plans, and useful next steps.",
    features: [
      "CONTEXT UNDERSTANDING",
      "PROBLEM SOLVING",
      "PLANNING",
      "TASK DECOMPOSITION",
    ],
  },
  {
    id: "03",
    name: "MEMORY",
    category: "CONTEXT",
    description:
      "Give CYN-X continuity across interactions so the system can work with projects, preferences, and ongoing context.",
    features: [
      "CONVERSATION CONTEXT",
      "PROJECT CONTEXT",
      "PERSISTENT MEMORY",
      "USER CONTROL",
    ],
  },
  {
    id: "04",
    name: "TOOLS",
    category: "ACTION",
    description:
      "Connect intelligence to software, files, services, and systems so CYN-X can do more than generate text.",
    features: [
      "TOOL CALLING",
      "FILE OPERATIONS",
      "SYSTEM INTEGRATION",
      "AUTOMATION",
    ],
  },
  {
    id: "05",
    name: "VISION",
    category: "MULTIMODAL",
    description:
      "Extend CYN-X beyond text by allowing the system to interpret visual information.",
    features: [
      "IMAGE UNDERSTANDING",
      "OBJECT DETECTION",
      "VISUAL ANALYSIS",
      "COMPUTER VISION",
    ],
  },
  {
    id: "06",
    name: "MULTIMODAL INTERACTION",
    category: "INTERFACE",
    description:
      "Build interfaces where humans and machines can communicate through more than one medium.",
    features: [
      "TEXT",
      "IMAGES",
      "AUDIO",
      "DEVICE INPUT",
    ],
  },
  {
    id: "07",
    name: "PERSONALITY",
    category: "INTERACTION",
    description:
      "Allow the same underlying intelligence to operate through different interaction styles and behavioral modes.",
    features: [
      "NORMAL",
      "SOLVER",
      "HELPER",
      "GREMLIN",
      "FLIRTY",
    ],
  },
  {
    id: "08",
    name: "HUMAN–AI COLLABORATION",
    category: "HUMAN INTERFACE",
    description:
      "CYN-X is designed to help humans think, create, build, understand, and operate systems rather than simply replace their decisions.",
    features: [
      "EXPLANATION",
      "CO-CREATION",
      "RESEARCH",
      "PROJECT SUPPORT",
    ],
  },
  {
    id: "09",
    name: "DEVELOPER INFRASTRUCTURE",
    category: "SYSTEM",
    description:
      "Provide a foundation that can be extended into applications, experiments, agents, interfaces, and hardware.",
    features: [
      "PYTHON",
      "FASTAPI",
      "APIS",
      "MODULAR SERVICES",
    ],
  },
];

const modes = [
  ["01", "NORMAL", "General interaction and everyday assistance."],
  ["02", "SOLVER", "Focused reasoning and structured problem solving."],
  ["03", "GREMLIN", "Experimental, chaotic, playful interaction."],
  ["04", "HELPER", "Supportive task-oriented interaction."],
  ["05", "FLIRTY", "A deliberately different social interaction mode."],
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="CYN-X capabilities — intelligence, memory, tools, vision, multimodal interaction, and human-AI collaboration."
    />
    <title>CYN-X CAPABILITIES // BARKLY LABS</title>

    <style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #050505;
    color: #f1f1f1;
    font-family:
      "IBM Plex Mono",
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :root {
    --bg: #050505;
    --panel: #0a0a0a;
    --panel-raised: #0f0f0f;
    --panel-hover: #131313;

    --text: #f1f1f1;
    --white: #f1f1f1;

    --muted: #a1a1a1;
    --dim: #686868;
    --faint: #444;

    --line: rgba(255, 255, 255, 0.12);
    --line-strong: rgba(255, 255, 255, 0.25);

    --pink: #ff2f92;
    --pink-soft: rgba(255, 47, 146, 0.10);
    --pink-line: rgba(255, 47, 146, 0.42);

    --max: 1500px;
  }

  .page {
    min-height: 100vh;
    overflow: hidden;
  }

  /* ───────────────── HEADER ───────────────── */

  .header {
    height: 64px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(12px);
    z-index: 50;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    letter-spacing: 0.15em;
    font-weight: 700;
  }

  .brand-mark {
    width: 10px;
    height: 10px;
    border: 1px solid var(--pink);
    transform: rotate(45deg);
    box-shadow: 0 0 10px rgba(255, 47, 146, 0.18);
  }

  .header-status {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  /* ───────────────── HERO ───────────────── */

  .hero {
    min-height: 100vh;
    padding: 150px 5vw 90px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    position: relative;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 3px,
        rgba(255, 255, 255, 0.012) 4px
      );
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--pink);
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(5rem, 14vw, 13rem);
    line-height: 0.78;
    letter-spacing: -0.075em;
    margin: 100px 0 60px;
    max-width: 1200px;
    position: relative;
    z-index: 1;
  }

  .hero h1 span {
    display: block;
    color: var(--pink);
    -webkit-text-stroke: 1px var(--pink);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    position: relative;
    z-index: 1;
  }

  .hero-bottom p {
    max-width: 650px;
    font-size: 16px;
    line-height: 1.8;
    color: #c9c9c9;
    margin: 0;
  }

  .hero-index {
    font-size: 10px;
    color: var(--dim);
    line-height: 2;
  }

  /* ───────────────── SECTION ───────────────── */

  section {
    border-bottom: 1px solid var(--line);
  }

  .section-inner {
    width: min(var(--max), 90vw);
    margin: auto;
    padding: 120px 0;
  }

  .section-head {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 50px;
    margin-bottom: 80px;
  }

  .section-number {
    color: var(--pink);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .section-title {
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    margin: 0;
  }

  .section-description {
    max-width: 680px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
    margin-top: 25px;
  }

  /* ───────────────── CAPABILITY GRID ───────────────── */

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .capability {
    min-height: 390px;
    padding: 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    position: relative;
    transition: background 0.25s ease;
  }

  .capability:hover {
    background: var(--panel-hover);
  }

  .capability::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 1px;
    background: var(--pink);
  }

  .capability-number {
    color: var(--pink);
    font-size: 10px;
  }

  .capability-category {
    color: var(--dim);
    font-size: 9px;
    letter-spacing: 0.16em;
    margin-top: 50px;
  }

  .capability h3 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 29px;
    letter-spacing: -0.04em;
    margin: 10px 0 22px;
  }

  .capability p {
    color: #aaa;
    font-size: 12px;
    line-height: 1.75;
    max-width: 400px;
  }

  .features {
    margin-top: 35px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .feature {
    border: 1px solid #303030;
    padding: 7px 9px;
    font-size: 8px;
    color: #aaa;
    letter-spacing: 0.08em;
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease;
  }

  .feature:hover {
    border-color: var(--pink-line);
    color: var(--pink);
    background: var(--pink-soft);
  }

  /* ───────────────── MODES ───────────────── */

  .mode-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    border-top: 1px solid var(--line);
  }

  .mode-intro {
    padding: 35px 35px 35px 0;
    border-right: 1px solid var(--line);
  }

  .mode-intro h3 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 44px;
    line-height: 0.9;
    letter-spacing: -0.05em;
    margin: 0 0 25px;
  }

  .mode-intro p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .modes {
    display: grid;
  }

  .mode {
    display: grid;
    grid-template-columns: 70px 180px 1fr;
    align-items: center;
    min-height: 105px;
    border-bottom: 1px solid var(--line);
    padding: 0 30px;
    gap: 25px;
    transition:
      background 0.25s ease,
      padding-left 0.25s ease;
  }

  .mode:last-child {
    border-bottom: 0;
  }

  .mode:hover {
    background: var(--pink-soft);
    padding-left: 36px;
  }

  .mode-id {
    color: var(--pink);
    font-size: 10px;
  }

  .mode-name {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .mode-description {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
  }

  /* ───────────────── FLOW ───────────────── */

  .flow {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .flow-node {
    min-height: 210px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 25px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .flow-node:hover {
    background: var(--pink-soft);
    border-color: var(--pink-line);
  }

  .flow-number {
    color: var(--pink);
    font-size: 10px;
  }

  .flow-node strong {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 22px;
    letter-spacing: -0.04em;
  }

  .flow-node small {
    color: var(--dim);
    font-size: 9px;
    line-height: 1.6;
  }

  /* ───────────────── MATRIX ───────────────── */

  .matrix {
    border: 1px solid var(--line);
  }

  .matrix-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    border-bottom: 1px solid var(--line);
    transition: background 0.25s ease;
  }

  .matrix-row:last-child {
    border-bottom: 0;
  }

  .matrix-row:hover {
    background: var(--pink-soft);
  }

  .matrix-label {
    padding: 24px;
    border-right: 1px solid var(--line);
    font-size: 10px;
    color: var(--pink);
  }

  .matrix-value {
    padding: 24px;
    font-size: 12px;
    line-height: 1.8;
    color: #c4c4c4;
  }

  /* ───────────────── FINAL ───────────────── */

  .final {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: 120px 5vw;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .final h2 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(4rem, 11vw, 11rem);
    line-height: 0.78;
    letter-spacing: -0.075em;
    max-width: 1200px;
    margin: 0;
  }

  .final h2 span {
    color: transparent;
    -webkit-text-stroke: 1px var(--pink);
  }

  .final-meta {
    margin-top: 60px;
    color: var(--muted);
    font-size: 11px;
    line-height: 2;
    max-width: 550px;
  }

  /* ───────────────── FOOTER ───────────────── */

  footer {
    padding: 30px;
    display: flex;
    justify-content: space-between;
    color: var(--dim);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  footer span:first-child {
    color: var(--pink);
  }

  /* ───────────────── RESPONSIVE ───────────────── */

  @media (max-width: 1000px) {
    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .flow {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero-bottom,
    .mode-layout {
      grid-template-columns: 1fr;
    }

    .mode-intro {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-right: 0;
    }
  }

  @media (max-width: 650px) {
    .header {
      padding: 0 16px;
    }

    .header-status {
      display: none;
    }

    .hero {
      padding: 120px 22px 60px;
    }

    .hero h1 {
      font-size: 22vw;
      margin: 80px 0;
    }

    .hero-bottom {
      gap: 30px;
    }

    .section-inner {
      width: calc(100% - 44px);
      padding: 80px 0;
    }

    .section-head {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-bottom: 50px;
    }

    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability {
      min-height: 340px;
    }

    .flow {
      grid-template-columns: repeat(2, 1fr);
    }

    .mode {
      grid-template-columns: 40px 1fr;
      padding: 22px 0;
    }

    .mode-description {
      grid-column: 2;
    }

    .matrix-row {
      grid-template-columns: 1fr;
    }

    .matrix-label {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .final {
      padding: 100px 22px;
    }

    footer {
      padding: 25px 16px;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
  </head>

  <body>
    <div class="page">

      <header class="header">
        <a href="/" class="brand">
          <span class="brand-mark"></span>
          BARKLY LABS
        </a>

        <div class="header-status">
          CYN-X / CAPABILITIES / SYSTEM ONLINE
        </div>
      </header>

      <!-- HERO -->

      <main>
        <section class="hero">
          <div class="eyebrow">
            CYN-X // CAPABILITY REGISTRY // 001
          </div>

          <h1>
            WHAT
            <span>CYN-X</span>
            CAN DO.
          </h1>

          <div class="hero-bottom">
            <div class="hero-index">
              [ CAPABILITIES ]<br />
              [ INTELLIGENCE ]<br />
              [ MEMORY ]<br />
              [ TOOLS ]<br />
              [ VISION ]<br />
              [ INTERACTION ]
            </div>

            <p>
              CYN-X is not a single feature. It is a collection of
              capabilities that can be combined into different systems,
              interfaces, workflows, and experiments.
            </p>
          </div>
        </section>

        <!-- CAPABILITY REGISTRY -->

        <section>
          <div class="section-inner">

            <div class="section-head">
              <div class="section-number">01 / REGISTRY</div>

              <div>
                <h2 class="section-title">CAPABILITY<br />FIELD.</h2>

                <p class="section-description">
                  The CYN-X system is designed as a collection of
                  composable capabilities. Each capability can stand
                  alone or become part of a larger intelligent workflow.
                </p>
              </div>
            </div>

            <div class="capability-grid">
              {capabilities.map((capability) => (
                <article class="capability">
                  <div class="capability-number">{capability.id}</div>

                  <div class="capability-category">
                    {capability.category}
                  </div>

                  <h3>{capability.name}</h3>

                  <p>{capability.description}</p>

                  <div class="features">
                    {capability.features.map((feature) => (
                      <span class="feature">{feature}</span>
                    ))}
                  </div>
                </article>
              ))}
            </div>

          </div>
        </section>

        <!-- MODES -->

        <section>
          <div class="section-inner">

            <div class="section-head">
              <div class="section-number">02 / MODES</div>

              <div>
                <h2 class="section-title">ONE CORE.<br />MANY WAYS.</h2>

                <p class="section-description">
                  CYN-X can expose different interaction modes while
                  sharing the same underlying system.
                </p>
              </div>
            </div>

            <div class="mode-layout">

              <div class="mode-intro">
                <h3>PERSONALITY<br />IS AN<br />INTERFACE.</h3>

                <p>
                  Different contexts require different interactions.
                  Modes allow the behavior and presentation of CYN-X
                  to change without requiring an entirely different
                  intelligence system.
                </p>
              </div>

              <div class="modes">
                {modes.map((mode) => (
                  <div class="mode">
                    <span class="mode-id">{mode[0]}</span>
                    <span class="mode-name">{mode[1]}</span>
                    <span class="mode-description">{mode[2]}</span>
                  </div>
                ))}
              </div>

            </div>
          </div>
        </section>

        <!-- INTELLIGENCE PIPELINE -->

        <section>
          <div class="section-inner">

            <div class="section-head">
              <div class="section-number">03 / PIPELINE</div>

              <div>
                <h2 class="section-title">FROM INPUT<br />TO ACTION.</h2>

                <p class="section-description">
                  CYN-X becomes useful when capabilities are connected
                  together into a flow that can understand a request,
                  reason about it, use tools, and return something
                  meaningful.
                </p>
              </div>
            </div>

            <div class="flow">

              <div class="flow-node">
                <span class="flow-number">01</span>
                <strong>INPUT</strong>
                <small>Human requests, data, files, images, devices.</small>
              </div>

              <div class="flow-node">
                <span class="flow-number">02</span>
                <strong>CONTEXT</strong>
                <small>Understand what is happening and what matters.</small>
              </div>

              <div class="flow-node">
                <span class="flow-number">03</span>
                <strong>REASON</strong>
                <small>Interpret, solve, plan, compare, explain.</small>
              </div>

              <div class="flow-node">
                <span class="flow-number">04</span>
                <strong>TOOLS</strong>
                <small>Connect intelligence to external systems.</small>
              </div>

              <div class="flow-node">
                <span class="flow-number">05</span>
                <strong>ACTION</strong>
                <small>Produce an answer, artifact, decision aid, or action.</small>
              </div>

              <div class="flow-node">
                <span class="flow-number">06</span>
                <strong>MEMORY</strong>
                <small>Carry useful context forward when appropriate.</small>
              </div>

            </div>

          </div>
        </section>

        <!-- SYSTEM MATRIX -->

        <section>
          <div class="section-inner">

            <div class="section-head">
              <div class="section-number">04 / DEPLOYMENT</div>

              <div>
                <h2 class="section-title">BUILT TO<br />EXTEND.</h2>

                <p class="section-description">
                  CYN-X is intended to operate as infrastructure for
                  larger projects rather than remaining trapped inside
                  one interface.
                </p>
              </div>
            </div>

            <div class="matrix">

              <div class="matrix-row">
                <div class="matrix-label">LOCAL MACHINE</div>
                <div class="matrix-value">
                  Run intelligence directly on a user's computer where
                  local processing is practical.
                </div>
              </div>

              <div class="matrix-row">
                <div class="matrix-label">APPLICATIONS</div>
                <div class="matrix-value">
                  Embed CYN-X capabilities into dashboards, utilities,
                  creative tools, research software, and community systems.
                </div>
              </div>

              <div class="matrix-row">
                <div class="matrix-label">VISION SYSTEMS</div>
                <div class="matrix-value">
                  Connect computer vision and visual understanding to
                  intelligent workflows.
                </div>
              </div>

              <div class="matrix-row">
                <div class="matrix-label">HARDWARE</div>
                <div class="matrix-value">
                  Create pathways toward sensors, robotics, devices,
                  and physical interfaces.
                </div>
              </div>

              <div class="matrix-row">
                <div class="matrix-label">BARKLY ECOSYSTEM</div>
                <div class="matrix-value">
                  CYN-X can become the intelligence layer behind
                  projects such as PawBoard and other Barkly Labs systems.
                </div>
              </div>

            </div>

          </div>
        </section>

        <!-- PRINCIPLES -->

        <section>
          <div class="section-inner">

            <div class="section-head">
              <div class="section-number">05 / PRINCIPLES</div>

              <div>
                <h2 class="section-title">CAPABILITY<br />WITH PURPOSE.</h2>

                <p class="section-description">
                  Capabilities are only useful when they serve the people
                  and systems they are designed for.
                </p>
              </div>
            </div>

            <div class="matrix">

              <div class="matrix-row">
                <div class="matrix-label">HUMAN FIRST</div>
