---
const layers = [
  {
    id: "01",
    name: "INTERFACE",
    description: "Where humans, applications, and devices communicate with CYN-X.",
    components: ["CHAT", "WEB UI", "VOICE", "VISION", "API"],
  },
  {
    id: "02",
    name: "ORCHESTRATION",
    description: "Coordinates context, models, tools, memory, and actions.",
    components: ["ROUTER", "CONTEXT", "TASKS", "TOOLS", "EVENTS"],
  },
  {
    id: "03",
    name: "INTELLIGENCE",
    description: "The reasoning and generation layer responsible for interpreting and solving problems.",
    components: ["MODEL", "REASONING", "PLANNING", "GENERATION"],
  },
  {
    id: "04",
    name: "MEMORY",
    description: "Provides continuity between interactions, projects, and systems.",
    components: ["SESSION", "PROJECT", "PERSISTENT", "CONTEXT"],
  },
  {
    id: "05",
    name: "SYSTEM",
    description: "The underlying runtime connecting CYN-X to machines, files, services, and hardware.",
    components: ["PYTHON", "FASTAPI", "OLLAMA", "FILES", "DEVICES"],
  },
];

const flows = [
  ["INPUT", "Human or machine input enters the system."],
  ["CONTEXT", "Relevant information is assembled."],
  ["REASON", "The intelligence layer interprets the task."],
  ["EXECUTE", "Tools or external systems are invoked."],
  ["OUTPUT", "The result is returned to the interface."],
  ["REMEMBER", "Useful context can continue forward."],
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CYN-X ARCHITECTURE // BARKLY LABS</title>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #050505;
      color: #f1f1f1;
      font-family: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
    }

    :global(a) {
      color: inherit;
      text-decoration: none;
    }

    :root {
      --bg: #050505;
      --panel: #0a0a0a;
      --panel-raised: #0f0f0f;
      --panel-hover: #131313;

      --line: rgba(255, 255, 255, 0.12);
      --strong: rgba(255, 255, 255, 0.25);

      --white: #f1f1f1;
      --muted: #a1a1a1;
      --dim: #686868;
      --faint: #444;

      --pink: #ff2f92;
      --pink-soft: rgba(255, 47, 146, 0.10);
      --pink-line: rgba(255, 47, 146, 0.42);

      --max: 1500px;
    }

    body {
      background-image:
        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* HEADER */

    .header {
      height: 64px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      background: rgba(5,5,5,.94);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(10px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      color: var(--white);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .14em;
    }

    .mark {
      width: 9px;
      height: 9px;
      border: 1px solid var(--pink);
      transform: rotate(45deg);
      box-shadow: 0 0 10px rgba(255,47,146,.25);
    }

    .header-info {
      color: var(--muted);
      font-size: 9px;
      letter-spacing: .14em;
    }

    /* DOCUMENT NAV */

    .side-nav {
      position: fixed;
      left: 0;
      top: 64px;
      bottom: 0;
      width: 190px;
      border-right: 1px solid var(--line);
      padding: 30px 20px;
      z-index: 20;
      background: rgba(5,5,5,.35);
    }

    .side-label {
      color: var(--pink);
      font-size: 8px;
      letter-spacing: .15em;
      margin-bottom: 25px;
    }

    .side-nav a {
      display: block;
      padding: 9px 0;
      color: var(--dim);
      font-size: 9px;
      letter-spacing: .08em;
      transition: color .2s ease;
    }

    .side-nav a:hover {
      color: var(--pink);
    }

    /* MAIN */

    main {
      margin-left: 190px;
    }

    section {
      border-bottom: 1px solid var(--line);
    }

    .container {
      width: min(var(--max), calc(100% - 90px));
      margin: auto;
    }

    /* ARCHITECTURE HEADER */

    .architecture-head {
      padding: 145px 0 100px;
      min-height: 78vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .document-meta {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 9px;
      letter-spacing: .13em;
    }

    .document-meta span:first-child {
      color: var(--pink);
    }

    .architecture-head h1 {
      margin: 90px 0 35px;
      font-family: Arial, Helvetica, sans-serif;
      font-size: clamp(5rem, 12vw, 12rem);
      line-height: .76;
      letter-spacing: -.075em;
      color: var(--white);
    }

    .architecture-head h1 span {
      display: block;
      color: transparent;
      -webkit-text-stroke: 1px var(--pink);
    }

    .head-description {
      max-width: 720px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.8;
    }

    /* SYSTEM MAP */

    .map-section {
      padding: 110px 0;
    }

    .section-label {
      display: flex;
      gap: 25px;
      align-items: center;
      color: var(--pink);
      font-size: 9px;
      letter-spacing: .15em;
      margin-bottom: 45px;
    }

    .section-label::after {
      content: "";
      height: 1px;
      background: var(--line);
      flex: 1;
    }

    .system-map {
      width: 100%;
      min-height: 650px;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--line);
      background:
        linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size: 55px 55px;
    }

    .connections {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }

    .connections line {
      stroke: var(--pink-line);
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
    }

    .connections circle {
      fill: var(--pink);
    }

    .map-center {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 260px;
      height: 180px;
      border: 1px solid var(--pink);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: #050505;
      z-index: 3;
      box-shadow: 0 0 35px rgba(255,47,146,.08);
    }

    .map-center strong {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 34px;
      letter-spacing: -.05em;
      color: var(--white);
    }

    .map-center span {
      margin-top: 12px;
      color: var(--pink);
      font-size: 8px;
      letter-spacing: .15em;
    }

    .map-node {
      position: absolute;
      width: 190px;
      min-height: 100px;
      border: 1px solid var(--line);
      background: rgba(5,5,5,.96);
      padding: 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 3;
      transition:
        border-color .25s ease,
        background .25s ease,
        transform .25s ease;
    }

    .map-node:hover {
      border-color: var(--pink-line);
      background: var(--pink-soft);
      transform: translateY(-3px);
    }

    .map-node strong {
      font-size: 11px;
      letter-spacing: .1em;
      color: var(--white);
    }

    .map-node:hover strong {
      color: var(--pink);
    }

    .map-node small {
      color: var(--dim);
      font-size: 8px;
      line-height: 1.6;
    }

    .node-input {
      left: 7%;
      top: 15%;
    }

    .node-memory {
      right: 7%;
      top: 15%;
    }

    .node-tools {
      left: 7%;
      bottom: 15%;
    }

    .node-output {
      right: 7%;
      bottom: 15%;
    }

    /* LAYERS */

    .layers {
      display: grid;
      grid-template-columns: 1fr;
      border-top: 1px solid var(--line);
    }

    .layer {
      display: grid;
      grid-template-columns: 90px 300px 1fr;
      min-height: 180px;
      border-bottom: 1px solid var(--line);
      transition: background .25s ease;
    }

    .layer:last-child {
      border-bottom: 0;
    }

    .layer:hover {
      background: rgba(255,47,146,.025);
    }

    .layer-id {
      padding: 28px;
      color: var(--pink);
      font-size: 10px;
      border-right: 1px solid var(--line);
    }

    .layer-name {
      padding: 28px;
      border-right: 1px solid var(--line);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 25px;
      letter-spacing: -.04em;
      color: var(--white);
    }

    .layer:hover .layer-name {
      color: var(--pink);
    }

    .layer-content {
      padding: 28px;
    }

    .layer-description {
      max-width: 620px;
      color: #999;
      font-size: 11px;
      line-height: 1.8;
    }

    .component-list {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 25px;
    }

    .component {
      padding: 7px 9px;
      border: 1px solid #303030;
      color: #999;
      font-size: 8px;
      letter-spacing: .08em;
      transition:
        color .2s ease,
        border-color .2s ease,
        background .2s ease;
    }

    .component:hover {
      color: var(--pink);
      border-color: var(--pink-line);
      background: var(--pink-soft);
    }

    /* FLOW */

    .flow {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }

    .flow-step {
      min-height: 240px;
      padding: 25px;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition:
        background .25s ease,
        border-color .25s ease;
    }

    .flow-step:hover {
      background: var(--pink-soft);
      border-color: var(--pink-line);
    }

    .flow-number {
      color: var(--pink);
      font-size: 9px;
    }

    .flow-step strong {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 21px;
      letter-spacing: -.04em;
      color: var(--white);
    }

    .flow-step:hover strong {
      color: var(--pink);
    }

    .flow-step p {
      margin: 0;
      color: var(--dim);
      font-size: 9px;
      line-height: 1.7;
    }

    /* RUNTIME */

    .runtime {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border: 1px solid var(--line);
    }

    .runtime-panel {
      min-height: 330px;
      padding: 35px;
    }

    .runtime-panel + .runtime-panel {
      border-left: 1px solid var(--line);
    }

    .runtime-panel h3 {
      margin: 0 0 30px;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 32px;
      letter-spacing: -.05em;
      color: var(--white);
    }

    .runtime-panel p {
      max-width: 500px;
      color: #888;
      font-size: 11px;
      line-height: 1.8;
    }

    .runtime-code {
      margin-top: 30px;
      padding: 20px;
      border: 1px solid var(--line);
      color: #aaa;
      font-size: 10px;
      line-height: 1.9;
      background: rgba(255,255,255,.015);
      transition:
        border-color .25s ease,
        background .25s ease,
        color .25s ease;
    }

    .runtime-code:hover {
      border-color: var(--pink-line);
      background: var(--pink-soft);
      color: var(--white);
    }

    /* FINAL */

    .final {
      min-height: 70vh;
      padding: 120px 0;
      display: flex;
      align-items: center;
    }

    .final h2 {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: clamp(4rem, 10vw, 10rem);
      line-height: .78;
      letter-spacing: -.075em;
      color: var(--white);
    }

    .final h2 span {
      display: block;
      color: transparent;
      -webkit-text-stroke: 1px var(--pink);
    }

    .final p {
      max-width: 600px;
      margin-top: 55px;
      color: #888;
      font-size: 11px;
      line-height: 1.9;
    }

    footer {
      padding: 28px;
      display: flex;
      justify-content: space-between;
      color: #555;
      font-size: 8px;
      letter-spacing: .1em;
    }

    footer span:first-child {
      color: var(--pink);
    }

    @media (max-width: 900px) {
      .side-nav {
        display: none;
      }

      main {
        margin-left: 0;
      }

      .container {
        width: calc(100% - 40px);
      }

      .system-map {
        min-height: 600px;
      }

      .map-node {
        width: 145px;
      }

      .layer {
        grid-template-columns: 60px 1fr;
      }

      .layer-content {
        grid-column: 2;
        border-top: 1px solid var(--line);
      }

      .flow {
        grid-template-columns: repeat(2, 1fr);
      }

      .runtime {
        grid-template-columns: 1fr;
      }

      .runtime-panel + .runtime-panel {
        border-left: 0;
        border-top: 1px solid var(--line);
      }
    }

    @media (max-width: 600px) {
      .header {
        padding: 0 16px;
      }

      .header-info {
        display: none;
      }

      .architecture-head {
        padding: 120px 0 70px;
      }

      .architecture-head h1 {
        font-size: 20vw;
        margin: 80px 0 45px;
      }

      .system-map {
        min-height: 560px;
      }

      .map-center {
        width: 190px;
        height: 140px;
      }

      .map-center strong {
        font-size: 25px;
      }

      .map-node {
        width: 125px;
        min-height: 85px;
        padding: 12px;
      }

      .node-input {
        left: 4%;
        top: 8%;
      }

      .node-memory {
        right: 4%;
        top: 8%;
      }

      .node-tools {
        left: 4%;
        bottom: 8%;
      }

      .node-output {
        right: 4%;
        bottom: 8%;
      }

      .layer {
        display: block;
      }

      .layer-id,
      .layer-name {
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .flow {
        grid-template-columns: 1fr;
      }

      footer {
        flex-direction: column;
        gap: 10px;
      }
    }
  </style>
</head>

<body>
  <header class="header">
    <a href="/" class="brand">
      <span class="mark"></span>
      BARKLY LABS
    </a>
    <div class="header-info">CYN-X / ARCHITECTURE / DOCUMENT 002</div>
  </header>

  <nav class="side-nav">
    <div class="side-label">DOCUMENT INDEX</div>
    <a href="#map">01 / SYSTEM MAP</a>
    <a href="#layers">02 / LAYERS</a>
    <a href="#flow">03 / DATA FLOW</a>
    <a href="#runtime">04 / RUNTIME</a>
    <a href="#principles">05 / PRINCIPLES</a>
  </nav>

  <main>
    <section>
      <div class="container architecture-head">
        <div class="document-meta">
          <span>CYN-X ARCHITECTURE</span>
          <span>DOC. 002</span>
        </div>

        <div>
          <h1>
            INSIDE
            <span>THE SYSTEM.</span>
          </h1>

          <p class="head-description">
            CYN-X is designed as a modular intelligence system.
            Models, memory, tools, interfaces, and external systems
            connect through an architecture intended to remain
            understandable, extensible, and human-controlled.
          </p>
        </div>
      </div>
    </section>

    <section id="map">
      <div class="container map-section">
        <div class="section-label">01 / SYSTEM MAP</div>

        <div class="system-map">
          <svg
            class="connections"
            viewBox="0 0 1000 650"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <line x1="165" y1="150" x2="370" y2="270" />
            <circle cx="165" cy="150" r="2" />
            <circle cx="370" cy="270" r="2" />

            <line x1="835" y1="150" x2="630" y2="270" />
            <circle cx="835" cy="150" r="2" />
            <circle cx="630" cy="270" r="2" />

            <line x1="165" y1="500" x2="370" y2="380" />
            <circle cx="165" cy="500" r="2" />
            <circle cx="370" cy="380" r="2" />

            <line x1="630" y1="380" x2="835" y2="500" />
            <circle cx="630" cy="380" r="2" />
            <circle cx="835" cy="500" r="2" />
          </svg>

          <div class="map-node node-input">
            <strong>INPUT</strong>
            <small>Humans / Applications / Devices / Data</small>
          </div>

          <div class="map-node node-memory">
            <strong>MEMORY</strong>
            <small>Session / Projects / Persistent Context</small>
          </div>

          <div class="map-node node-tools">
            <strong>TOOLS</strong>
            <small>Files / APIs / Services / Automation</small>
          </div>

          <div class="map-node node-output">
            <strong>OUTPUT</strong>
            <small>Responses / Actions / Interfaces / Artifacts</small>
          </div>

          <div class="map-center">
            <strong>CYN-X</strong>
            <span>INTELLIGENCE CORE</span>
          </div>
        </div>
      </div>
    </section>

    <section id="layers">
      <div class="container map-section">
        <div class="section-label">02 / ARCHITECTURE</div>

        <div class="layers">
          {layers.map((layer) => (
            <article class="layer">
              <div class="layer-id">{layer.id}</div>
              <div class="layer-name">{layer.name}</div>
              <div class="layer-content">
                <div class="layer-description">{layer.description}</div>

                <div class="component-list">
                  {layer.components.map((component) => (
                    <span class="component">{component}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="flow">
      <div class="container map-section">
        <div class="section-label">03 / DATA FLOW</div>

        <div class="flow">
          {flows.map((flow, index) => (
            <article class="flow-step">
              <span class="flow-number">0{index + 1}</span>
              <strong>{flow[0]}</strong>
              <p>{flow[1]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="runtime">
      <div class="container map-section">
        <div class="section-label">04 / RUNTIME</div>

        <div class="runtime">
          <div class="runtime-panel">
            <h3>LOCAL<br />INTELLIGENCE.</h3>

            <p>
              CYN-X can use local model infrastructure so intelligence
              can remain close to the machine and the person using it.
              The architecture is intentionally compatible with local
              inference systems.
            </p>

            <div class="runtime-code">
              CYN-X CORE<br />
              &nbsp;&nbsp;↓<br />
              OLLAMA<br />
              &nbsp;&nbsp;↓<br />
              LOCAL MODEL<br />
              &nbsp;&nbsp;↓<br />
              RESPONSE
            </div>
          </div>

          <div class="runtime-panel">
            <h3>SYSTEM<br />INTEGRATION.</h3>

            <p>
              CYN-X can sit between humans and external systems,
              allowing intelligence to operate through applications,
              files, APIs, devices, and future hardware.
            </p>

            <div class="runtime-code">
              INPUT<br />
              &nbsp;&nbsp;↓<br />
              CYN-X<br />
              &nbsp;&nbsp;↓<br />
              TOOL / API / FILE<br />
              &nbsp;&nbsp;↓<br />
              ACTION
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="principles">
      <div class="container map-section">
        <div class="section-label">05 / PRINCIPLES</div>

        <div class="layers">
          <div class="layer">
            <div class="layer-id">01</div>
            <div class="layer-name">MODULAR</div>
            <div class="layer-content">
              <div class="layer-description">
                Components should be replaceable, extendable, and
                understandable instead of locked into one monolithic system.
              </div>
            </div>
          </div>

          <div class="layer">
            <div class="layer-id">02</div>
            <div class="layer-name">HUMAN</div>
            <div class="layer-content">
              <div class="layer-description">
                The architecture exists to serve human goals.
                Technology should adapt to the person using it.
              </div>
            </div>
          </div>

          <div class="layer">
            <div class="layer-id">03</div>
            <div class="layer-name">EXTENSIBLE</div>
            <div class="layer-content">
              <div class="layer-description">
                CYN-X is intended to become infrastructure that other
                applications, interfaces, and experiments can build on.
              </div>
            </div>
          </div>

          <div class="layer">
            <div class="layer-id">04</div>
            <div class="layer-name">EXPERIMENTAL</div>
            <div class="layer-content">
              <div class="layer-description">
                The architecture is a living research environment.
                New models, tools, interfaces, and hardware can become
                part of the system over time.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container final">
        <div>
          <h2>
            BUILD THE
            <span>SYSTEM.</span>
          </h2>

          <p>
            CYN-X is not one application. It is an intelligence
            architecture designed to become the layer between humans,
            software, machines, and the systems they create.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <span>CYN-X // BARKLY LABS</span>
    <span>ARCHITECTURE / DOCUMENT 002 / 2026</span>
  </footer>
</body>
</html>