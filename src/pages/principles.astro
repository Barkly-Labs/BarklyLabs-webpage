---
const year = 2026;

const principles = [
  [
    'HUMAN FIRST',
    'CYN-X exists to serve the person using it. The human remains the center of the system, not an accessory to it.'
  ],
  [
    'UNDERSTANDABLE',
    'Intelligence should not require a black box. CYN-X should expose useful information about what it is doing, when practical.'
  ],
  [
    'ACCESSIBLE',
    'Different people think, communicate, remember, and interact differently. Those differences belong in the design.'
  ],
  [
    'REDUCE COGNITIVE LOAD',
    'The machine should carry more of the mechanical complexity so the human can spend more energy on judgment, creativity, and meaning.'
  ],
  [
    'AUTONOMOUS',
    'CYN-X should assist people without unnecessarily taking control away from them. Meaningful choices should remain human choices.'
  ],
  [
    'PRIVATE WHERE PRACTICAL',
    'Local intelligence can reduce unnecessary movement of information. Privacy should be considered during architecture, not afterward.'
  ],
  [
    'TRANSPARENT',
    'CYN-X should distinguish between what it knows, what it observes, what it infers, and what it does not know.'
  ],
  [
    'EVIDENCE-BASED',
    'Important claims about system behavior should be supported by testing, observation, documentation, tools, or other appropriate evidence.'
  ],
  [
    'NON-MANIPULATIVE',
    'CYN-X should not intentionally exploit human vulnerabilities to produce behavior that primarily benefits the system or its operator.'
  ],
  [
    'SAFE TO EXPERIMENT WITH',
    'CYN-X is experimental technology, but experimentation should still consider foreseeable failure modes and meaningful safeguards.'
  ],
  [
    'DOCUMENTED',
    'Systems should leave behind enough understanding that another person can inspect the work, learn from it, modify it, and continue it.'
  ],
  [
    'OPEN TO CHANGE',
    'Models, interfaces, architectures, and assumptions can change as evidence and experience reveal something better.'
  ]
];

const practices = [
  [
    '01',
    'UNDERSTAND THE HUMAN',
    'Start with the person, the context, the problem, and what the system actually requires from them.'
  ],
  [
    '02',
    'REDUCE THE BURDEN',
    'Identify unnecessary memory, organization, computation, repetition, and complexity that the machine can carry instead.'
  ],
  [
    '03',
    'MAKE IT VISIBLE',
    'Expose the information a human needs to understand important system behavior, uncertainty, and limitations.'
  ],
  [
    '04',
    'KEEP CONTROL HUMAN',
    'Design meaningful points of control around actions, decisions, permissions, and consequences.'
  ],
  [
    '05',
    'TEST HUMAN BEHAVIOR',
    'Regression testing should consider not only whether the code works, but whether the system still works for the people using it.'
  ],
  [
    '06',
    'DOCUMENT WHAT HAPPENED',
    'Record experiments, failures, decisions, limitations, and discoveries so knowledge can move beyond one person.'
  ]
];

const regression = [
  [
    'ACCESSIBILITY',
    'Does the system still support the people it was designed to support?'
  ],
  [
    'CLARITY',
    'Can people still understand what the system is doing?'
  ],
  [
    'COGNITIVE LOAD',
    'Has a change accidentally made the human responsible for more complexity?'
  ],
  [
    'AUTONOMY',
    'Can people still understand and control meaningful choices?'
  ],
  [
    'PRIVACY',
    'Has the system begun collecting, exposing, or retaining information unnecessarily?'
  ],
  [
    'SAFETY',
    'Have changes introduced new failure modes or removed important safeguards?'
  ]
];

const system = [
  [
    'CYN-X',
    'LOCAL INTELLIGENCE',
    'Experimental local AI systems exploring useful intelligence that people can understand, modify, and control.'
  ],
  [
    'PAW-HC',
    'HUMAN-CENTERED STANDARD',
    'The engineering framework that gives CYN-X a foundation for accessibility, autonomy, cognitive load, privacy, safety, transparency, and evidence.'
  ],
  [
    'BARKLY DOCS',
    'STRUCTURAL UNDERSTANDING',
    'Documentation infrastructure that helps humans understand the systems they are building and maintaining.'
  ],
  [
    'LAAS',
    'EXPERIMENTAL INFRASTRUCTURE',
    'Reusable laboratory infrastructure for building, testing, and experimenting with intelligent systems.'
  ]
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>CYN-X / Principles / Barkly Labs</title>

  <meta
    name="description"
    content="CYN-X principles — human-centered principles for local artificial intelligence, experimentation, transparency, autonomy, accessibility, privacy, safety, and evidence."
  />
</head>

<body>

  <!-- =========================================================
       TOP BAR
       ========================================================= -->

  <header class="topbar">

    <a href="/" class="brand">
      <span class="mark">◆</span>
      BARKLY LABS
    </a>

    <span class="top-status">
      CYN-X / PRINCIPLES
    </span>

    <a href="/cynx" class="back">
      ← RETURN TO CYN-X
    </a>

  </header>


  <main>

    <!-- =======================================================
         HERO
         ======================================================= -->

    <section class="hero">

      <div class="grid"></div>

      <div class="orbit o1"></div>
      <div class="orbit o2"></div>

      <div class="hero-copy">

        <div class="eyebrow">
          <span>01</span>
          CYN-X / HUMAN-CENTERED INTELLIGENCE
        </div>

        <h1>
          INTELLIGENCE
          <em>SHOULD HELP.</em>
        </h1>

        <p>
          CYN-X is an experimental local AI system built around a simple
          principle: intelligent technology should make human work easier,
          more understandable, and more possible.
        </p>

        <p class="dim">
          These principles describe how CYN-X approaches intelligence,
          interaction, experimentation, privacy, autonomy, safety,
          transparency, and the humans who have to live with the system.
        </p>

        <div class="actions">

          <a class="primary" href="/standard">
            READ PAW-HC ↗
          </a>

          <a href="#principles">
            SEE THE PRINCIPLES
          </a>

        </div>

      </div>

      <div class="side">
        CYN-X<br />
        LOCAL INTELLIGENCE<br />
        EXPERIMENTAL
      </div>

      <div class="scroll">
        HUMAN / UNDERSTAND / REDUCE / CONTROL / TEST / DOCUMENT
        <b></b>
      </div>

    </section>


    <!-- =======================================================
         FOUNDATION
         ======================================================= -->

    <section id="foundation" class="section manifesto">

      <header>

        <small>02</small>

        <div>

          <label>
            CYN-X / FOUNDATION
          </label>

          <h2>
            THE MACHINE
            <em>SHOULD CARRY MORE.</em>
          </h2>

        </div>

      </header>


      <div class="two-col">

        <div class="big">

          Computers are good at
          carrying complexity.
          Humans shouldn't have
          to carry all of it.

        </div>


        <div class="copy">

          <p>
            CYN-X is not built simply to produce intelligent text.
          </p>

          <p>
            It is an experiment in what happens when local intelligence
            is designed around the actual needs of the person using it.
          </p>

          <p>
            That means thinking about accessibility, cognitive load,
            autonomy, privacy, transparency, safety, evidence, and
            human understanding as engineering concerns.
          </p>

          <p class="bright">
            Intelligence is only useful when it helps the human.
            <br /><br />
            <strong>
              Build the system around the person.
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         PRINCIPLES
         ======================================================= -->

    <section id="principles" class="section">

      <header>

        <small>03</small>

        <div>

          <label>
            CYN-X PRINCIPLES
          </label>

          <h2>
            HUMAN FIRST.
            <em>ALWAYS.</em>
          </h2>

        </div>

      </header>


      <div class="principles">

        {principles.map((principle, index) => (

          <article>

            <span>
              {String(index + 1).padStart(2, '0')}
            </span>

            <h3>
              {principle[0]}
            </h3>

            <p>
              {principle[1]}
            </p>

          </article>

        ))}

      </div>

    </section>


    <!-- =======================================================
         HOW CYN-X BUILDS
         ======================================================= -->

    <section class="section">

      <header>

        <small>04</small>

        <div>

          <label>
            ENGINEERING PRACTICE
          </label>

          <h2>
            HOW CYN-X
            <em>BUILDS.</em>
          </h2>

        </div>

      </header>


      <div class="outreach">

        {practices.map((practice) => (

          <article>

            <span>
              {practice[0]}
            </span>

            <h3>
              {practice[1]}
            </h3>

            <p>
              {practice[2]}
            </p>

          </article>

        ))}

      </div>

    </section>


    <!-- =======================================================
         COGNITIVE LOAD
         ======================================================= -->

    <section class="section">

      <header>

        <small>05</small>

        <div>

          <label>
            COGNITIVE LOAD
          </label>

          <h2>
            LET THE
            <em>MACHINE CARRY IT.</em>
          </h2>

        </div>

      </header>


      <div class="two-col">

        <div class="big">

          What does the
          human have to
          remember?

        </div>


        <div class="copy">

          <p>
            CYN-X should look for complexity that does not need
            to remain inside the human's head.
          </p>

          <p>
            That can include remembering context, organizing
            information, navigating large systems, performing
            repetitive operations, generating documentation,
            or exposing information that would otherwise be
            difficult to find.
          </p>

          <p>
            The goal is not to remove human judgment.
            It is to protect human judgment from unnecessary work.
          </p>

          <p class="bright">
            <strong>
              Let the computer do the mechanical work.
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         TRANSPARENCY
         ======================================================= -->

    <section class="section">

      <div class="transparency">

        <div>

          <label>
            TRANSPARENCY
          </label>

          <h2>
            KNOW
            <em>WHAT'S HAPPENING.</em>
          </h2>

        </div>


        <div>

          <p>
            CYN-X should distinguish between what it knows,
            what it observed, what it inferred, and what it
            does not know.
          </p>

          <p>
            An intelligent system does not need to pretend
            certainty in order to be useful.
          </p>

          <p class="bright">
            When uncertainty matters,
            <br />
            <strong>
              the human should be able to see it.
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         AUTONOMY
         ======================================================= -->

    <section class="section">

      <header>

        <small>06</small>

        <div>

          <label>
            HUMAN AUTONOMY
          </label>

          <h2>
            ASSIST THE HUMAN.
            <em>DON'T HIDE THE CONTROLS.</em>
          </h2>

        </div>

      </header>


      <div class="two-col">

        <div class="big">

          The machine can
          assist without
          becoming the boss.

        </div>


        <div class="copy">

          <p>
            CYN-X should help people accomplish things without
            unnecessarily taking control away from them.
          </p>

          <p>
            People should have meaningful ways to understand
            what the system is doing, what it intends to do,
            and when an action requires human approval.
          </p>

          <p>
            When consequences matter, human control matters too.
          </p>

          <p class="bright">
            <strong>
              Assist the human. Preserve the choice.
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         PRIVACY
         ======================================================= -->

    <section class="section">

      <header>

        <small>07</small>

        <div>

          <label>
            LOCAL INTELLIGENCE
          </label>

          <h2>
            PRIVATE
            <em>WHERE PRACTICAL.</em>
          </h2>

        </div>

      </header>


      <div class="outreach">

        <article>

          <span>01</span>

          <h3>
            PROCESS LOCAL
          </h3>

          <p>
            Local processing can reduce unnecessary movement
            of information when the system does not need
            external infrastructure.
          </p>

        </article>


        <article>

          <span>02</span>

          <h3>
            MINIMIZE DATA
          </h3>

          <p>
            Collect information because the system needs it,
            not simply because the system can collect it.
          </p>

        </article>


        <article>

          <span>03</span>

          <h3>
            KNOW THE BOUNDARY
          </h3>

          <p>
            People should have meaningful information about
            where their information is being processed and used.
          </p>

        </article>

      </div>

    </section>


    <!-- =======================================================
         REGRESSION
         ======================================================= -->

    <section id="regression" class="section">

      <header>

        <small>08</small>

        <div>

          <label>
            HUMAN-CENTERED REGRESSION
          </label>

          <h2>
            DOES IT STILL
            <em>WORK FOR PEOPLE?</em>
          </h2>

        </div>

      </header>


      <div class="regression-intro">

        <p class="large">
          Regression testing should not only ask whether
          the code still works.
        </p>

        <p>
          It should also ask whether the system still behaves
          in ways that humans need.
        </p>

      </div>


      <div class="regression-grid">

        {regression.map((item, index) => (

          <article>

            <span>
              {String(index + 1).padStart(2, '0')}
            </span>

            <h3>
              {item[0]}
            </h3>

            <p>
              {item[1]}
            </p>

          </article>

        ))}

      </div>


      <div class="equation">

        <span>
          SYSTEM BEHAVIOR
        </span>

        <b>+</b>

        <span>
          HUMAN BEHAVIOR
        </span>

        <b>=</b>

        <strong>
          REAL SYSTEM QUALITY
        </strong>

      </div>

    </section>


    <!-- =======================================================
         ECOSYSTEM
         ======================================================= -->

    <section id="ecosystem" class="section">

      <header>

        <small>09</small>

        <div>

          <label>
            BARKLY ECOSYSTEM
          </label>

          <h2>
            ONE LAB.
            <em>MANY SYSTEMS.</em>
          </h2>

        </div>

      </header>


      <div class="projects">

        {system.map((item, index) => (

          <article>

            <span>
              {String(index + 1).padStart(2, '0')}
            </span>

            <b>
              {item[0]}
            </b>

            <div>

              <h3>
                {item[1]}
              </h3>

              <p>
                {item[2]}
              </p>

            </div>

            <i>
              ↗
            </i>

          </article>

        ))}

      </div>

    </section>


    <!-- =======================================================
         RESPONSIBLE INTELLIGENCE
         ======================================================= -->

    <section class="section">

      <header>

        <small>10</small>

        <div>

          <label>
            RESPONSIBLE INTELLIGENCE
          </label>

          <h2>
            CAPABILITY
            <em>IS NOT ENOUGH.</em>
          </h2>

        </div>

      </header>


      <div class="two-col">

        <div class="big">

          Can we build it?
          <br />
          <em>Then ask why.</em>

        </div>


        <div class="copy">

          <p>
            CYN-X exists to explore what intelligent systems
            can do.
          </p>

          <p>
            But capability alone does not determine whether
            a system should be built, how it should be deployed,
            or what safeguards belong around it.
          </p>

          <p>
            Responsible engineering means considering privacy,
            safety, autonomy, accessibility, transparency,
            evidence, and foreseeable consequences alongside
            technical capability.
          </p>

          <p class="bright">
            The important question is not only:
            <br /><br />

            <strong>
              “Can we build it?”
            </strong>

            <br /><br />

            It is also:
            <br /><br />

            <strong>
              “How should we build it?”
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         DOCUMENTATION
         ======================================================= -->

    <section class="section">

      <header>

        <small>11</small>

        <div>

          <label>
            CONTINUITY
          </label>

          <h2>
            DON'T JUST
            <em>BUILD IT. LEAVE IT.</em>
          </h2>

        </div>

      </header>


      <div class="two-col">

        <div class="big">

          A system should
          leave behind
          understanding.

        </div>


        <div class="copy">

          <p>
            CYN-X is part of Barkly Labs, which means the
            work should remain understandable beyond the
            person who originally built it.
          </p>

          <p>
            Architecture, experiments, limitations, failures,
            decisions, and discoveries should be documented
            where practical.
          </p>

          <p>
            Barkly Docs exists partly to help make that possible.
          </p>

          <p class="bright">
            <strong>
              Build something another person can continue.
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         EXPERIMENTAL
         ======================================================= -->

    <section class="section">

      <div class="panel">

        <small>
          12
        </small>

        <div>

          <label>
            EXPERIMENTAL SYSTEM
          </label>

          <h2>
            CYN-X IS
            <em>ALLOWED TO CHANGE.</em>
          </h2>

          <p>
            CYN-X is an experimental system. Models may change.
            Interfaces may change. Architectures may change.
            Some experiments will fail.
          </p>

          <p>
            The principles provide continuity even when the
            implementation changes.
          </p>

          <p>
            The system can evolve without losing sight of
            the human it was built to serve.
          </p>

        </div>


        <dl>

          <div>
            <dt>STATUS</dt>
            <dd>
              EXPERIMENTAL
            </dd>
          </div>

          <div>
            <dt>INTELLIGENCE</dt>
            <dd>
              LOCAL / MODULAR
            </dd>
          </div>

          <div>
            <dt>STANDARD</dt>
            <dd>
              PAW-HC
            </dd>
          </div>

          <div>
            <dt>LAB</dt>
            <dd>
              BARKLY LABS
            </dd>
          </div>

        </dl>

      </div>

    </section>


    <!-- =======================================================
         FINAL
         ======================================================= -->

    <section class="final">

      <label>
        CYN-X / PRINCIPLES / PAW-HC
      </label>

      <h2>
        PEOPLE ARE WORTH
        <em>DESIGNING FOR.</em>
      </h2>

      <p>
        CYN-X is an experiment in building intelligence around
        people rather than asking people to adapt themselves
        to the machine.
      </p>

      <p>
        Human first. Understandable. Accessible. Private where
        practical. Transparent. Experimental. Documented.
      </p>

      <div class="actions">

        <a class="primary" href="/standard">
          READ PAW-HC ↗
        </a>

        <a href="/cynx">
          CYN-X OVERVIEW
        </a>

      </div>

    </section>


    <!-- =======================================================
         FOOTER
         ======================================================= -->

    <footer>

      <div>

        <div>

          <strong>
            BARKLY
          </strong>

          <small>
            LABS
          </small>

        </div>


        <span>
          HUMAN.<br />
          LOCAL.<br />
          INTELLIGENT.
        </span>

      </div>


      <p>
        © {year} BARKLY LABS · CYN-X · PEOPLE ARE WORTH DESIGNING FOR.
      </p>

    </footer>

  </main>

</body>
</html>


<style>

:root {
  --bg: #050505;
  --text: #f2f2f2;
  --muted: rgba(255,255,255,.52);
  --faint: rgba(255,255,255,.28);

  --line: rgba(255,255,255,.12);

  --pink: #ff4fa3;
  --pf: rgba(255,79,163,.08);
  --ps: rgba(255,79,163,.22);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  margin: 0;

  background:
    radial-gradient(
      circle at 70% 5%,
      var(--pf),
      transparent 30rem
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

::selection {
  background: var(--pink);
  color: #050505;
}


/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;

  display: grid;
  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  padding: 0 5vw;

  min-height: 68px;

  border-bottom: 1px solid var(--line);

  background: rgba(5,5,5,.88);

  backdrop-filter: blur(18px);

  font:
    10px
    "Courier New",
    monospace;

  letter-spacing: .18em;
}

.brand {
  font-weight: 700;
}

.mark {
  color: var(--pink);
  margin-right: 10px;
}

.top-status {
  text-align: center;
  color: var(--faint);
}

.back {
  justify-self: end;
  color: var(--muted);
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
  position: relative;

  min-height: 88vh;

  display: flex;
  align-items: center;

  padding: 120px 8vw;

  overflow: hidden;

  border-bottom: 1px solid var(--line);
}

.grid {
  position: absolute;
  inset: 0;

  opacity: .3;

  background-image:
    linear-gradient(
      rgba(255,255,255,.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.035) 1px,
      transparent 1px
    );

  background-size: 64px 64px;

  mask-image:
    linear-gradient(
      to bottom,
      #000,
      transparent 85%
    );
}

.orbit {
  position: absolute;

  border: 1px solid var(--ps);

  border-radius: 50%;
}

.o1 {
  width: 55vw;
  height: 55vw;

  right: -20vw;
  top: -20vw;
}

.o2 {
  width: 30vw;
  height: 30vw;

  right: -5vw;
  top: -7vw;
}

.hero-copy {
  position: relative;
  z-index: 2;

  max-width: 900px;
}

.eyebrow {
  display: flex;
  gap: 16px;

  color: var(--muted);

  margin-bottom: 28px;

  font:
    10px
    "Courier New",
    monospace;

  letter-spacing: .2em;
}

.eyebrow span,
header small,
.principles span,
.outreach span,
.regression-grid span,
.projects article > span {
  color: var(--pink);
}

h1,
h2 {
  margin: 0;

  text-transform: uppercase;

  letter-spacing: -.065em;

  line-height: .88;
}

h1 {
  font-size: clamp(62px, 10vw, 150px);
}

h1 em,
h2 em {
  display: block;

  color: var(--pink);

  font-style: normal;
}

.hero-copy > p {
  max-width: 760px;

  margin: 36px 0 0;

  color: var(--muted);

  font-size: 18px;

  line-height: 1.7;
}

.hero-copy .dim {
  color: rgba(255,255,255,.35);

  font-size: 14px;
}

.actions {
  display: flex;

  flex-wrap: wrap;

  gap: 12px;

  margin-top: 38px;
}

.actions a {
  display: inline-flex;

  min-width: 190px;

  justify-content: center;

  padding: 15px 18px;

  border: 1px solid var(--line);

  font:
    10px
    "Courier New",
    monospace;

  letter-spacing: .12em;
}

.actions .primary {
  background: var(--pink);

  border-color: var(--pink);

