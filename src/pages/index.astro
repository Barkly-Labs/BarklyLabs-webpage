      </section>

      <!-- =======================================================
           CYN-X
           ======================================================= -->

      <section id="systems" class="section cynx-section">
        <div class="cynx-glow"></div>

        <div class="section-heading">
          <div class="section-number">03</div>

          <div>
            <span class="section-kicker">FLAGSHIP SYSTEM</span>
            <h2>
              CYN-X
              <span>CORE.</span>
            </h2>
          </div>
        </div>

        <div class="cynx-layout">
          <div class="cynx-copy">
            <div class="system-label">
              <span class="status-dot"></span>
              INTELLIGENT ECOSYSTEM
