              modify, and build upon.
            </p>

            <a href="/docs" class="text-link">
              EXPLORE THE BARKLY DOCS
              <span>→</span>
            </a>
          </div>

          <div class="docs-diagram" aria-hidden="true">
            <div class="docs-line docs-line-one"></div>
            <div class="docs-line docs-line-two"></div>
            <div class="docs-line docs-line-three"></div>

            <div class="docs-core">
