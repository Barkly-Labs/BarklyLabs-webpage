---
const year = 2026;

const systems = [
  {
    number: "01",
    title: "CYN-X",
    category: "INTELLIGENT SYSTEMS",
    description:
      "A connecting layer between intelligent systems, interfaces, services, software, and physical devices.",
    tags: ["AI", "LOCAL INFERENCE", "HUMAN-AI"],
  },
  {
    number: "02",
    title: "VISION",
    category: "COMPUTER VISION",
    description:
      "Computer vision built around transparency, privacy, responsible use, and human oversight.",
    tags: ["VISION", "PRIVACY", "OVERSIGHT"],
  },
  {
    number: "03",
    title: "PAWBOARD",
    category: " SOC BOARD",
    description:
      "A modular social-computing platform that turns existing devices into connected nodes within one human-centered system.",
    tags: ["Recycled", "ACCESSIBILITY", "SYSTEMS"],
  },
  {
    number: "04",
    title: "EMBEDDED",
    category: "HARDWARE",
    description:
      "Experiments connecting software, sensors, devices, edge computing, and physical systems.",
    tags: ["IOT", "SENSORS", "EDGE"],
  },
];

const disciplines = [
  "AI",
  "SOFTWARE ENGINEERING",
  "EMBEDDED SYSTEMS",
  "COMPUTER VISION",
  "CREATIVE TECHNOLOGY",
  "HARDWARE & ROBOTICS",
  "MEDIA & STREAMING",
  "COMMUNITY & EDUCATION",
];

const lifecycle = [
  ["01", "IDEA", "A problem, question, experiment, or creative concept."],
  ["02", "RESEARCH", "Understand the problem, constraints, people, and possibilities."],
  ["03", "EXPERIMENT", "Try ideas quickly and learn from what happens."],
  ["04", "PROTOTYPE", "Turn an idea into something people can actually interact with."],
  ["05", "COMMUNITY TESTING", "Learn from real people and real use."],
  ["06", "ENGINEERING", "Build the systems, infrastructure, hardware, and software."],
  ["07", "RELEASE", "Put the work into the world and keep learning from it."],
];

const principles = [
  {
    title: "HUMANS ARE NOT MACHINES",
    text: "Technology should support people rather than forcing people to adapt themselves to machines.",
  },
  {
    title: "ACCESSIBILITY IS FOUNDATIONAL",
    text: "Accessibility is part of the technology itself, not something added after the fact.",
  },
  {
    title: "MAKE IT UNDERSTANDABLE",
    text: "Complex systems should remain understandable enough for people to use, question, and improve them.",
  },
  {
    title: "EXPAND HUMAN CAPABILITY",
    text: "Technology should expand what people can create and accomplish, not replace human value.",
  },
];

const ethics = [
  "PRIVACY",
  "SECURITY",
  "CONSENT",
  "ACCESSIBILITY",
  "TRANSPARENCY",
  "RESPONSIBLE AI",
  "HUMAN OVERSIGHT",
  "DATA MINIMIZATION",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>BARKLY LABS — Technology Should Adapt to Humans</title>

    <meta
      name="description"
      content="Barkly Labs is a human-centered creative technology laboratory exploring AI, software, hardware, robotics, computer vision, creative technology, education, and community."
    />

    <meta
      name="theme-color"
      content="#050505"
    />
  </head>

  <body>
    <!-- =========================================================
         CINEMATIC INTRO
         ========================================================= -->

    <section id="intro" aria-label="Barkly Labs introduction">
      <div class="intro-grid"></div>
      <div class="scanlines"></div>
      <div class="intro-noise"></div>

      <div class="intro-content">
        <div class="boot">
          <span>[ BARKLY SYSTEM INITIALIZING ]</span>
          <span>LOADING HUMAN-CENTERED TECHNOLOGY...</span>
          <span>ACCESSIBILITY............... OK</span>
          <span>CREATIVE SYSTEMS............ OK</span>
          <span>COMMUNITY................... OK</span>
          <span>DETROIT..................... ONLINE</span>
        </div>

        <div class="intro-mark">
          <div class="slice slice-a">BARKLY</div>
          <div class="slice slice-b">BARKLY</div>
          <div class="slice slice-c">BARKLY</div>
          <div class="slice slice-main">BARKLY</div>
        </div>

        <div class="intro-labs">LABS</div>

        <div class="intro-welcome">
          <span>WELCOME TO</span>
          <strong>BARKLY LABS</strong>
        </div>

        <p class="intro-tagline">
          TECHNOLOGY SHOULD ADAPT TO HUMANS.
        </p>

        <button id="enter" type="button">
          ENTER THE LAB
          <span>→</span>
        </button>
      </div>
    </section>

    <!-- =========================================================
         MAIN SITE
         ========================================================= -->

    <main id="site">
      <!-- NAVIGATION -->

      <nav class="nav">
        <a href="/" class="brand" aria-label="Barkly Labs home">
          <span class="brand-symbol">◆</span>
          <span>BARKLY LABS</span>
        </a>

        <div class="nav-links">
          <a href="#principles">PHILOSOPHY</a>
          <a href="#systems">SYSTEMS</a>
          <a href="#lab">THE LAB</a>
          <a href="#process">PROCESS</a>
          <a href="#community">COMMUNITY</a>
          <a href="#detroit">DETROIT</a>
        </div>

        <a href="#about" class="nav-status">
          <span class="status-dot"></span>
          HUMAN-FIRST
        </a>
      </nav>

      <!-- =======================================================
           HERO
           ======================================================= -->

      <section class="hero">
        <div class="hero-background">
          <div class="hero-orbit orbit-one"></div>
          <div class="hero-orbit orbit-two"></div>
          <div class="hero-orbit orbit-three"></div>
        </div>

        <div class="hero-content">
          <div class="eyebrow">
            <span>01</span>
            HUMAN-CENTERED CREATIVE TECHNOLOGY
