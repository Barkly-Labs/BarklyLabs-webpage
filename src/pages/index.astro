     SLICING LOGO
     ================================================== */

  .barkly-logo {

    position: relative;

    font-family: Arial, sans-serif;

    font-size:
      clamp(70px, 16vw, 200px);

    font-weight: 950;

    line-height: .8;

    letter-spacing: -10px;
  }


  .logo-slice {

    color: white;

    text-shadow:
      0 0 20px rgba(168,85,247,.8),
      0 0 80px rgba(168,85,247,.35);
  }


  .logo-top {

    clip-path:
      inset(0 0 51% 0);

    animation:
      topSlice 1.3s
      cubic-bezier(.16,1,.3,1)
      forwards;
  }


  .logo-bottom {

    position: absolute;

    inset: 0;

    clip-path:
      inset(51% 0 0 0);

    color: #c084fc;

    transform: translateX(-20px);

    animation:
      bottomSlice 1.3s
      cubic-bezier(.16,1,.3,1)
      forwards;
  }


  @keyframes topSlice {

    0% {
      transform: translateX(-120vw);
      opacity: 0;
    }

    45% {
      transform: translateX(40px);
    }

    70% {
      transform: translateX(-8px);
    }

    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }


  @keyframes bottomSlice {

    0% {
      transform: translateX(120vw);
      opacity: 0;
    }

    45% {
      transform: translateX(-40px);
    }

    70% {
      transform: translateX(0);
