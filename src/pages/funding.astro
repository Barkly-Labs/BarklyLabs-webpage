---
const year = 2026;

const funding = [
  {
    n: '01',
    title: 'RESEARCH & DEVELOPMENT',
    tag: 'BUILD',
    share: '30%',
    text: 'Support the experiments that turn questions into working systems while keeping people at the center of the process.',
    items: [
      'CYN-X intelligent systems',
      'Barkly Docs & developer infrastructure',
      'PawBoard / experimental computing',
      'Human-centered interface research',
      'Prototyping, testing, and iteration'
    ]
  },
  {
    n: '02',
    title: 'THE PHYSICAL LAB',
    tag: 'SPACE',
    share: '25%',
    text: 'Create a real Barkly Labs environment where software, hardware, research, creativity, and community work can exist together.',
    items: [
      'Rent, utilities, and facility costs',
      'Workbenches and safe build areas',
      'Networking and local computing',
      'Storage and workshop organization',
      'Accessible human-centered workspace design'
    ]
  },
  {
    n: '03',
    title: 'HARDWARE & COMPUTING',
    tag: 'EQUIPMENT',
    share: '15%',
    text: 'Give the lab the physical tools required to investigate computing beyond the screen.',
    items: [
      'Development boards and embedded systems',
      'AI / GPU / NPU / accelerator hardware',
      'Test equipment and electronics tools',
      'Reclaimed-device experimentation',
      'Servers and local compute'
    ]
  },
  {
    n: '04',
    title: 'OUTREACH & EDUCATION',
    tag: 'COMMUNITY',
    share: '15%',
    text: 'Turn laboratory work into things people can understand, learn from, participate in, remix, and build upon.',
    items: [
      'Open documentation and tutorials',
      'Community workshops',
      'Builder and creator programs',
      'Educational demonstrations',
      'Public research notes and releases'
    ]
  },
  {
    n: '05',
    title: 'OPEN INFRASTRUCTURE',
    tag: 'SHARE',
    share: '10%',
    text: 'Keep Barkly technology, repositories, documentation, websites, and services available and maintainable.',
    items: [
      'Hosting and domains',
      'Open-source infrastructure',
      'CI / testing systems',
      'Documentation publishing',
      'Backups and project continuity'
    ]
  },
  {
    n: '06',
    title: 'OPERATIONS',
    tag: 'SUSTAIN',
    share: '5%',
    text: 'Support the boring-but-important infrastructure that allows the work to continue responsibly.',
    items: [
      'Accounting and organizational services',
      'Insurance and compliance',
      'Administrative tools',
      'Basic supplies',
      'Planning and reporting'
    ]
  }
];

const projects = [
  [
    'CYN-X',
    'HUMAN-CENTERED INTELLIGENT SYSTEMS',
    'Local AI, personality systems, tools, vision, interfaces, and experiments exploring how intelligent computers can work with people.'
  ],
  [
    'BARKLY DOCS',
    'MAKE SOFTWARE UNDERSTANDABLE',
    'Static project analysis that turns complex repositories into structured, human-oriented documentation and system knowledge.'
  ],
  [
    'PAWBOARD',
    'EXPERIMENTAL COMPUTING HARDWARE',
    'A computing platform exploring how reclaimed mobile hardware and modern accelerators can become flexible, open computer systems.'
  ],
  [
    'COMMUNITY',
    'TECHNOLOGY PEOPLE CAN PARTICIPATE IN',
    'Workshops, educational material, open experiments, community projects, and resources for builders, artists, engineers, and curious humans.'
  ]
];

const principles = [
  [
    'HUMAN FIRST',
    'Technology should serve the person using it.'
  ],
  [
    'UNDERSTANDABLE',
    'People should be able to understand what a system is doing.'
  ],
  [
    'ACCESSIBLE',
    'Accessibility belongs in the design process from the beginning.'
  ],
  [
    'OPEN',
    'Whenever practical, share the knowledge, tools, and experiments.'
  ],
  [
    'EXPERIMENTAL',
    'Prototype, test, document what happened, and improve.'
  ],
  [
    'RESPECTFUL',
    'Protect human autonomy, privacy, creativity, and choice.'
  ]
];

const practices = [
  [
    '01',
    'UNDERSTAND',
    'Start by understanding the people, context, constraints, and actual problem.'
  ],
  [
    '02',
    'DESIGN',
    'Design systems around human needs rather than forcing humans to adapt to the system.'
  ],
  [
    '03',
    'BUILD',
    'Turn ideas into working prototypes that people can actually interact with.'
  ],
  [
    '04',
    'TEST',
    'Observe what works, what fails, what is confusing, and what creates unnecessary friction.'
  ],
  [
    '05',
    'DOCUMENT',
    'Make the reasoning, architecture, experiments, and lessons understandable to others.'
  ],
  [
    '06',
    'IMPROVE',
    'Use what was learned to change the system and repeat the process.'
  ]
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Barkly Labs / Barkly Standard</title>

  <meta
    name="description"
    content="Barkly Labs — building human-centered technology through research, experimentation, documentation, accessibility, openness, and responsible engineering."
  />
</head>

<body>

  <!-- =========================================================
       TOP BAR
       ========================================================= -->

  <header class="topbar">

    <a href="/" class="brand">
      <span class="mark">◆</span>
      BARKLY LABS
    </a>

    <span class="top-status">
      STANDARD / HUMAN-CENTERED ENGINEERING
    </span>

    <a href="/" class="back">
      ← RETURN TO LABS
    </a>

  </header>


  <main>

    <!-- =======================================================
         HERO
         ======================================================= -->

    <section class="hero">

      <div class="grid"></div>

      <div class="orbit o1"></div>
      <div class="orbit o2"></div>

      <div class="hero-copy">

        <div class="eyebrow">
          <span>01</span>
          PEOPLE ARE WORTH DESIGNING FOR
        </div>

        <h1>
          TECHNOLOGY
          <em>SHOULD HELP.</em>
        </h1>

        <p>
          Barkly Labs builds software, AI, hardware, creative technology,
          research systems, and infrastructure around the people who have
          to use them.
        </p>

        <p class="dim">
          The Barkly Standard exists to make that approach explicit:
          understand the human, build the system, test it with reality,
          document what happened, and improve.
        </p>

        <div class="actions">

          <a class="primary" href="#standard">
            READ THE STANDARD ↓
          </a>

          <a href="#principles">
            SEE THE PRINCIPLES
          </a>

        </div>

      </div>

      <div class="side">
        DETROIT, MICHIGAN<br />
        HUMAN-CENTERED<br />
        EXPERIMENTAL
      </div>

      <div class="scroll">
        UNDERSTAND / DESIGN / BUILD / TEST / DOCUMENT / IMPROVE
        <b></b>
      </div>

    </section>


    <!-- =======================================================
         STANDARD INTRODUCTION
         ======================================================= -->

    <section id="standard" class="section manifesto">

      <header>

        <small>02</small>

        <div>

          <label>
            BARKLY STANDARD / PAW-HC
          </label>

          <h2>
            PEOPLE ARE WORTH
            <em>DESIGNING FOR.</em>
          </h2>

        </div>

      </header>


      <div class="two-col">

        <div class="big">

          Technology should make
          human life more possible,
          not more difficult.

        </div>


        <div class="copy">

          <p>
            The Barkly Standard is the design language underneath
            Barkly Labs.
          </p>

          <p>
            It asks a simple question before technical capability,
            architecture, optimization, or novelty:
            <strong>
              what does this system mean for the person using it?
            </strong>
          </p>

          <p>
            That means accessibility, understanding, autonomy,
            privacy, safety, creativity, and human participation
            are considered as part of engineering rather than
            treated as things to add afterward.
          </p>

          <p class="bright">
            Technology can be powerful without becoming hostile
            to the people it is supposed to help.
            <br /><br />
            <strong>
              Build the system around the human.
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         PRINCIPLES
         ======================================================= -->

    <section id="principles" class="section">

      <header>

        <small>03</small>

        <div>

          <label>
            THE FOUNDATION
          </label>

          <h2>
            HUMAN FIRST.
            <em>ALWAYS.</em>
          </h2>

        </div>

      </header>


      <div class="principles">

        {principles.map((principle, index) => (

          <article>

            <span>
              0{index + 1}
            </span>

            <h3>
              {principle[0]}
            </h3>

            <p>
              {principle[1]}
            </p>

          </article>

        ))}

      </div>

    </section>


    <!-- =======================================================
         HOW WE BUILD
         ======================================================= -->

    <section class="section">

      <header>

        <small>04</small>

        <div>

          <label>
            ENGINEERING PRACTICE
          </label>

          <h2>
            HOW WE
            <em>BUILD.</em>
          </h2>

        </div>

      </header>


      <div class="outreach">

        {practices.map((practice) => (

          <article>

            <span>
              {practice[0]}
            </span>

            <h3>
              {practice[1]}
            </h3>

            <p>
              {practice[2]}
            </p>

          </article>

        ))}

      </div>

    </section>


    <!-- =======================================================
         RESOURCES
         ======================================================= -->

    <section id="funding" class="section">

      <header>

        <small>05</small>

        <div>

          <label>
            RESOURCE MODEL
          </label>

          <h2>
            SUPPORT THE WORK.
            <em>KEEP THE HUMAN.</em>
          </h2>

        </div>

      </header>


      <div class="actions">

        <a class="primary" href="/financial">
          SEE THE RESOURCE BREAKDOWN
        </a>

      </div>


      <div class="note">

        <b>[ i ]</b>

        <p>
          These percentages are an illustrative planning model,
          not a promise of exact spending. Actual allocations
          depend on the funding source, project requirements,
          organizational needs, and applicable restrictions.
          Public reporting should explain how funded work was
          actually used.
        </p>

      </div>


      <div class="funding-grid">

        {funding.map((area) => (

          <article class="fund-card">

            <div class="card-top">

              <span>
                {area.n}
              </span>

              <small>
                {area.tag}
              </small>

            </div>


            <strong class="share">
              {area.share}
            </strong>


            <h3>
              {area.title}
            </h3>


            <p>
              {area.text}
            </p>


            <ul>

              {area.items.map((item) => (

                <li>
                  → {item}
                </li>

              ))}

            </ul>

          </article>

        ))}

      </div>

    </section>


    <!-- =======================================================
         RESEARCH SYSTEMS
         ======================================================= -->

    <section id="projects" class="section">

      <header>

        <small>06</small>

        <div>

          <label>
            BARKLY ECOSYSTEM
          </label>

          <h2>
            ONE LAB.
            <em>MANY SYSTEMS.</em>
          </h2>

        </div>

      </header>


      <div class="projects">

        {projects.map((project, index) => (

          <article>

            <span>
              0{index + 1}
            </span>

            <b>
              {project[0]}
            </b>

            <div>

              <h3>
                {project[1]}
              </h3>

              <p>
                {project[2]}
              </p>

            </div>

            <i>
              ↗
            </i>

          </article>

        ))}

      </div>

    </section>


    <!-- =======================================================
         PHYSICAL LAB
         ======================================================= -->

    <section class="section building">

      <div class="panel">

        <small>
          07
        </small>

        <div>

          <label>
            THE PHYSICAL LAB
          </label>

          <h2>
            FROM A
            <em>DESK</em>
            TO A
            <em>LABORATORY.</em>
          </h2>

          <p>
            Barkly Labs is currently being built through software,
            experiments, documentation, and hardware prototypes.
            A dedicated physical environment would allow those
            systems to exist together.
          </p>

          <p>
            The goal is not a polished corporate office.
            It is a working laboratory: benches, computers,
            electronics, local infrastructure, research space,
            documentation stations, creative space, and room
            for people to experiment.
          </p>

        </div>


        <dl>

          <div>
            <dt>SPACE</dt>
            <dd>
              WORKSHOP + RESEARCH
            </dd>
          </div>

          <div>
            <dt>COMPUTE</dt>
            <dd>
              LOCAL / EDGE / AI
            </dd>
          </div>

          <div>
            <dt>HARDWARE</dt>
            <dd>
              BUILD / TEST / REPAIR
            </dd>
          </div>

          <div>
            <dt>PEOPLE</dt>
            <dd>
              LEARN / COLLABORATE
            </dd>
          </div>

        </dl>

      </div>

    </section>


    <!-- =======================================================
         OPENNESS
         ======================================================= -->

    <section class="section">

      <header>

        <small>08</small>

        <div>

          <label>
            OPEN PRACTICE
          </label>

          <h2>
            THE LAB SHOULD
            <em>OPEN OUTWARD.</em>
          </h2>

        </div>

      </header>


      <div class="outreach">

        <article>

          <span>01</span>

          <h3>
            DOCUMENTATION
          </h3>

          <p>
            Make systems understandable through public documentation,
            architecture notes, experiments, tutorials, and project
            history.
          </p>

        </article>


        <article>

          <span>02</span>

          <h3>
            PARTICIPATION
          </h3>

          <p>
            Create practical ways for builders, artists, engineers,
            students, creators, and curious people to participate.
          </p>

        </article>


        <article>

          <span>03</span>

          <h3>
            EXPERIMENTS
          </h3>

          <p>
            Share prototypes and research while making it clear what
            is experimental, incomplete, proven, or still being learned.
          </p>

        </article>


        <article>

          <span>04</span>

          <h3>
            KNOWLEDGE
          </h3>

          <p>
            Turn individual experiments into knowledge that other
            people can question, modify, reuse, and build upon.
          </p>

        </article>

      </div>

    </section>


    <!-- =======================================================
         RESPONSIBLE TECHNOLOGY
         ======================================================= -->

    <section class="section">

      <header>

        <small>09</small>

        <div>

          <label>
            RESPONSIBLE TECHNOLOGY
          </label>

          <h2>
            POWER WITH
            <em>RESPONSIBILITY.</em>
          </h2>

        </div>

      </header>


      <div class="two-col">

        <div class="big">

          Capability is not
          the same thing as
          responsibility.

        </div>


        <div class="copy">

          <p>
            Barkly Labs treats responsible technology as part
            of the engineering process.
          </p>

          <p>
            Privacy, security, consent, accessibility,
            transparency, human oversight, responsible AI,
            data minimization, creator ownership, and human
            autonomy should be considered while systems are
            being designed.
          </p>

          <p class="bright">
            The question is not only:
            <br />
            <strong>
              “Can we build it?”
            </strong>
          </p>

          <p class="bright">
            It is also:
            <br />
            <strong>
              “Should we build it this way?”
            </strong>
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         ACCOUNTABILITY
         ======================================================= -->

    <section class="section">

      <div class="transparency">

        <div>

          <label>
            ACCOUNTABILITY
          </label>

          <h2>
            SHOW THE
            <em>WORK.</em>
          </h2>

        </div>


        <div>

          <p>
            Barkly Labs wants its work to be understandable,
            including the parts that are unfinished.
          </p>

          <p>
            Documentation is part of accountability. When
            appropriate, the lab should publish project goals,
            architecture, milestones, experiments, research
            outputs, and explanations of what changed.
          </p>

          <p class="bright">
            If something is experimental, say so.
            <br />
            If something failed, document it.
            <br />
            If something worked, share what was learned.
          </p>

        </div>

      </div>

    </section>


    <!-- =======================================================
         FINAL
         ======================================================= -->

    <section class="final">

      <label>
        THE STANDARD / THE LAB / THE FUTURE
      </label>

      <h2>
        PEOPLE ARE WORTH
        <em>DESIGNING FOR.</em>
      </h2>

      <p>
        Barkly Labs is being built one experiment at a time.
        The Standard gives that work a foundation: understand
        people, build useful systems, document what happens,
        share what can be shared, and keep improving.
      </p>

      <div class="actions">

        <a class="primary" href="/standard">
          READ THE BARKLY STANDARD ↗
        </a>

        <a href="/about">
          ABOUT BARKLY LABS
        </a>

      </div>

    </section>


    <!-- =======================================================
         FOOTER
         ======================================================= -->

    <footer>

      <div>

        <div>

          <strong>
            BARKLY
          </strong>

          <small>
            LABS
          </small>

        </div>


        <span>
          UNDERSTAND.<br />
          BUILD.<br />
          IMPROVE.
        </span>

      </div>


      <p>
        © {year} BARKLY LABS · DETROIT, MICHIGAN ·
        PEOPLE ARE WORTH DESIGNING FOR.
      </p>

    </footer>

  </main>

</body>
</html>


<style>

:root {
  --bg: #050505;
  --text: #f2f2f2;
  --muted: rgba(255,255,255,.52);
  --faint: rgba(255,255,255,.28);

  --line: rgba(255,255,255,.12);

  --pink: #ff4fa3;
  --pf: rgba(255,79,163,.08);
  --ps: rgba(255,79,163,.22);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  margin: 0;
  background:
    radial-gradient(
      circle at 70% 5%,
      var(--pf),
      transparent 30rem
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

::selection {
  background: var(--pink);
  color: #050505;
}


/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;

  display: grid;
  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  padding: 0 5vw;

  min-height: 68px;

  border-bottom: 1px solid var(--line);

  background: rgba(5,5,5,.88);

  backdrop-filter: blur(18px);

  font:
    10px
    "Courier New",
    monospace;

  letter-spacing: .18em;
}

.brand {
  font-weight: 700;
}

.mark {
  color: var(--pink);
  margin-right: 10px;
}

.top-status {
  text-align: center;
  color: var(--faint);
}

.back {
  justify-self: end;
  color: var(--muted);
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
  position: relative;

  min-height: 88vh;

  display: flex;
  align-items: center;

  padding: 120px 8vw;

  overflow: hidden;

  border-bottom: 1px solid var(--line);
}

.grid {
  position: absolute;
  inset: 0;

  opacity: .3;

  background-image:
    linear-gradient(
      rgba(255,255,255,.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.035) 1px,
      transparent 1px
    );

  background-size: 64px 64px;

  mask-image:
    linear-gradient(
      to bottom,
      #000,
      transparent 85%
    );
}

.orbit {
  position: absolute;

  border: 1px solid var(--ps);

  border-radius: 50%;
}

.o1 {
  width: 55vw;
  height: 55vw;

  right: -20vw;
  top: -20vw;
}

.o2 {
  width: 30vw;
  height: 30vw;

  right: -5vw;
  top: -7vw;
}

.hero-copy {
  position: relative;
  z-index: 2;

  max-width: 900px;
}

.eyebrow {
  display: flex;
  gap: 16px;

  color: var(--muted);

  margin-bottom: 28px;

  font:
    10px
    "Courier New",
    monospace;

  letter-spacing: .2em;
}

.eyebrow span,
header small,
.fund-card .card-top span,
.projects article > span,
.outreach span,
.principles span {
  color: var(--pink);
}

h1,
h2 {
  margin: 0;

  text-transform: uppercase;

  letter-spacing: -.065em;

  line-height: .88;
}

h1 {
  font-size: clamp(62px, 10vw, 150px);
}

h1 em,
h2 em {
  display: block;

  color: var(--pink);

  font-style: normal;
}

.hero-copy > p {
  max-width: 760px;

  margin: 36px 0 0;

  color: var(--muted);

  font-size: 18px;

  line-height: 1.7;
}

.hero-copy .dim {
  color: rgba(255,255,255,.35);

  font-size: 14px;
}

.actions {
  display: flex;

  flex-wrap: wrap;

  gap: 12px;

  margin-top: 38px;
}

.actions a {
  display: inline-flex;

  min-width: 190px;

  justify-content: center;

  padding: 15px 18px;

  border: 1px solid var(--line);

  font:
    10px
    "Courier New",
    monospace;

  letter-spacing: .12em;
}

.actions .primary {
  background: var(--pink);

  border-color: var(--pink);

  color: #050505;

  font-weight: 700;
}

.side {
  position: absolute;

  right: 4vw;
  top: 50%;

  transform:
    rotate(90deg)
    translateX(50%);

  transform-origin:
    right
    center;

  color: rgba(255,255,255,.25);

  font:
    8px/2
    "Courier New",
    monospace;

  letter-spacing: .18em;
}

.scroll {
  position: absolute;

  bottom: 28px;

  left: 8vw;
  right: 8vw;

  color: var(--faint);

  font:
    8px
    "Courier New",
    monospace;

  letter-spacing: .18em;
}

.scroll b {
  display: inline-block;

  width: 100px;
  height: 1px;

  background: var(--pink);

  vertical-align: middle;

  margin-left: 18px;
}


/* =========================================================
   SECTIONS
   ========================================================= */

.section {
  padding: 130px 8vw;

  border-bottom: 1px solid var(--line);
}

section > header {
  display: grid;

  grid-template-columns: 80px 1fr;

  gap: 30px;

  margin-bottom: 65px;
}

header small {
  padding-top: 9px;

  font:
    13px
    "Courier New",
    monospace;
}

label {
  display: block;

  color: var(--muted);

  margin-bottom: 20px;

  font:
    10px
    "Courier New",
    monospace;

  letter-spacing: .2em;
}

h2 {
  font-size: clamp(48px, 7vw, 100px);
}


/* =========================================================
   TWO COLUMN
   ========================================================= */

.two-col {
  display: grid;

  grid-template-columns:
    1.1fr
    .9fr;

  gap: 9vw;
}

.big {
  font-size:
    clamp(
      32px,
      4.4vw,
      65px
    );

  line-height: 1.02;

  letter-spacing: -.045em;
}

.copy {
  color: var(--muted);

  line-height: 1.8;
}

.bright {
  color: var(--text) !important;

