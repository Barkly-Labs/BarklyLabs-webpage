---
const systems = [
  {
    number: "01",
    name: "CYN-X CORE",
    tag: "INTELLIGENCE LAYER",
    description:
      "A shared layer connecting intelligent systems, interfaces, services, and physical devices.",
    items: [
      "Computers",
      "Phones",
      "Displays",
      "Speakers",
      "Cameras",
      "Sensors",
      "Wearables",
      "Robotics",
      "Custom hardware",
      "Software services",
    ],
  },
  {
    number: "02",
    name: "LOCAL AI",
    tag: "PRIVATE INFERENCE",
    description:
      "AI designed to run locally where practical, keeping intelligence closer to the people and systems using it.",
    items: [
      "Local models",
      "Private inference",
      "Personal assistants",
      "Adaptive intelligence",
      "Memory systems",
      "Personality systems",
    ],
  },
  {
    number: "03",
    name: "MULTIMODAL",
    tag: "MANY WAYS TO INTERACT",
    description:
      "CYN-X explores interaction across text, vision, devices, environments, and physical computing.",
    items: [
      "Computer vision",
      "AI interfaces",
      "Visual understanding",
      "Environmental awareness",
      "Robotics integration",
      "Human-AI collaboration",
    ],
  },
  {
    number: "04",
    name: "TOOLS + SYSTEMS",
    tag: "BUILD WITH IT",
    description:
      "CYN-X is designed to work alongside projects rather than exist as an isolated chatbot.",
    items: [
      "Software development",
      "APIs",
      "Automation",
      "Developer tools",
      "Dashboards",
      "Infrastructure",
    ],
  },
];

const capabilities = [
  "Local AI",
  "Personal Assistants",
  "Adaptive Intelligence",
  "Memory",
  "Personality",
  "Multimodal Interaction",
  "Computer Vision",
  "Robotics",
  "AI Interfaces",
  "AI-Assisted Development",
  "Human-AI Collaboration",
  "Private Inference",
];

const lifecycle = [
  "Idea",
  "Research",
  "Experiment",
  "Prototype",
  "Community Testing",
  "Engineering",
  "Productization",
  "Release",
  "Feedback",
  "Continued Development",
];

const principles = [
  {
    number: "01",
    title: "HUMAN FIRST",
    text:
      "CYN-X should support people instead of forcing people to reorganize their lives around technology.",
  },
  {
    number: "02",
    title: "UNDERSTANDABLE",
    text:
      "Systems should remain understandable. Documentation is part of the engineering, not an afterthought.",
  },
  {
    number: "03",
    title: "PRIVATE WHERE PRACTICAL",
    text:
      "Local and private infrastructure can keep intelligence closer to the people, projects, and environments using it.",
  },
  {
    number: "04",
    title: "EXPERIMENTAL",
    text:
      "Prototypes, strange ideas, failures, and unfinished experiments are allowed to contribute to the system.",
  },
];

const interfaces = [
  "DESKTOP",
  "MOBILE",
  "WEB",
  "VOICE",
  "VISION",
  "HARDWARE",
  "ROBOTICS",
  "SENSORS",
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="CYN-X — a human-centered intelligent system developed by BARKLY LABS."
    />

    <title>CYN-X — ABOUT</title>
  </head>

  <body>
    <div class="site">

      <!-- HEADER -->

      <header class="site-header">
        <a href="/" class="brand">
          <span>BARKLY</span>
          <span>LABS</span>
        </a>

        <nav>
          <a href="/">HOME</a>
          <a href="/projects">PROJECTS</a>
          <a href="/docs">DOCS</a>
        </nav>

        <div class="status">
          <span class="status-dot"></span>
          CYN-X // ONLINE
        </div>
      </header>


      <main>

        <!-- HERO -->

        <section class="hero section" id="about">

          <div class="hero-grid"></div>

          <div class="eyebrow reveal">
            BARKLY LABS // CYN-X
          </div>

          <h1 class="hero-title reveal">
            INTELLIGENCE<br />
            <span>THAT ADAPTS.</span>
          </h1>

          <div class="hero-bottom reveal">

            <p class="hero-description">
              CYN-X is a human-centered intelligent system exploring what AI
              can become when it is designed around an ongoing relationship
              with its user, environment, tools, and projects.
            </p>

            <div class="hero-mark">
              <span>CYN</span>
              <span class="x">X</span>
            </div>

          </div>

        </section>


        <!-- 01 / THE IDEA -->

        <section class="statement section reveal">

          <div class="section-number">
            01 / THE IDEA
          </div>

          <div class="statement-content">

            <p class="statement-large">
              ONE INTELLIGENT<br />
              <span>ECOSYSTEM.</span>
            </p>

            <p class="statement-small">
              MANY INTERFACES.
            </p>

          </div>

        </section>


        <!-- 02 / CORE -->

        <section class="core section" id="core">

          <div class="section-heading reveal">

            <div>
              <div class="section-number">
                02 / CYN-X CORE
              </div>

              <h2>
                THE<br />
                INTELLIGENCE<br />
                LAYER
              </h2>
            </div>

            <p>
              CYN-X Core is the connecting layer between intelligent systems,
              interfaces, services, and physical devices.
            </p>

          </div>


          <div class="core-visual reveal">

            <div class="core-ring ring-one"></div>
            <div class="core-ring ring-two"></div>
            <div class="core-ring ring-three"></div>

            <div class="core-center">
              <span>CYN-X</span>
              <small>CORE</small>
            </div>

            <div class="orbit orbit-one">AI</div>
            <div class="orbit orbit-two">VISION</div>
            <div class="orbit orbit-three">TOOLS</div>
            <div class="orbit orbit-four">DEVICES</div>
            <div class="orbit orbit-five">DATA</div>
            <div class="orbit orbit-six">PEOPLE</div>

          </div>


          <div class="interface-grid reveal">

            {interfaces.map((item, index) => (
              <div class="interface-item">
                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                <strong>{item}</strong>
              </div>
            ))}

          </div>

        </section>


        <!-- 03 / SYSTEMS -->

        <section class="systems section" id="systems">

          <div class="section-heading reveal">

            <div>

              <div class="section-number">
                03 / SYSTEMS
              </div>

              <h2>
                BUILT AS<br />
                A SYSTEM
              </h2>

            </div>

            <p>
              CYN-X is not intended to be one isolated application. It is an
              ecosystem of connected capabilities.
            </p>

          </div>


          <div class="system-list">

            {systems.map((system) => (

              <article class="system-card reveal">

                <div class="system-top">

                  <span class="system-number">
                    {system.number}
                  </span>

                  <span class="system-tag">
                    {system.tag}
                  </span>

                </div>

                <h3>
                  {system.name}
                </h3>

                <p>
                  {system.description}
                </p>

                <div class="system-items">

                  {system.items.map((item) => (
                    <span>{item}</span>
                  ))}

                </div>

              </article>

            ))}

          </div>

        </section>


        <!-- 04 / CAPABILITIES -->

        <section
          class="capabilities section"
          id="capabilities"
        >

          <div class="section-number reveal">
            04 / CAPABILITIES
          </div>


          <div class="capability-heading reveal">

            <h2>
              MORE THAN<br />
              <span>A CHATBOT.</span>
            </h2>

            <p>
              CYN-X explores intelligent systems that can participate in real
              projects, understand different forms of input, work with tools,
              and connect with the environments around them.
            </p>

          </div>


          <div class="capability-cloud reveal">

            {capabilities.map((capability, index) => (

              <div class="capability">

                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                {capability}

              </div>

            ))}

          </div>

        </section>


        <!-- THE QUESTION -->

        <section class="relationship section reveal">

          <div class="relationship-label">
            THE QUESTION
          </div>

          <blockquote>
            “What can an AI system become when it is designed around an
            ongoing relationship with its user, environment, tools, and
            projects?”
          </blockquote>

          <div class="relationship-footer">

            <span>
              CYN-X / RESEARCH DIRECTION
            </span>

            <span>
              01 — 04
            </span>

          </div>

        </section>


        <!-- 05 / DEVELOPMENT -->

        <section class="lifecycle section">

          <div class="section-heading reveal">

            <div>

              <div class="section-number">
                05 / DEVELOPMENT
              </div>

              <h2>
                BUILD.<br />
                LEARN.<br />
                ITERATE.
              </h2>

            </div>

            <p>
              CYN-X follows an iterative development philosophy where
              research, experimentation, documentation, testing, and feedback
              remain part of the system.
            </p>

          </div>


          <div class="lifecycle-grid reveal">

            {lifecycle.map((stage, index) => (

              <div class="lifecycle-step">

                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                <strong>
                  {stage}
                </strong>

              </div>

            ))}

          </div>

        </section>


        <!-- 06 / DESIGN PRINCIPLES -->

        <section
          class="principles section"
          id="principles"
        >

          <div class="section-number reveal">
            06 / DESIGN PRINCIPLES
          </div>


          <div class="principles-list">

            {principles.map((principle) => (

              <article class="principle reveal">

                <div class="principle-number">
                  {principle.number}
                </div>

                <div>

                  <h3>
                    {principle.title}
                  </h3>

                  <p>
                    {principle.text}
                  </p>

                </div>

              </article>

            ))}

          </div>

        </section>


        <!-- 07 / RESPONSIBLE TECHNOLOGY -->

        <section class="ethics section reveal">

          <div class="section-number">
            07 / RESPONSIBLE TECHNOLOGY
          </div>


          <div class="ethics-layout">

            <div>

              <h2>
                INTELLIGENCE<br />
                WITH <span>CONTEXT.</span>
              </h2>

            </div>


            <div class="ethics-copy">

              <p>
                CYN-X is intended to consider the consequences of technology
                throughout development.
              </p>


              <div class="ethics-grid">

                <span>PRIVACY</span>
                <span>SECURITY</span>
                <span>CONSENT</span>
                <span>ACCESSIBILITY</span>
                <span>TRANSPARENCY</span>
                <span>RESPONSIBLE AI</span>
                <span>HUMAN OVERSIGHT</span>
                <span>DATA MINIMIZATION</span>
                <span>CREATOR OWNERSHIP</span>
                <span>FAIR COMPENSATION</span>

              </div>

            </div>

          </div>

        </section>


        <!-- 08 / HUMAN CENTERED -->

        <section class="human section reveal">

          <div class="human-grid"></div>

          <div class="section-number">
            08 / HUMAN-CENTERED
          </div>


          <div class="human-content">

            <p class="human-kicker">
              THE CORE PRINCIPLE
            </p>

            <h2>
              TECHNOLOGY<br />
              SHOULD ADAPT<br />
              <span>TO HUMANS.</span>
            </h2>


            <p class="human-description">
              People have different energy levels, abilities, interests,
              working styles, and needs. CYN-X is designed around the idea
              that technology should reduce unnecessary effort rather than
              create additional burdens.
            </p>

          </div>

        </section>


        <!-- 09 / ECOSYSTEM -->

        <section class="ecosystem section">

          <div class="section-heading reveal">

            <div>

              <div class="section-number">
                09 / ECOSYSTEM
              </div>

              <h2>
                CONNECTED<br />
                PROJECTS
              </h2>

            </div>

            <p>
              CYN-X exists inside a broader technology ecosystem spanning
              software, vision, embedded systems, hardware, and creative
              tools.
            </p>

          </div>


          <div class="ecosystem-grid reveal">

            <a class="ecosystem-card" href="/projects">

              <span>01</span>

              <strong>CYN-X</strong>

              <small>
                INTELLIGENT SYSTEM
              </small>

            </a>


            <a class="ecosystem-card" href="/projects">

              <span>02</span>

              <strong>SECUSERVE</strong>

              <small>
                COMPUTER VISION
              </small>

            </a>


            <a class="ecosystem-card" href="/projects">

              <span>03</span>

              <strong>SMART GARDEN</strong>

              <small>
                EMBEDDED SYSTEMS
              </small>

            </a>


            <a class="ecosystem-card" href="/projects">

              <span>04</span>

              <strong>PAWBOARD</strong>

              <small>
                MOUDLAR SOCIAL-COMPUTING PlATFORM
              </small>

            </a>

          </div>

        </section>


        <!-- 10 / FUTURE -->

        <section class="future section reveal">

          <div class="section-number">
            10 / THE FUTURE
          </div>


          <div class="future-content">

            <h2>
              ONE SYSTEM.<br />
              <span>MANY POSSIBILITIES.</span>
            </h2>

            <p>
              CYN-X can grow from software into an ecosystem connecting AI,
              hardware, interfaces, robotics, creative technology, and the
              people building with it.
            </p>

          </div>


          <div class="future-line">

            <span>AI</span>
            <i></i>

            <span>SOFTWARE</span>
            <i></i>

            <span>HARDWARE</span>
            <i></i>

            <span>PEOPLE</span>
            <i></i>

            <span>COMMUNITY</span>

          </div>

        </section>


        <!-- CTA -->

        <section class="cta section reveal">

          <div class="cta-eyebrow">
            BARKLY LABS // CYN-X
          </div>

          <h2>
            BUILD WITH<br />
            <span>INTELLIGENCE.</span>
          </h2>


          <div class="cta-actions">

            <a href="/docs" class="button primary">
              READ THE DOCUMENTATION
              <span>→</span>
            </a>

            <a href="/projects" class="button">
              EXPLORE CYN-X
              <span>→</span>
            </a>

          </div>

        </section>

      </main>


      <!-- FOOTER -->

      <footer>

        <div>
          BARKLY LABS / CYN-X
        </div>

        <div>
          HUMAN-CENTERED INTELLIGENCE
        </div>

        <div>
          © 2026
        </div>

      </footer>

    </div>


    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        {
          threshold: 0.08,
        }
      );

      document
        .querySelectorAll(".reveal")
        .forEach((element) => observer.observe(element));
    </script>


    <style>

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #050505;
        color: #f5f5f5;
        font-family:
          "IBM Plex Mono",
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          monospace;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }


      .site {
        min-height: 100vh;
        overflow: hidden;

        background:
          linear-gradient(
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          );

        background-size: 40px 40px;
      }


      /* HEADER */

      .site-header {
        height: 72px;

        border-bottom: 1px solid #262626;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 5vw;

        position: sticky;
        top: 0;

        z-index: 50;

        background: rgba(5, 5, 5, 0.94);

        backdrop-filter: blur(12px);
      }

      .brand {
        display: flex;
        flex-direction: column;

        font-weight: 900;

        letter-spacing: -0.08em;

        font-size: 0.9rem;

        line-height: 0.8;
      }

      .brand span:last-child {
        opacity: 0.4;
      }

      nav {
        display: flex;
        gap: 28px;

        font-size: 0.65rem;

        letter-spacing: 0.12em;
      }

      nav a {
        opacity: 0.45;

        transition:
          opacity 0.2s ease;
      }

      nav a:hover,
      nav a.active {
        opacity: 1;
      }

      .status {
        font-size: 0.6rem;
        letter-spacing: 0.1em;
        opacity: 0.5;
      }

      .status-dot {
        display: inline-block;

        width: 6px;
        height: 6px;

        border-radius: 50%;

        background: #fff;

        margin-right: 7px;

        box-shadow: 0 0 10px #fff;
      }


      /* GENERAL */

      .section {
        position: relative;

        padding: 10vw 5vw;

        border-bottom: 1px solid #262626;
      }

      .reveal {
        opacity: 0;

        transform: translateY(30px);

        transition:
          opacity 0.8s ease,
          transform 0.8s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .section-number {
        font-size: 0.6rem;

        letter-spacing: 0.14em;

        opacity: 0.4;
      }

      .eyebrow {
        font-size: 0.65rem;

        letter-spacing: 0.16em;

        opacity: 0.45;
      }


      /* HERO */

      .hero {
        min-height: 92vh;

        padding-top: 12vw;
        padding-bottom: 8vw;

        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .hero-grid {
        position: absolute;
        inset: 0;

        pointer-events: none;

        background:
          linear-gradient(
            90deg,
            transparent 49.95%,
            rgba(255,255,255,0.05) 50%,
            transparent 50.05%
          );
      }

      .hero-title {
        position: relative;

        z-index: 2;

        margin: 8vh 0;

        font-size: clamp(4rem, 11vw, 12rem);

        line-height: 0.78;

        letter-spacing: -0.09em;

        font-weight: 900;
      }

      .hero-title span {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }

      .hero-bottom {
        display: grid;

        grid-template-columns: 1fr auto;

        align-items: end;

        gap: 8vw;
      }

      .hero-description {
        max-width: 650px;

        color: #999;

        line-height: 1.8;

        font-size: 0.85rem;
      }

      .hero-mark {
        font-size: 5rem;

        font-weight: 900;

        letter-spacing: -0.1em;

        line-height: 0.7;
      }

      .hero-mark .x {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }


      /* STATEMENT */

      .statement {
        min-height: 70vh;

        display: grid;

        grid-template-columns: 15% 85%;

        align-items: center;
      }

      .statement-content {
        max-width: 1000px;
      }

      .statement-large {
        margin: 0;

        font-size: clamp(4rem, 10vw, 11rem);

        line-height: 0.8;

        letter-spacing: -0.09em;

        font-weight: 900;
      }

      .statement-large span {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }

      .statement-small {
        margin: 50px 0 0;

        font-size: 0.7rem;

        letter-spacing: 0.2em;

        opacity: 0.45;
      }


      /* SECTION HEADING */

      .section-heading {
        display: grid;

        grid-template-columns: 1fr 0.65fr;

        gap: 8vw;

        align-items: end;

        margin-bottom: 7vw;
      }

      .section-heading h2 {
        margin: 25px 0 0;

        font-size: clamp(3rem, 7vw, 8rem);

        line-height: 0.8;

        letter-spacing: -0.08em;
      }

      .section-heading > p {
        color: #888;

        line-height: 1.8;

        font-size: 0.8rem;

        max-width: 500px;
      }


      /* CORE */

      .core-visual {
        min-height: 650px;

        position: relative;

        display: flex;

        align-items: center;

        justify-content: center;

        margin-bottom: 7vw;

        overflow: hidden;

        border: 1px solid #222;
      }

      .core-ring {
        position: absolute;

        border: 1px solid #333;

        border-radius: 50%;
      }

      .ring-one {
        width: 250px;
        height: 250px;
      }

      .ring-two {
        width: 420px;
        height: 420px;
      }

      .ring-three {
        width: 600px;
        height: 600px;
      }

      .core-center {
        width: 130px;
        height: 130px;

        border: 1px solid #fff;

        border-radius: 50%;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-direction: column;

        position: relative;

        z-index: 5;

        background: #050505;
      }

      .core-center span {
        font-weight: 900;

        letter-spacing: -0.05em;
      }

      .core-center small {
        margin-top: 8px;

        font-size: 0.5rem;

        opacity: 0.4;

        letter-spacing: 0.15em;
      }

      .orbit {
        position: absolute;

        padding: 10px 14px;

        border: 1px solid #333;

        background: #050505;

        font-size: 0.55rem;

        letter-spacing: 0.1em;

        z-index: 6;
      }

      .orbit-one {
        top: 18%;
        left: 34%;
      }

      .orbit-two {
        top: 25%;
        right: 24%;
      }

      .orbit-three {
        bottom: 27%;
        right: 30%;
      }

      .orbit-four {
        bottom: 18%;
        left: 27%;
      }

      .orbit-five {
        top: 45%;
        left: 10%;
      }

      .orbit-six {
        top: 48%;
        right: 9%;
      }

      .interface-grid {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        border-top: 1px solid #333;

        border-left: 1px solid #333;
      }

      .interface-item {
        min-height: 130px;

        padding: 25px;

        border-right: 1px solid #333;

        border-bottom: 1px solid #333;

        display: flex;

        flex-direction: column;

        justify-content: space-between;
      }

      .interface-item span {
        font-size: 0.55rem;

        opacity: 0.3;
      }

      .interface-item strong {
        font-size: 0.8rem;
      }


      /* SYSTEMS */

      .system-list {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 1px;

        background: #333;
      }

      .system-card {
        min-height: 430px;

        padding: 30px;

        background: #050505;

        display: flex;

        flex-direction: column;

        justify-content: space-between;
      }

      .system-top {
        display: flex;

        justify-content: space-between;

        gap: 20px;
      }

      .system-number,
      .system-tag {
        font-size: 0.55rem;

        letter-spacing: 0.1em;

        opacity: 0.4;
      }

      .system-card h3 {
        margin: 50px 0 25px;

        font-size: clamp(2.5rem, 5vw, 5rem);

        line-height: 0.8;

        letter-spacing: -0.08em;
      }

      .system-card > p {
        color: #888;

        line-height: 1.7;

        font-size: 0.75rem;

        max-width: 550px;
      }

      .system-items {
        display: flex;

        flex-wrap: wrap;

        gap: 6px;

        margin-top: 30px;
      }

      .system-items span {
        border: 1px solid #333;

        padding: 7px 9px;

        font-size: 0.5rem;
      }


      /* CAPABILITIES */

      .capability-heading {
        display: grid;

        grid-template-columns: 1fr 0.65fr;

        gap: 8vw;

        align-items: end;

        margin: 6vw 0;
      }

      .capability-heading h2 {
        margin: 0;

        font-size: clamp(4rem, 9vw, 10rem);

        line-height: 0.78;

        letter-spacing: -0.09em;
      }

      .capability-heading h2 span {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }

      .capability-heading p {
        color: #888;

        line-height: 1.8;

        font-size: 0.8rem;
      }

      .capability-cloud {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        border-top: 1px solid #333;

        border-left: 1px solid #333;
      }

      .capability {
        min-height: 140px;

        padding: 25px;

        border-right: 1px solid #333;

        border-bottom: 1px solid #333;

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        font-size: 0.8rem;
      }

      .capability span {
        font-size: 0.55rem;

        opacity: 0.3;
      }


      /* QUESTION */

      .relationship {
        min-height: 75vh;

        display: flex;

        flex-direction: column;

        justify-content: center;
      }

      .relationship-label {
        font-size: 0.6rem;

        letter-spacing: 0.15em;

        opacity: 0.4;

        margin-bottom: 8vh;
      }

      blockquote {
        max-width: 1200px;

        margin: 0;

        font-size: clamp(2.5rem, 6vw, 7rem);

        line-height: 0.95;

        letter-spacing: -0.07em;
      }

      .relationship-footer {
        margin-top: 8vh;

        padding-top: 20px;

        border-top: 1px solid #333;

        display: flex;

        justify-content: space-between;

        font-size: 0.55rem;

        opacity: 0.4;
      }


      /* DEVELOPMENT */

      .lifecycle-grid {
        display: grid;

        grid-template-columns: repeat(5, 1fr);

        border-top: 1px solid #333;

        border-left: 1px solid #333;
      }

      .lifecycle-step {
        min-height: 180px;

        padding: 25px;

        border-right: 1px solid #333;

        border-bottom: 1px solid #333;

        display: flex;

        flex-direction: column;

        justify-content: space-between;
      }

      .lifecycle-step span {
        font-size: 0.55rem;

        opacity: 0.3;
      }

      .lifecycle-step strong {
        font-size: 0.7rem;

        letter-spacing: 0.08em;
      }


      /* PRINCIPLES */

      .principles {
        display: grid;

        grid-template-columns: 15% 85%;
      }

      .principles-list {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        border-top: 1px solid #333;

        border-left: 1px solid #333;
      }

      .principle {
        min-height: 300px;

        padding: 30px;

        border-right: 1px solid #333;

        border-bottom: 1px solid #333;

        display: grid;

        grid-template-columns: 50px 1fr;

        gap: 25px;
      }

      .principle-number {
        font-size: 0.55rem;

        opacity: 0.3;
      }

      .principle h3 {
        margin: 0;

        font-size: 1rem;
      }

      .principle p {
        color: #888;

        line-height: 1.7;

        font-size: 0.7rem;
      }


      /* ETHICS */

      .ethics-layout {
        display: grid;

        grid-template-columns: 1fr 0.7fr;

        gap: 8vw;

        margin-top: 7vw;
      }

      .ethics h2 {
        margin: 0;

        font-size: clamp(4rem, 8vw, 9rem);

        line-height: 0.78;

        letter-spacing: -0.09em;
      }

      .ethics h2 span {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }

      .ethics-copy > p {
        color: #888;

        line-height: 1.8;

        font-size: 0.8rem;
      }

      .ethics-grid {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        margin-top: 40px;

        border-top: 1px solid #333;

        border-left: 1px solid #333;
      }

      .ethics-grid span {
        padding: 18px;

        border-right: 1px solid #333;

        border-bottom: 1px solid #333;

        font-size: 0.55rem;

        letter-spacing: 0.08em;
      }


      /* HUMAN */

      .human {
        min-height: 90vh;

        display: grid;

        grid-template-columns: 15% 85%;

        align-items: center;

        overflow: hidden;
      }

      .human-grid {
        position: absolute;

        inset: 0;

        pointer-events: none;

        opacity: 0.6;

        background:
          linear-gradient(
            90deg,
            transparent 49.9%,
            #222 50%,
            transparent 50.1%
          );
      }

      .human-content {
        position: relative;

        z-index: 2;
      }

      .human-kicker {
        font-size: 0.6rem;

        letter-spacing: 0.15em;

        opacity: 0.4;
      }

      .human h2 {
        margin: 40px 0;

        font-size: clamp(4rem, 9vw, 11rem);

        line-height: 0.78;

        letter-spacing: -0.09em;
      }

      .human h2 span {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }

      .human-description {
        max-width: 650px;

        color: #888;

        font-size: 0.85rem;

        line-height: 1.8;
      }


      /* ECOSYSTEM */

      .ecosystem-grid {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        gap: 1px;

        background: #333;
      }

      .ecosystem-card {
        min-height: 260px;

        background: #050505;

        padding: 25px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        transition:
          background 0.25s ease;
      }

      .ecosystem-card:hover {
        background: #0c0c0c;
      }

      .ecosystem-card span {
        font-size: 0.55rem;

        opacity: 0.3;
      }

      .ecosystem-card strong {
        font-size: 1.5rem;

        letter-spacing: -0.05em;
      }

      .ecosystem-card small {
        font-size: 0.5rem;

        opacity: 0.4;
      }


      /* FUTURE */

      .future {
        min-height: 90vh;

        display: flex;

        flex-direction: column;

        justify-content: space-between;
      }

      .future-content {
        max-width: 1100px;
      }

      .future h2 {
        margin: 8vh 0;

        font-size: clamp(4rem, 10vw, 12rem);

        line-height: 0.78;

        letter-spacing: -0.09em;
      }

      .future h2 span {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }

      .future-content p {
        max-width: 650px;

        color: #888;

        line-height: 1.8;

        font-size: 0.85rem;
      }

      .future-line {
        display: flex;

        align-items: center;

        gap: 20px;

        flex-wrap: wrap;

        padding-top: 25px;

        border-top: 1px solid #333;

        font-size: 0.55rem;

        letter-spacing: 0.1em;

        opacity: 0.45;
      }

      .future-line i {
        width: 30px;

        height: 1px;

        background: #555;
      }


      /* CTA */

      .cta {
        min-height: 70vh;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        text-align: center;
      }

      .cta-eyebrow {
        font-size: 0.6rem;

        letter-spacing: 0.15em;

        opacity: 0.4;
      }

      .cta h2 {
        margin: 60px 0;

        font-size: clamp(4rem, 10vw, 12rem);

        line-height: 0.78;

        letter-spacing: -0.09em;
      }

      .cta h2 span {
        color: transparent;

        -webkit-text-stroke: 1px #fff;
      }

      .cta-actions {
        display: flex;

        gap: 10px;

        flex-wrap: wrap;

        justify-content: center;
      }

      .button {
        border: 1px solid #444;

        padding: 16px 24px;

        font-size: 0.6rem;

        letter-spacing: 0.08em;

        transition:
          background 0.2s ease,
          color 0.2s ease;
      }

      .button:hover,
      .button.primary {
        background: #fff;

        color: #000;
      }

      .button span {
        margin-left: 15px;
      }


      /* FOOTER */

      footer {
        display: flex;

        justify-content: space-between;

        padding: 25px 5vw;

        font-size: 0.55rem;

        letter-spacing: 0.08em;

        opacity: 0.35;
      }


      /* MOBILE */

      @media (max-width: 800px) {

        nav {
          display: none;
        }

        .status {
          display: none;
        }

        .site-header {
          height: 60px;
        }

        .hero {
          min-height: 80vh;
        }

        .hero-title {
          font-size: 18vw;
        }

        .hero-bottom,
        .section-heading,
        .capability-heading,
        .ethics-layout {
          grid-template-columns: 1fr;
        }

        .hero-bottom {
          gap: 30px;
        }

        .hero-mark {
          font-size: 3rem;
        }

        .statement,
        .principles {
          grid-template-columns: 1fr;

          gap: 40px;
        }

        .statement-large {
          font-size: 16vw;
        }

        .interface-grid,
        .capability-cloud,
        .system-list,
        .ecosystem-grid,
        .lifecycle-grid,
        .principles-list {
          grid-template-columns: 1fr;
        }

        .core-visual {
          min-height: 500px;
        }

        .ring-three {
          width: 450px;
          height: 450px;
        }

        .orbit {
          display: none;
        }

        .human {
          grid-template-columns: 1fr;

          min-height: 80vh;
        }

        .human h2,
        .future h2,
        .cta h2 {
          font-size: 17vw;
        }

        footer {
          flex-direction: column;

          gap: 10px;
        }

      }

    </style>

  </body>
</html>