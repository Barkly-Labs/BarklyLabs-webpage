---
const layers = [
  {
    number: "01",
    name: "INTELLIGENCE",
    tag: "REASONING LAYER",
    description:
      "The intelligence layer responsible for understanding context, reasoning through problems, generating responses, and coordinating capabilities.",
    items: [
      "Language models",
      "Reasoning",
      "Context",
      "Planning",
      "Problem solving",
      "Decision support",
    ],
  },
  {
    number: "02",
    name: "MEMORY",
    tag: "CONTINUITY LAYER",
    description:
      "Memory gives CYN-X continuity across interactions, projects, preferences, and long-running work.",
    items: [
      "Short-term context",
      "Long-term memory",
      "Project context",
      "User preferences",
      "Knowledge",
      "State",
    ],
  },
  {
    number: "03",
    name: "TOOLS",
    tag: "ACTION LAYER",
    description:
      "Tools allow intelligence to interact with software, services, files, systems, and the physical world.",
    items: [
      "APIs",
      "Code execution",
      "Automation",
      "File systems",
      "Developer tools",
      "External services",
    ],
  },
  {
    number: "04",
    name: "INTERFACES",
    tag: "HUMAN LAYER",
    description:
      "Interfaces are how people and environments communicate with the Core.",
    items: [
      "Desktop",
      "Web",
      "Mobile",
      "Voice",
      "Vision",
      "Hardware",
    ],
  },
];

const subsystems = [
  "MODEL RUNTIME",
  "CONTEXT ENGINE",
  "MEMORY",
  "PERSONALITY",
  "TOOL ROUTER",
  "VISION",
  "AUTOMATION",
  "EVENT BUS",
  "DEVICE BRIDGE",
  "PERMISSIONS",
  "LOCAL SERVICES",
  "INTERFACE LAYER",
];

const signals = [
  "TEXT",
  "VOICE",
  "VISION",
  "FILES",
  "DEVICES",
  "SENSORS",
  "EVENTS",
  "APPLICATIONS",
];

const outputs = [
  "RESPONSES",
  "ACTIONS",
  "AUTOMATION",
  "CODE",
  "VISUAL OUTPUT",
  "DEVICE CONTROL",
  "KNOWLEDGE",
  "ASSISTANCE",
];

const principles = [
  {
    number: "01",
    title: "ONE CORE",
    text:
      "Different interfaces and applications should be able to share the same underlying intelligence instead of recreating the system from scratch.",
  },
  {
    number: "02",
    title: "MODULAR",
    text:
      "CYN-X Core is designed as a collection of replaceable and extensible components rather than one inseparable application.",
  },
  {
    number: "03",
    title: "LOCAL WHERE PRACTICAL",
    text:
      "The architecture can place models, memory, tools, and services close to the user when local infrastructure makes sense.",
  },
  {
    number: "04",
    title: "HUMAN CONTROL",
    text:
      "The Core exists to assist people. Access, actions, automation, and system behavior should remain understandable and controllable.",
  },
];

const lifecycle = [
  "INPUT",
  "CONTEXT",
  "UNDERSTANDING",
  "REASONING",
  "TOOL SELECTION",
  "ACTION",
  "RESULT",
  "MEMORY",
  "FEEDBACK",
];

const year = 2026;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="CYN-X Core — the intelligence and coordination layer of the CYN-X ecosystem."
    />
    <title>CYN-X CORE — BARKLY LABS</title>
  </head>

  <body>
    <!-- NAVIGATION -->
    <header class="site-header">
      <a class="brand" href="/">
        <span>BARKLY</span>
        <span>LABS</span>
      </a>

      <nav>
        <a href="#about">CORE</a>
        <a href="#architecture">ARCHITECTURE</a>
        <a href="#layers">LAYERS</a>
        <a href="#flow">FLOW</a>
        <a href="#principles">PRINCIPLES</a>
      </nav>

      <div class="status">
        <span class="status-dot"></span>
        CYN-X // CORE
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero section" id="about">
        <div class="hero-grid"></div>

        <div class="eyebrow reveal">
          BARKLY LABS // CYN-X // CORE
        </div>

        <h1 class="hero-title reveal">
          THE CORE<br />
          <span>BEHIND CYN-X.</span>
        </h1>

        <div class="hero-bottom reveal">
          <p class="hero-description">
            CYN-X Core is the central intelligence and coordination layer
            connecting models, memory, tools, interfaces, devices, and the
            systems built around them.
          </p>

          <div class="hero-mark">
            <span>C</span>
            <span class="x">X</span>
          </div>
        </div>
      </section>

      <!-- STATEMENT -->
      <section class="statement section reveal">
        <div class="section-number">01 / THE CORE IDEA</div>

        <div class="statement-content">
          <p class="statement-large">
            ONE CORE.<br />
            <span>MANY SYSTEMS.</span>
          </p>

          <p class="statement-small">
            INTELLIGENCE SHOULD BE CONNECTABLE.
          </p>
        </div>
      </section>

      <!-- CORE ARCHITECTURE -->
      <section class="architecture section" id="architecture">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">02 / ARCHITECTURE</div>
            <h2>THE INTELLIGENCE LAYER</h2>
          </div>

          <p>
            CYN-X Core provides a shared foundation that allows intelligence,
            memory, tools, interfaces, and devices to operate as parts of one
            larger system.
          </p>
        </div>

        <div class="architecture-diagram reveal">
          <div class="architecture-line line-one"></div>
          <div class="architecture-line line-two"></div>
          <div class="architecture-line line-three"></div>
          <div class="architecture-line line-four"></div>

          <div class="architecture-node input-node">
            <span>01</span>
            INPUT
          </div>

          <div class="architecture-node context-node">
            <span>02</span>
            CONTEXT
          </div>

          <div class="architecture-core">
            <div class="core-inner">
              <strong>CYN-X</strong>
              <span>CORE</span>
            </div>
          </div>

          <div class="architecture-node tools-node">
            <span>03</span>
            TOOLS
          </div>

          <div class="architecture-node memory-node">
            <span>04</span>
            MEMORY
          </div>

          <div class="architecture-node output-node">
            <span>05</span>
            OUTPUT
          </div>
        </div>

        <div class="architecture-caption reveal">
          <span>INPUT</span>
          <i></i>
          <span>CORE</span>
          <i></i>
          <span>ACTION</span>
        </div>
      </section>

      <!-- CORE LAYERS -->
      <section class="layers section" id="layers">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">03 / CORE LAYERS</div>
            <h2>BUILT IN LAYERS</h2>
          </div>

          <p>
            CYN-X Core separates intelligence from the interfaces and systems
            surrounding it so individual components can evolve independently.
          </p>
        </div>

        <div class="layer-list">
          {layers.map((layer) => (
            <article class="layer-card reveal">
              <div class="layer-top">
                <span class="layer-number">{layer.number}</span>
                <span class="layer-tag">{layer.tag}</span>
              </div>

              <h3>{layer.name}</h3>

              <p>{layer.description}</p>

              <div class="layer-items">
                {layer.items.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- SUBSYSTEMS -->
      <section class="subsystems section reveal">
        <div class="section-number">04 / SUBSYSTEMS</div>

        <div class="subsystem-heading">
          <h2>
            THE PIECES<br />
            <span>INSIDE.</span>
          </h2>

          <p>
            The Core is not a single model. It is an architecture made from
            multiple services and subsystems that cooperate around intelligence.
          </p>
        </div>

        <div class="subsystem-grid">
          {subsystems.map((system, index) => (
            <div class="subsystem">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{system}</strong>
            </div>
          ))}
        </div>
      </section>

      <!-- INPUT / OUTPUT -->
      <section class="signals section">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">05 / INTERACTION</div>
            <h2>EVERYTHING CAN BE A SIGNAL</h2>
          </div>

          <p>
            CYN-X Core is designed to accept information from many different
            interfaces and return useful results through many different outputs.
          </p>
        </div>

        <div class="signal-layout reveal">
          <div class="signal-column">
            <div class="signal-label">INPUTS</div>

            {signals.map((signal, index) => (
              <div class="signal-item">
                <span>0{index + 1}</span>
                {signal}
              </div>
            ))}
          </div>

          <div class="signal-core">
            <div class="signal-core-ring"></div>
            <div class="signal-core-center">
              <strong>CYN-X</strong>
              <small>PROCESS</small>
            </div>
          </div>

          <div class="signal-column">
            <div class="signal-label">OUTPUTS</div>

            {outputs.map((output, index) => (
              <div class="signal-item">
                <span>0{index + 1}</span>
                {output}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- PROCESS -->
      <section class="flow section" id="flow">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">06 / PROCESS</div>
            <h2>FROM SIGNAL TO ACTION</h2>
          </div>

          <p>
            A request does not have to stop at a generated response. CYN-X Core
            can interpret context, select capabilities, use tools, and preserve
            useful state for future interactions.
          </p>
        </div>

        <div class="flow-grid reveal">
          {lifecycle.map((stage, index) => (
            <div class="flow-step">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{stage}</strong>
            </div>
          ))}
        </div>
      </section>

      <!-- MEMORY -->
      <section class="memory section reveal">
        <div class="section-number">07 / CONTINUITY</div>

        <div class="memory-layout">
          <div>
            <h2>
              INTELLIGENCE<br />
              WITH <span>MEMORY.</span>
            </h2>
          </div>

          <div class="memory-copy">
            <p>
              A useful intelligent system needs more than a model. It needs
              context that can persist across projects, interactions, tools,
              and environments.
            </p>

            <div class="memory-grid">
              <span>USER</span>
              <span>PROJECT</span>
              <span>CONTEXT</span>
              <span>HISTORY</span>
              <span>PREFERENCES</span>
              <span>STATE</span>
              <span>KNOWLEDGE</span>
              <span>ENVIRONMENT</span>
            </div>
          </div>
        </div>
      </section>

      <!-- LOCAL -->
      <section class="local section reveal">
        <div class="section-number">08 / LOCAL INTELLIGENCE</div>

        <div class="local-content">
          <div class="local-label">
            <span>01</span>
            WHERE PRACTICAL
          </div>

          <h2>
            KEEP THE<br />
            <span>CORE CLOSE.</span>
          </h2>

          <p>
            CYN-X can use local models, local services, and local infrastructure
            where practical. The goal is not that everything must run locally,
            but that local computing remains a first-class architectural option.
          </p>
        </div>

        <div class="local-specs">
          <div>
            <span>INFERENCE</span>
            <strong>LOCAL / REMOTE</strong>
          </div>

          <div>
            <span>MEMORY</span>
            <strong>USER CONTROLLED</strong>
          </div>

          <div>
            <span>TOOLS</span>
            <strong>MODULAR</strong>
          </div>

          <div>
            <span>INTERFACES</span>
            <strong>MANY</strong>
          </div>
        </div>
      </section>

      <!-- PRINCIPLES -->
      <section class="principles section" id="principles">
        <div class="section-number reveal">
          09 / CORE PRINCIPLES
        </div>

        <div class="principles-list">
          {principles.map((principle) => (
            <article class="principle reveal">
              <div class="principle-number">
                {principle.number}
              </div>

              <div>
                <h3>{principle.title}</h3>
                <p>{principle.text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- RELATIONSHIP -->
      <section class="relationship section reveal">
        <div class="relationship-label">
          THE CENTRAL QUESTION
        </div>

        <blockquote>
          “What happens when intelligence becomes infrastructure instead of
          just an application?”
        </blockquote>

        <div class="relationship-footer">
          <span>CYN-X CORE / ARCHITECTURE</span>
          <span>01 — 09</span>
        </div>
      </section>

      <!-- FUTURE -->
      <section class="future section reveal">
        <div class="section-number">10 / THE FUTURE</div>

        <div class="future-content">
          <h2>
            ONE CORE.<br />
            <span>ENDLESS INTERFACES.</span>
          </h2>

          <p>
            CYN-X Core can become the shared intelligence layer behind desktop
            applications, mobile interfaces, creative tools, hardware,
            robotics, accessibility systems, developer tools, and future
            Barkly Labs projects.
          </p>
        </div>

        <div class="future-line">
          <span>MODEL</span>
          <i></i>
          <span>MEMORY</span>
          <i></i>
          <span>TOOLS</span>
          <i></i>
          <span>DEVICES</span>
          <i></i>
          <span>PEOPLE</span>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta section reveal">
        <div class="cta-eyebrow">
          BARKLY LABS // CYN-X CORE
        </div>

        <h2>
          BUILD THE<br />
          <span>INTELLIGENCE LAYER.</span>
        </h2>

        <div class="cta-actions">
          <a href="/docs" class="button primary">
            READ THE DOCUMENTATION
            <span>→</span>
          </a>

          <a href="/projects" class="button secondary">
            EXPLORE CYN-X
            <span>↗</span>
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>BARKLY LABS</strong>
        <span>CYN-X // CORE</span>
      </div>

      <div class="footer-center">
        INTELLIGENCE SHOULD BE CONNECTABLE.
      </div>

      <div class="footer-meta">
        <span>DETROIT, MICHIGAN</span>
        <span>© {year}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #050505;
    --surface: #0b0b0b;
    --surface-2: #101010;
    --line: rgba(255, 255, 255, 0.12);
    --line-strong: rgba(255, 255, 255, 0.25);
    --text: #f4f4f4;
    --muted: #8c8c8c;
    --max: 1400px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .section {
    width: min(calc(100% - 48px), var(--max));
    margin: 0 auto;
    position: relative;
  }

  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--line);
    background: rgba(5, 5, 5, 0.8);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: flex;
    flex-direction: column;
    width: max-content;
    font-size: 12px;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .site-header nav {
    display: flex;
    gap: 25px;
  }

  .site-header nav a,
  .status {
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .site-header nav a:hover {
    color: var(--text);
  }

  .status {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 10px #fff;
  }

  /* HERO */

  .hero {
    min-height: 100vh;
    padding-top: 190px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.16;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: linear-gradient(to bottom, #000, transparent);
  }

  .eyebrow,
  .section-number {
    font-family: monospace;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .hero-title {
    position: relative;
    z-index: 1;
    margin: 60px 0;
    font-size: clamp(4rem, 10vw, 10rem);
    line-height: 0.82;
    letter-spacing: -0.085em;
    font-weight: 900;
  }

  .hero-title span {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.55);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
  }

  .hero-description {
    max-width: 560px;
    color: #aaa;
    font-size: 16px;
    line-height: 1.65;
  }

  .hero-mark {
    justify-self: end;
    font-size: clamp(6rem, 13vw, 13rem);
    font-weight: 900;
    line-height: 0.7;
    letter-spacing: -0.1em;
  }

  .hero-mark .x {
    color: transparent;
    -webkit-text-stroke: 1px #fff;
  }

  /* STATEMENT */

  .statement {
    min-height: 80vh;
    padding: 150px 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .statement-content {
    padding-left: 20%;
  }

  .statement-large {
    margin: 0;
    font-size: clamp(4rem, 9vw, 9rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.08em;
  }

  .statement-large span {
    color: transparent;
    -webkit-text-stroke: 1px #fff;
  }

  .statement-small {
    margin: 35px 0 0;
    font-family: monospace;
    color: var(--muted);
    letter-spacing: 0.2em;
  }

  /* HEADINGS */

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: end;
    padding-bottom: 60px;
    border-bottom: 1px solid var(--line);
  }

  .section-heading h2 {
    margin: 20px 0 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .section-heading p {
    max-width: 500px;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  /* ARCHITECTURE */

  .architecture {
    padding: 150px 0;
  }

  .architecture-diagram {
    position: relative;
    width: min(900px, 90vw);
    aspect-ratio: 1.7;
    margin: 100px auto 30px;
  }

  .architecture-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 220px;
    height: 220px;
    transform: translate(-50%, -50%);
    border: 1px solid #fff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #050505;
    z-index: 3;
  }

  .architecture-core::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }

  .core-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .core-inner strong {
    font-size: 34px;
    letter-spacing: -0.06em;
  }

  .core-inner span {
    margin-top: 7px;
    font-family: monospace;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.2em;
  }

  .architecture-node {
    position: absolute;
    z-index: 4;
    min-width: 105px;
    padding: 12px 15px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    font-family: monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .architecture-node span {
    display: block;
    margin-bottom: 6px;
    color: #555;
    font-size: 8px;
  }

  .input-node {
    left: 2%;
    top: 20%;
  }

  .context-node {
    left: 2%;
    bottom: 20%;
  }

  .tools-node {
    right: 2%;
    top: 20%;
  }

  .memory-node {
    right: 2%;
    bottom: 20%;
  }

  .output-node {
    left: 50%;
    bottom: -3%;
    transform: translateX(-50%);
  }

  .architecture-line {
    position: absolute;
    height: 1px;
    background: var(--line-strong);
    z-index: 1;
    transform-origin: left center;
  }

  .line-one {
    left: 14%;
    top: 32%;
    width: 32%;
  }

  .line-two {
    left: 14%;
    bottom: 32%;
    width: 32%;
  }

  .line-three {
    left: 54%;
    top: 32%;
    width: 32%;
  }

  .line-four {
    left: 54%;
    bottom: 32%;
    width: 32%;
  }

  .architecture-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    color: var(--muted);
  }

  .architecture-caption i {
    width: 80px;
    height: 1px;
    background: var(--line);
  }

  /* LAYERS */

  .layers {
    padding: 150px 0;
  }

  .layer-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .layer-card {
    min-height: 450px;
    padding: 35px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    transition: background 0.25s ease;
  }

  .layer-card:hover {
    background: var(--surface-2);
  }

  .layer-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: monospace;
    font-size: 9px;
  }

  .layer-number {
