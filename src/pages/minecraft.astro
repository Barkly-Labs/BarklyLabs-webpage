---
import SEO from "../components/SEO.astro";

export const prerender = true;

const base = import.meta.env.BASE_URL;
const projectsUrl = `${base}projects/`;
const chemLabUrl = "https://www.curseforge.com/minecraft/modpacks/barkly-chem-lab";
const curseForgeProjectsUrl = "https://www.curseforge.com/members/pipermaebarkly/projects";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO />
  </head>
  <body>
    <header class="topbar">
      <a href={base} class="brand" aria-label="Barkly Labs home">
        <span>BARKLY</span><span>LABS</span>
      </a>
      <div class="top-status">CREATIVE TECHNOLOGY / MINECRAFT</div>
      <a href={projectsUrl} class="back">← ALL PROJECTS</a>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-orbit orbit-one" aria-hidden="true"></div>
        <div class="hero-orbit orbit-two" aria-hidden="true"></div>
        <div class="hero-content">
          <div class="eyebrow"><span>01</span> BARKLY LABS / CREATIVE COMPUTING</div>
          <h1 id="page-title">WORLDS<br /><span>IN MOTION.</span></h1>
          <p>
            Barkly Labs explores creativity, engineering, and experimentation
            through Minecraft: a place to build systems, shape an atmosphere,
            and make ideas interactive.
          </p>
          <p class="hero-dim">
            This collection starts with Barkly Chem Lab. More creations can be
            added here as they take shape.
          </p>
          <div class="hero-actions">
            <a class="primary" href="#creations">EXPLORE CREATIONS ↓</a>
            <a href={projectsUrl}>BARKLY PROJECTS ↗</a>
          </div>
        </div>
        <div class="hero-side">CREATIVE TECHNOLOGY<br />EXPERIMENT / BUILD / PLAY<br />BARKLY LABS</div>
        <div class="hero-scroll">MAKE IDEAS INTERACTIVE <b></b></div>
      </section>

      <section class="section" id="creations" aria-labelledby="creations-title">
        <header class="section-header">
          <small>02</small>
          <div>
            <label>MINECRAFT / PACKS &amp; CREATIONS</label>
            <h2 id="creations-title">BUILT TO <span>EXPLORE.</span></h2>
          </div>
        </header>

        <article class="project-card" aria-labelledby="chem-lab-title">
          <div class="project-art">
            <img
              class="project-logo"
              src={`${base}assets/barkly-chem-lab-logo.png`}
              alt="Barkly Chem Lab logo with a glowing purple chemistry flask, paw print, and laboratory imagery"
              width="1254"
              height="1254"
            />
          </div>

          <div class="project-copy">
            <div class="project-topline">
              <span class="project-type">FEATURED CREATION</span>
              <span class="project-number">01 / MINECRAFT</span>
            </div>
            <h3 id="chem-lab-title">Barkly Chem Lab</h3>
            <p class="description">
              An experimental Minecraft modpack bringing together exploration,
              technology, chemistry-inspired systems, creativity, automation,
              farming, space exploration, progression, and an immersive
              atmosphere. Custom design elements, menu elements, and a
              soundtrack-driven atmosphere shape the curated experience.
            </p>

            <dl class="specs">
              <div><dt>MINECRAFT</dt><dd>1.20.1</dd></div>
              <div><dt>MODLOADER</dt><dd>Forge</dd></div>
            </dl>

            <a class="project-link" href={chemLabUrl} target="_blank" rel="noopener noreferrer">
              <span>VIEW BARKLY CHEM LAB ON CURSEFORGE</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <p class="future-note">
          <span aria-hidden="true">+</span>
          New Minecraft experiments and creations will join this collection as
          they are ready to share.
        </p>
      </section>

      <footer>
        <div class="footer-brand"><strong>BARKLY <span>LABS</span></strong><p>CREATIVE TECHNOLOGY / PUBLIC PROJECTS</p></div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href={base}>BARKLY LABS</a>
          <a href={projectsUrl}>ALL PROJECTS</a>
          <a href={curseForgeProjectsUrl} target="_blank" rel="noopener noreferrer">CURSEFORGE PROJECTS ↗</a>
        </nav>
        <p class="copyright">© 2026 BARKLY LABS · TECHNOLOGY SHOULD ADAPT TO HUMANS.</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #050505;
    --surface: #0a0a0a;
    --surface-2: #0f0f0f;
    --white: #f1f1f1;
    --text: #f1f1f1;
    --muted: #a1a1a1;
    --dim: #686868;
    --line: rgba(255, 255, 255, 0.12);
    --pink: #ff2f92;
    --pink-soft: rgba(255, 47, 146, 0.1);
    --pink-line: rgba(255, 47, 146, 0.42);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body {
    margin: 0;
    color: var(--text);
    background: radial-gradient(circle at 75% 5%, var(--pink-soft), transparent 32rem), var(--bg);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--pink); outline-offset: 4px; }
  ::selection { background: var(--pink); color: #050505; }

  .topbar {
    position: sticky; top: 0; z-index: 10; min-height: 68px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 5vw; border-bottom: 1px solid var(--line);
    background: rgba(5, 5, 5, .9); backdrop-filter: blur(18px);
    font: 10px "Courier New", monospace; letter-spacing: .18em;
  }
  .brand { display: inline-flex; gap: 7px; width: fit-content; font-weight: 800; letter-spacing: .08em; }
  .brand span:first-child { color: var(--white); }
  .brand span:last-child { color: var(--pink); }
  .top-status { color: var(--dim); text-align: center; }
  .back { justify-self: end; color: var(--muted); }
  .back:hover, .footer-links a:hover { color: var(--pink); }

  .hero {
    position: relative; min-height: 76vh; display: flex; align-items: center;
    padding: 110px 8vw 100px; overflow: hidden; border-bottom: 1px solid var(--line);
  }
  .hero-grid {
    position: absolute; inset: 0; opacity: .32;
    background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 64px 64px; mask-image: linear-gradient(to bottom, #000, transparent 88%);
  }
  .hero-orbit { position: absolute; border: 1px solid var(--pink-line); border-radius: 50%; pointer-events: none; }
  .orbit-one { width: 58vw; height: 58vw; right: -22vw; top: -25vw; }
  .orbit-two { width: 32vw; height: 32vw; right: -5vw; top: -9vw; }
  .hero-content { position: relative; z-index: 1; max-width: 900px; }
  .eyebrow { display: flex; gap: 18px; margin-bottom: 30px; color: var(--muted); font: 10px "Courier New", monospace; letter-spacing: .2em; }
  .eyebrow span { color: var(--pink); }
  h1 { margin: 0; color: var(--pink); font-size: clamp(62px, 10vw, 145px); line-height: .84; letter-spacing: -.075em; }
  h1 span { display: block; color: transparent; -webkit-text-stroke: 2px var(--white); }
  .hero-content > p { max-width: 720px; margin: 34px 0 0; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .hero-content .hero-dim { margin-top: 12px; color: var(--dim); font-size: 14px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero-actions a { min-width: 190px; padding: 15px 18px; border: 1px solid var(--line); text-align: center; font: 10px "Courier New", monospace; letter-spacing: .12em; }
  .hero-actions .primary { color: #050505; background: var(--pink); border-color: var(--pink); font-weight: 800; }
  .hero-actions a:hover { border-color: var(--pink); }
  .hero-side { position: absolute; right: 4vw; top: 50%; transform: rotate(90deg) translateX(50%); transform-origin: right center; color: var(--dim); font: 8px/2 "Courier New", monospace; letter-spacing: .18em; }
  .hero-scroll { position: absolute; left: 8vw; bottom: 28px; color: var(--dim); font: 9px "Courier New", monospace; letter-spacing: .18em; }
  .hero-scroll b { display: inline-block; width: 64px; height: 1px; margin: 0 0 3px 12px; background: var(--pink); }

  .section { max-width: 1400px; margin: auto; padding: 110px 8vw 120px; }
  .section-header { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 44px; }
  .section-header small { padding-top: 5px; color: var(--pink); font: 11px "Courier New", monospace; }
  .section-header label, .project-type { color: var(--dim); font: 10px "Courier New", monospace; letter-spacing: .18em; }
  h2 { margin: 12px 0 0; font-size: clamp(32px, 5vw, 64px); line-height: .95; letter-spacing: -.055em; }
  h2 span { color: var(--pink); }
  .project-card { display: grid; grid-template-columns: minmax(260px, .9fr) 1.1fr; min-height: 440px; border: 1px solid var(--line); background: linear-gradient(120deg, #0c0a0c, var(--surface)); }
  .project-art { position: relative; min-height: 360px; display: grid; place-items: center; padding: 20px; overflow: hidden; border-right: 1px solid var(--line); background: #080708; }
  .project-logo { display: block; justify-self: center; align-self: center; margin-inline: auto; width: min(100%, 560px); height: auto; aspect-ratio: 1; object-fit: contain; object-position: center; }
  .project-copy { display: flex; flex-direction: column; padding: clamp(26px, 4vw, 54px); }
  .project-topline { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
  .project-number { color: var(--dim); font: 9px "Courier New", monospace; letter-spacing: .12em; }
  h3 { margin: 32px 0 0; font-size: clamp(32px, 4vw, 48px); line-height: 1; letter-spacing: -.05em; }
  .description { max-width: 620px; margin: 18px 0 0; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .specs { display: flex; gap: 34px; margin: 28px 0 30px; }
  .specs div { display: grid; gap: 7px; }
  dt { color: var(--dim); font: 9px "Courier New", monospace; letter-spacing: .14em; }
  dd { margin: 0; color: var(--white); font-size: 14px; }
  .project-link { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-top: auto; padding: 17px 0 0; border-top: 1px solid var(--line); color: var(--pink); font: 10px "Courier New", monospace; letter-spacing: .12em; }
  .project-link:hover { color: var(--white); }
  .arrow { font-size: 18px; }
  .future-note { display: flex; align-items: center; gap: 12px; max-width: 680px; margin: 24px 0 0; color: var(--dim); font-size: 13px; line-height: 1.6; }
  .future-note span { color: var(--pink); font: 20px "Courier New", monospace; }

  footer { padding: 48px 8vw 28px; border-top: 1px solid var(--line); background: #070707; }
  .footer-brand strong { font-size: 17px; letter-spacing: .08em; }
  .footer-brand strong span { color: var(--pink); }
  .footer-brand p { color: var(--dim); font: 9px "Courier New", monospace; letter-spacing: .14em; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 24px; margin: 26px 0; color: var(--muted); font: 10px "Courier New", monospace; letter-spacing: .12em; }
  .copyright { margin: 0; padding-top: 20px; border-top: 1px solid var(--line); color: var(--dim); font: 9px "Courier New", monospace; letter-spacing: .1em; }

  @media (max-width: 760px) {
    .topbar { grid-template-columns: 1fr 1fr; min-height: 60px; padding: 0 5vw; }
    .top-status { display: none; }
    .hero { min-height: 72vh; padding: 90px 7vw; }
    .hero-side { display: none; }
    .hero-scroll { left: 7vw; }
    .section { padding: 76px 6vw 88px; }
    .project-card { grid-template-columns: 1fr; }
    .project-art { min-height: 300px; border-right: 0; border-bottom: 1px solid var(--line); }
    .project-copy { min-height: 360px; }
    footer { padding: 40px 6vw 24px; }
  }
  @media (max-width: 430px) {
    .topbar { font-size: 9px; letter-spacing: .11em; }
    .back { font-size: 8px; }
    .eyebrow { gap: 10px; font-size: 8px; }
    .hero-content > p { font-size: 16px; }
    .hero-actions a { width: 100%; }
    .project-topline { align-items: flex-start; flex-direction: column; }
    .specs { gap: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
