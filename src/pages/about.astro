---
import SEO from "../components/SEO.astro";

const sections = [
  {
    number: "01",
    label: "IDENTITY",
    title: "A LAB FOR<br /><span>PEOPLE.</span>",
    copy:
      "Barkly Labs is an independent technology laboratory building human-centered systems, experimental tools, research infrastructure, and open technology.",
  },
  {
    number: "02",
    label: "WHY WE EXIST",
    title: "TECHNOLOGY<br /><span>SHOULD HELP.</span>",
    copy:
      "Technology is powerful. But power alone is not the goal. Barkly exists to make complex technology more useful, understandable, accessible, creative, and human.",
  },
  {
    number: "03",
    label: "THE LAB",
    title: "BUILD.<br /><span>LEARN.</span><br />REPEAT.",
    copy:
      "Barkly is a place for experimentation. Systems are built, tested, documented, questioned, improved, and released so that knowledge can become infrastructure.",
  },
];
---

<html lang="en">
  <head>
    <meta
      name="twitter:description"
      content="Learn about Barkly Labs, a human-centered technology laboratory building software, hardware, AI systems, documentation, and creative technology for people."
    />
    <meta name="twitter:title" content="Barkly Labs — About" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:site_name" content="Barkly Labs" />
    <meta
      property="og:url"
      content="https://www.barklylabs.space/about/"
    />
    <meta
      property="og:description"
      content="Learn about Barkly Labs, a human-centered technology laboratory building software, hardware, AI systems, documentation, and creative technology for people."
    />
    <meta property="og:title" content="Barkly Labs — About" />
    <meta property="og:type" content="website" />
    <link
      rel="canonical"
      href="https://www.barklylabs.space/about/"
    />
    <meta name="robots" content="index, follow" />
    <meta
      name="description"
      content="Learn about Barkly Labs, a human-centered technology laboratory building software, hardware, AI systems, documentation, and creative technology for people."
    />
    <title>Barkly Labs — About</title>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <SEO />
  </head>

  <body>
    <div class="page">

      <!-- HEADER -->

      <header class="site-header">
        <div class="header-logo">
          <a href={import.meta.env.BASE_URL + ""}>
            <span>BARKLY</span> <strong>LABS</strong>
          </a>
        </div>

        <div class="header-document">
          <span>ABOUT</span>
          <span>/</span>
          <span>DOCUMENT 000</span>
        </div>
      </header>


      <!-- SIDE NAV -->

      <aside class="side-nav">
        <a href="#identity">
          <span>01</span>
          IDENTITY
        </a>

        <a href="#purpose">
          <span>02</span>
          PURPOSE
        </a>

        <a href="#lab">
          <span>03</span>
          THE LAB
        </a>

        <a href="#systems">
          <span>04</span>
          SYSTEMS
        </a>

        <a href="#people">
          <span>05</span>
          PEOPLE
        </a>

        <a href="#future">
          <span>06</span>
          FUTURE
        </a>

        <a href="#support">
          <span>07</span>
          SUPPORT
        </a>
      </aside>


      <!-- HERO -->

      <main>

        <section class="hero" id="identity">
          <div class="section-meta">
            <span>BARKLY LABS</span>
            <span>ABOUT / DOCUMENT 000</span>
          </div>

          <div class="hero-title">
            <h1>
              WE BUILD<br />
              <span>THE LAB.</span>
            </h1>
          </div>

          <div class="hero-bottom">
            <p class="hero-copy">
              Barkly Labs is an independent technology laboratory
              building systems for people — and building the
              infrastructure that makes experimentation possible.
            </p>

            <div class="hero-mark">
              HUMAN<br />
              FIRST
            </div>
          </div>
        </section>


        <!-- PURPOSE -->

        <section class="content-section" id="purpose">
          <div class="section-heading">
            <span class="section-number">02</span>

            <div>
              <span class="eyebrow">WHY BARKLY EXISTS</span>

              <h2>
                TECH<br />
                SHOULD
              </h2>

              <h2><span>HELP.</span></h2>
            </div>
          </div>

          <div class="section-body">
            <p class="large-copy">
              Technology should make human life more possible,
              not more difficult.
            </p>

            <p>
              Barkly Labs exists because powerful technology is
              often designed around systems, markets, or technical
              capabilities before the people who have to live with it.
            </p>

            <p>
              We build differently.
            </p>

            <p>
              People are treated as part of the system from the
              beginning — their needs, limitations, creativity,
              accessibility, understanding, and agency all matter.
            </p>
          </div>
        </section>


        <!-- THE LAB -->

        <section class="content-section lab-section" id="lab">
          <div class="section-heading">
            <span class="section-number">03</span>

            <div>
              <span class="eyebrow">THE LABORATORY</span>

              <h2>
                BUILD.<br />
                <span>LEARN.</span><br />
                REPEAT.
              </h2>
            </div>
          </div>

          <div class="lab-content">
            <div class="lab-intro">
              <p class="large-copy">
                Barkly is not only a company or a collection of
                software projects.
              </p>

              <p>
                It is an environment for turning ideas into systems.
              </p>
            </div>

            <div class="lab-process">
              <div>
                <span>01</span>

                <strong>BUILD</strong>

                <p>
                  Turn ideas, problems, and experiments into
                  working systems.
                </p>
              </div>

              <div>
                <span>02</span>

                <strong>TEST</strong>

                <p>
                  Put those systems in front of real humans and
                  discover what actually works.
                </p>
              </div>

              <div>
                <span>03</span>

                <strong>DOCUMENT</strong>

                <p>
                  Preserve what was learned so knowledge does not
                  disappear with the experiment.
                </p>
              </div>

              <div>
                <span>04</span>

                <strong>SHARE</strong>

                <p>
                  Release useful work so other people can inspect,
                  improve, adapt, and build upon it.
                </p>
              </div>
            </div>
          </div>
        </section>


        <!-- SYSTEMS -->

        <section class="content-section" id="systems">
          <div class="section-heading">
            <span class="section-number">04</span>

            <div>
              <span class="eyebrow">THE ECOSYSTEM</span>

              <h2>
                ONE LAB.<br />
                <span>MANY SYSTEMS.</span>
              </h2>
            </div>
          </div>

          <div class="ecosystem-content">
            <p class="large-copy">
              Barkly Labs is built as an ecosystem rather than
              a single product.
            </p>

            <div class="system-list">

              <a
                href={import.meta.env.BASE_URL + "cyn-x"}
                class="system-card"
              >
                <div>
                  <span class="system-number">01</span>
                  <strong>CYN-X</strong>
                </div>

                <p>
                  AI systems and experimentation built around
                  human-centered interaction.
                </p>

                <small>AI / RESEARCH / EXPERIMENTATION</small>
              </a>


              <a
                href={import.meta.env.BASE_URL + "docs"}
                class="system-card"
              >
                <div>
                  <span class="system-number">02</span>
                  <strong>BARKLY DOCS</strong>
                </div>

                <p>
                  Documentation infrastructure for understanding
                  how systems are built and how they work.
                </p>

                <small>
                  DOCUMENTATION / KNOWLEDGE / INFRASTRUCTURE
                </small>
              </a>


              <a
                href={import.meta.env.BASE_URL + "laas"}
                class="system-card"
              >
                <div>
                  <span class="system-number">03</span>
                  <strong>LAAS</strong>
                </div>

                <p>
                  Laboratory as a Service — infrastructure,
                  environments, tools, and technical capability
                  for experimentation.
                </p>

                <small>
                  LABORATORY / SERVICES / EXPERIMENTATION
                </small>
              </a>


              <a
                href={import.meta.env.BASE_URL + "standard"}
                class="system-card"
              >
                <div>
                  <span class="system-number">04</span>
                  <strong>PAW-HC</strong>
                </div>

                <p>
                  People Are Worth Designing For — Barkly's
                  human-centered AI engineering standard.
                </p>

                <small>
                  STANDARD / HUMAN-CENTERED / ENGINEERING
                </small>
              </a>

            </div>
          </div>
        </section>


        <!-- PEOPLE -->

        <section
          class="content-section people-section"
          id="people"
        >
          <div class="section-heading">
            <span class="section-number">05</span>

            <div>
              <span class="eyebrow">THE PEOPLE</span>

              <h2>
                BUILT FOR<br />
                <span>HUMANS.</span>
              </h2>
            </div>
          </div>

          <div class="people-content">
            <p class="large-copy">
              Barkly is being built before the community arrives.
            </p>

            <p>
              The goal is not to manufacture a community around
              an empty brand. The goal is to build a real laboratory
              that gives people something worth contributing to.
            </p>

            <p>
              Builders, artists, researchers, engineers, designers,
              experimenters, and curious humans should be able to
              encounter the lab, understand how it works, and find
              a place where their own ideas can become real.
            </p>

            <div class="people-callout">
              <span>THE DOOR IS OPEN</span>

              <p>
                You do not have to already belong here to build
                something here.
              </p>
            </div>
          </div>
        </section>


        <!-- FUTURE -->

        
  <section class="content-section practice-section" id="practice">

    <div class="section-heading">

      <div class="section-number">04</div>

      <div>
        <span class="eyebrow">PRACTICE</span>

        <h2>
          BUILD<br />
          <span>WHAT COMES NEXT.</span>
        </h2>
      </div>

    </div>


    <div class="practice-copy">

      <p class="large-copy">
        Barkly Labs exists to build useful things — and to build the
        foundations that make the next useful thing possible.
      </p>

      <p>
        We build through experimentation, documentation, collaboration,
        reuse, and care. Every project is an opportunity to learn something,
        leave something behind, and make the next project easier for someone
        else to build.
      </p>

    </div>


    <div class="practice-grid">

      <div class="practice-item">
        <span>BUILD</span>
        <p>
          We turn ideas into working systems. Hardware, software,
          interfaces, infrastructure, and experiments are built to solve
          real problems and explore what technology could make possible.
        </p>
      </div>

      <div class="practice-item">
        <span>DOCUMENT</span>
        <p>
          What we build should be understandable. We document how systems
          work, why decisions were made, what we learned, and what another
          person would need to continue the work.
        </p>
      </div>

      <div class="practice-item">
        <span>EXPERIMENT</span>
        <p>
          Barkly Labs is allowed to try things. Experiments can fail,
          prototypes can change, and ideas can be replaced when we learn
          something better. Failure is information, not wasted work.
        </p>
      </div>

      <div class="practice-item">
        <span>SHARE</span>
        <p>
          When knowledge, tools, documentation, or discoveries can help
          others, we create a path for that work to leave the lab and
          become useful beyond the original project.
        </p>
      </div>

      <div class="practice-item">
        <span>REUSE</span>
        <p>
          We do not want every project to begin from zero. Components,
          infrastructure, documentation, interfaces, and lessons should
          become foundations that make future work faster and more
          accessible.
        </p>
      </div>

      <div class="practice-item">
        <span>CONNECT</span>
        <p>
          Barkly projects are designed to become part of an ecosystem.
          Systems should be able to work together while remaining useful,
          understandable, and maintainable on their own.
        </p>
      </div>

      <div class="practice-item">
        <span>DESIGN FOR PEOPLE</span>
        <p>
          Technology exists in service of people. We design around human
          needs, accessibility, cognitive load, autonomy, dignity, and the
          reality that people have different abilities and different ways
          of interacting with technology.
        </p>
      </div>

      <div class="practice-item">
        <span>LEAVE SOMETHING BEHIND</span>
        <p>
          Every project should make the future a little easier to build.
          The goal is not simply to finish a project, but to leave behind
          knowledge, infrastructure, tools, or ideas that someone else can
          build upon.
        </p>
      </div>

    </div>

  </section>



        <!-- SUPPORT -->

        <section
          class="content-section support-section"
          id="support"
        >
          <div class="section-heading">
            <span class="section-number">07</span>

            <div>
              <span class="eyebrow">SUPPORT THE LAB</span>

              <h2>
                HELP BUILD<br />
                <span>BARKLY.</span>
              </h2>
            </div>
          </div>

          <div class="support-content">

            <div class="support-intro">
              <p class="large-copy">
                Barkly Labs is being built from the ground up.
              </p>

              <p>
                The laboratory needs infrastructure, tools,
                equipment, research resources, and the ability
                to support people who want to turn ideas into
                working technology.
              </p>

              <p>
                Support helps Barkly continue building the systems
                behind the lab while keeping human-centered
                technology at the center of the work.
              </p>
            </div>


            <div class="support-principle">
              <span>THE BARKLY APPROACH</span>

              <p>
                Support should not disappear into a black box.
                The goal is to make it possible to understand
                what the lab is building, why it matters, and
                how resources help make that work possible.
              </p>
            </div>


            <div class="support-list">

              <div class="support-card">
                <div>
                  <span class="system-number">01</span>
                  <strong>INDIVIDUAL SUPPORT</strong>
                </div>

                <p>
                  Individuals can help Barkly continue building
                  open technology, research infrastructure,
                  documentation, experiments, and community
                  resources.
                </p>

                <small>
                  DONATIONS / COMMUNITY / DIRECT SUPPORT
                </small>
              </div>


              <div class="support-card">
                <div>
                  <span class="system-number">02</span>
                  <strong>LAB SPONSORSHIP</strong>
                </div>

                <p>
                  Organizations and companies can support the
                  laboratory through sponsorships, partnerships,
                  equipment, infrastructure, or project support.
                </p>

                <small>
                  SPONSORS / PARTNERS / ORGANIZATIONS
                </small>
              </div>


              <div class="support-card">
                <div>
                  <span class="system-number">03</span>
                  <strong>WHAT SUPPORT ENABLES</strong>
                </div>

                <p>
                  Support can help fund open-source development,
                  hardware and prototyping, computing infrastructure,
                  research, documentation, standards, and programs
                  that help people build.
                </p>

                <small>
                  SOFTWARE / HARDWARE / RESEARCH / INFRASTRUCTURE
                </small>
              </div>

            </div>


            <div class="support-callout">
              <span>BUILD WITH US</span>

              <p>
                Barkly exists to make technology more possible
                for humans. Supporting the lab helps make that
                work possible too.
              </p>

              <div class="support-actions">
                <a
                  href={import.meta.env.BASE_URL + "support"}
                  class="support-button"
                >
                  SUPPORT BARKLY →
                </a>

                <a
                  href={import.meta.env.BASE_URL + "sponsors"}
                  class="support-button secondary"
                >
                  SPONSOR THE LAB →
                </a>
              </div>
            </div>

          </div>
        </section>


        <!-- FINAL -->

        <section class="final-section">
          <div class="final-label">
            BARKLY LABS / ABOUT
          </div>

          <h2>
            PEOPLE ARE<br />
            <span>WORTH DESIGNING FOR.</span>
          </h2>

          <p>
            THE LAB IS OPEN.
          </p>
        </section>

      </main>


      <!-- FOOTER -->

      <footer class="site-footer">
        <span>BARKLY LABS</span>
        <span>HUMAN FIRST</span>
        <span>DOCUMENT 000</span>
      </footer>

    </div>
  </body>
</html>


<style>


/* HOW WE BUILD */

.practice-copy {
  grid-column: 2;

  min-width: 0;
  max-width: 750px;
}

.practice-copy p {
  margin: 0;

  color: var(--muted);

  font-size: 18px;
  line-height: 1.7;
}

.practice-copy p + p {
  margin-top: 28px;
}

.practice-copy .large-copy {
  color: var(--white);
}

.practice-grid {
  grid-column: 1 / -1;

  margin-top: 80px;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.practice-item {
  min-height: 190px;

  padding: 30px;

  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);

  display: flex;
  flex-direction: column;
}

.practice-item span {
  color: var(--pink);

  font-family:
    "Courier New",
    monospace;

  font-size: 11px;
  letter-spacing: 0.12em;
}

.practice-item p {
  max-width: 420px;

  margin: auto 0 0;

  color: var(--muted);

  line-height: 1.55;
}



:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {
  margin: 0;
  background: #050505;
  color: #f1f1f1;
  font-family: Arial, Helvetica, sans-serif;
}

:root {
  --bg: #050505;
  --panel: #0a0a0a;
  --panel-raised: #0f0f0f;
  --panel-hover: #131313;
  --text: #f1f1f1;
  --white: #f1f1f1;
  --muted: #a1a1a1;
  --dim: #686868;
  --faint: #444;
  --line: rgba(255, 255, 255, 0.12);
  --line-strong: rgba(255, 255, 255, 0.25);
  --pink: #ff2f92;
  --pink-soft: rgba(255, 47, 146, 0.10);
  --pink-line: rgba(255, 47, 146, 0.42);
  --max: 1500px;
}


/* HEADER */

.site-header {
  height: 72px;
  padding: 0 4vw;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: "Courier New", monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.header-logo a {
  color: var(--white);
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.header-logo a span {
  color: var(--pink);
}

.header-logo a strong {
  color: var(--white);
}

.header-document {
  display: flex;
  gap: 10px;
  color: var(--dim);
}

.header-document span:first-child {
  color: var(--white);
}

.header-document span:last-child {
  color: var(--pink);
}


/* SIDE NAV */

.side-nav {
  position: fixed;
  left: 24px;
  top: 50%;
  z-index: 10;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.side-nav a {
  display: flex;
  gap: 9px;
  color: var(--dim);
  text-decoration: none;
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.side-nav a span {
  color: var(--pink);
}

.side-nav a:hover {
  color: var(--white);
  transform: translateX(3px);
}


/* HERO */

.hero {
  max-width: var(--max);
  min-height: 720px;
  margin: 0 auto;
  padding: 55px 10vw 100px;
  display: flex;
  flex-direction: column;
}

.section-meta {
  display: flex;
  gap: 110px;
  color: var(--dim);
  font-family: "Courier New", monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
}

.section-meta span:first-child {
  color: var(--pink);
}

.hero-title {
  margin-top: 35px;
}

.hero-title h1 {
  margin: 0;
  font-size: clamp(76px, 10vw, 150px);
  line-height: 0.88;
  letter-spacing: -0.075em;
  font-weight: 800;
}

.hero-title h1 span {
  color: var(--pink);
}

.hero-bottom {
  margin-top: 90px;
  display: grid;
  grid-template-columns:
    minmax(0, 760px)
    minmax(0, 1fr);
  gap: 80px;
  align-items: end;
}

.hero-copy {
  max-width: 800px;
  margin: 0;
  color: var(--muted);
  font-size: clamp(20px, 2vw, 29px);
  line-height: 1.55;
}

.hero-mark {
  justify-self: end;
  color: var(--pink);
  font-size: 32px;
  line-height: 0.9;
  font-weight: 800;
  letter-spacing: -0.05em;
}


/* GENERAL SECTIONS */

.content-section {
  max-width: var(--max);
  margin: 0 auto;
  padding: 130px 10vw;
  border-top: 1px solid var(--line);
  display: grid;
  grid-template-columns:
    minmax(280px, 0.8fr)
    minmax(0, 1.2fr);
  gap: 80px;
}


/* HEADINGS */

.section-heading {
  min-width: 0;
  display: flex;
  gap: 25px;
}

.section-heading > div:last-child {
  min-width: 0;
}

.section-number {
  flex-shrink: 0;
  color: var(--pink);
  font-family: "Courier New", monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
}

.eyebrow {
  display: block;
  margin-bottom: 20px;
  color: var(--dim);
  font-family: "Courier New", monospace;
  font-size: 10px;
  letter-spacing: 0.14em;
}

.section-heading h2 {
  max-width: 100%;
  margin: 0;
  font-size: clamp(45px, 5vw, 78px);
  line-height: 0.92;
  letter-spacing: -0.06em;
}

.section-heading h2 span {
  color: var(--pink);
}


/* BODY */

.section-body,
.lab-content,
.ecosystem-content,
.people-content,
.future-content,
.support-content {
  min-width: 0;
  max-width: 800px;
}

.section-body p,
.people-content p,
.future-content p,
.lab-intro p,
.support-content p {
  color: var(--muted);
  font-size: 18px;
  line-height: 1.7;
}

.large-copy {
  color: var(--white) !important;
  font-size: 30px !important;
  line-height: 1.35 !important;
  letter-spacing: -0.02em;
}


/* LAB */

.lab-intro {
  margin-bottom: 75px;
}

.lab-process {
  border-top: 1px solid var(--line);
}

.lab-process > div {
  padding: 28px 0;
  border-bottom: 1px solid var(--line);
  display: grid;
  grid-template-columns: 50px 180px minmax(0, 1fr);
  gap: 25px;
  align-items: start;
}

.lab-process span,
.system-number {
  color: var(--pink);
  font-family: "Courier New", monospace;
  font-size: 10px;
}

.lab-process strong {
  color: var(--white);
  font-size: 16px;
  letter-spacing: 0.04em;
}

.lab-process p {
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.6;
}


/* SYSTEMS */

