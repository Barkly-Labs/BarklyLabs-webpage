---
const projects = [
  {
    number: "01",
    name: "CYN-X",
    type: "ADAPTIVE AI SYSTEM",
    description:
      "A local-first AI system exploring how artificial intelligence can become a useful human interface rather than another layer of complexity.",
    tags: ["AI", "LOCAL COMPUTING", "HUMAN INTERFACE"],
  },
  {
    number: "02",
    name: "PAWBOARD",
    type: "MODULAR SOCIAL PLATFORM",
    description:
      "A modular social-computing platform designed to give old phones and forgotten hardware a new purpose as connected human-interface nodes.",
    tags: ["SOCIAL COMPUTING", "REUSE", "MODULAR SYSTEMS"],
  },
  {
    number: "03",
    name: "SECUSERVE",
    type: "INFRASTRUCTURE",
    description:
      "Systems work focused on making infrastructure understandable, controllable, and useful to the people operating it.",
    tags: ["INFRASTRUCTURE", "OPEN SOURCE", "SYSTEMS"],
  },
  {
    number: "04",
    name: "SMART GARDEN",
    type: "EMBEDDED SYSTEM",
    description:
      "An exploration of sensors, automation, local computing, and physical interfaces that connect software with the real world.",
    tags: ["IOT", "SENSORS", "AUTOMATION"],
  },
];

const interests = [
  "Artificial Intelligence",
  "Human–Computer Interaction",
  "Open Source",
  "Software Engineering",
  "Embedded Systems",
  "Computer Vision",
  "Automation",
  "Accessibility",
  "Creative Technology",
  "Interface Design",
  "Local Computing",
  "Community Technology",
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="About Piper and Barkly Labs — human-centered technology, open source systems, CYN-X, PawBoard, and experimental computing."
    />
    <title>ABOUT / PIPER — BARKLY LABS</title>
  </head>

  <body>
    <div class="site-shell">

      <!-- HEADER -->
      <header class="header">
        <a href="/" class="logo">BARKLY<span>_LABS</span></a>

        <nav>
          <a href="/">HOME</a>
          <a href="/projects">PROJECTS</a>
          <a href="/docs">DOCS</a>
        </nav>

        <div class="status">
          <span class="status-dot"></span>
          SYSTEM ONLINE
        </div>
      </header>


      <!-- HERO -->
      <main>

        <section class="hero">
          <div class="hero-label">
            <span>00</span>
            ABOUT / PIPER
          </div>

          <div class="hero-grid">
            <div>
              <h1>
                HI,<br />
                I'M <span>PIPER.</span>
              </h1>
            </div>

            <div class="hero-side">
              <div class="terminal-line">
                &gt; INITIALIZING HUMAN_INTERFACE...
              </div>

              <p>
                I'm a software engineer, builder, designer, and systems
                thinker interested in what happens when technology is designed
                around humans instead of the other way around.
              </p>

              <div class="location">
                <span>LOCATION</span>
                DETROIT, MICHIGAN
              </div>
            </div>
          </div>
        </section>


        <!-- 01 PERSON -->
        <section class="section">
          <div class="section-number">01</div>

          <div class="section-content">
            <div class="section-heading">
              <span>THE PERSON</span>
              <h2>CURIOUS<br />BY DEFAULT.</h2>
            </div>

            <div class="section-text">
              <p>
                I like taking things apart until I understand why they work.
                Then I usually want to rebuild them differently.
              </p>

              <p>
                My interests live somewhere between software engineering,
                artificial intelligence, interface design, embedded systems,
                open source technology, and creative experimentation.
              </p>

              <p>
                I'm especially interested in the space where complicated
                technical systems meet actual human beings.
              </p>

              <div class="quote">
                "Technology should feel like a tool someone can understand —
                not a machine they have to fight."
              </div>
            </div>
          </div>
        </section>


        <!-- 02 ABOUT ME -->
        <section class="section">
          <div class="section-number">02</div>

          <div class="section-content">
            <div class="section-heading">
              <span>ABOUT ME</span>
              <h2>BUILDING<br />WITH INTENT.</h2>
            </div>

            <div class="section-text">
              <p>
                I don't really separate engineering from design.
              </p>

              <p>
                A system can technically work and still be difficult,
                confusing, inaccessible, or hostile to the person using it.
              </p>

              <p>
                That's where my work tends to begin.
              </p>

              <p>
                I want to understand the entire stack — from the hardware,
                networking, and infrastructure underneath a system to the
                interface a human actually touches.
              </p>
            </div>
          </div>
        </section>


        <!-- 03 INTERESTS -->
        <section class="section">
          <div class="section-number">03</div>

          <div class="section-content">
            <div class="section-heading">
              <span>INTERESTS</span>
              <h2>THE<br />TOOLBOX.</h2>
            </div>

            <div class="interest-grid">
              {
                interests.map((interest, index) => (
                  <div class="interest">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {interest}
                  </div>
                ))
              }
            </div>
          </div>
        </section>


        <!-- 04 PROJECTS -->
        <section class="section projects-section">
          <div class="section-number">04</div>

          <div class="section-content">
            <div class="section-heading">
              <span>PROJECTS</span>
              <h2>THINGS<br />I'M BUILDING.</h2>
            </div>

            <div class="projects">
              {
                projects.map((project) => (
                  <article class="project-card">
                    <div class="project-top">
                      <span>{project.number}</span>
                      <span>{project.type}</span>
                    </div>

                    <h3>{project.name}</h3>

                    <p>{project.description}</p>

                    <div class="tags">
                      {
                        project.tags.map((tag) => (
                          <span>{tag}</span>
                        ))
                      }
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </section>


        <!-- 05 PAWBOARD -->
        <section class="section pawboard-section">
          <div class="section-number">05</div>

          <div class="section-content">

            <div class="section-heading">
              <span>PAWBOARD</span>
              <h2>OLD<br />HARDWARE.<br />NEW LIFE.</h2>
            </div>

            <div class="pawboard-intro">
              <div class="terminal-box">
                <div>&gt; SYSTEM: PAWBOARD</div>
                <div>&gt; MODE: MODULAR_SOCIAL_COMPUTING</div>
                <div>&gt; HARDWARE: REPURPOSED</div>
                <div>&gt; STATUS: BUILDING</div>
              </div>

              <div class="section-text">
                <p>
                  PawBoard is a modular social-computing platform built around
                  an intentionally simple idea:
                </p>

                <p class="large-statement">
                  <strong>
                    What if old phones didn't become electronic waste —
                    what if they became parts of a new computer?
                  </strong>
                </p>

                <p>
                  Instead of treating a phone as one disposable device,
                  PawBoard treats hardware as a collection of capabilities
                  that can participate in a larger system.
                </p>

                <p>
                  A phone can become a display. A camera. A sensor. A
                  controller. A notification terminal. A media node. An
                  accessibility interface. A gateway.
                </p>

                <p>
                  Multiple devices can then work together over a local
                  network as one modular environment.
                </p>
              </div>
            </div>


            <!-- PAWBOARD ARCHITECTURE -->
            <div class="architecture">

              <div class="architecture-title">
                PAWBOARD / SYSTEM MODEL
              </div>

              <div class="architecture-core">
                <span>PAWBOARD CORE</span>

                <div class="core-items">
                  <span>IDENTITY</span>
                  <span>MESSAGING</span>
                  <span>COMMUNITIES</span>
                  <span>EVENTS</span>
                  <span>MODULES</span>
                  <span>PERMISSIONS</span>
                  <span>SYNC</span>
                  <span>STORAGE</span>
                </div>
              </div>

              <div class="node-grid">

                <div class="node">
                  <span>NODE_01</span>
                  <strong>DISPLAY</strong>
                  <small>UI / DASHBOARD</small>
                </div>

                <div class="node">
                  <span>NODE_02</span>
                  <strong>CAMERA</strong>
                  <small>VISION / MEDIA</small>
                </div>

                <div class="node">
                  <span>NODE_03</span>
                  <strong>SENSOR</strong>
                  <small>ENVIRONMENT</small>
                </div>

                <div class="node">
                  <span>NODE_04</span>
                  <strong>CONTROLLER</strong>
                  <small>INPUT / AUTOMATION</small>
                </div>

              </div>

              <div class="architecture-footer">
                LOCAL NETWORK / MODULAR NODES / HUMAN INTERFACE
              </div>

            </div>


            <div class="pawboard-principles">

              <div>
                <span>01</span>
                <strong>REUSE</strong>
                <p>
                  Hardware doesn't stop being useful just because its
                  original software became obsolete.
                </p>
              </div>

              <div>
                <span>02</span>
                <strong>MODULARITY</strong>
                <p>
                  People should be able to assemble systems from the
                  capabilities they actually need.
                </p>
              </div>

              <div>
                <span>03</span>
                <strong>LOCAL FIRST</strong>
                <p>
                  Devices should be able to communicate locally without
                  requiring every interaction to pass through a distant
                  server.
                </p>
              </div>

              <div>
                <span>04</span>
                <strong>HUMAN FIRST</strong>
                <p>
                  The system should adapt to the person using it.
                </p>
              </div>

            </div>

          </div>
        </section>


        <!-- 06 THE QUESTION -->
        <section class="section">
          <div class="section-number">06</div>

          <div class="section-content">
            <div class="section-heading">
              <span>THE QUESTION</span>
              <h2>WHAT IF<br />WE BUILT<br />DIFFERENTLY?</h2>
            </div>

            <div class="question-content">

              <p class="question-large">
                What if technology wasn't designed around what corporations
                need people to do?
              </p>

              <p>
                What if it was designed around what people actually need?
              </p>

              <p>
                That question connects a lot of my projects.
              </p>

              <p>
                CYN-X asks how AI can become a more understandable and
                adaptable interface.
              </p>

              <p>
                PawBoard asks how old hardware can become part of a new,
                modular social-computing environment.
              </p>

              <p>
                Barkly Labs asks what happens when these ideas are developed
                openly and shared with other builders.
              </p>

            </div>
          </div>
        </section>


        <!-- 07 HOW I WORK -->
        <section class="section">
          <div class="section-number">07</div>

          <div class="section-content">

            <div class="section-heading">
              <span>HOW I WORK</span>
              <h2>BUILD.<br />BREAK.<br />UNDERSTAND.</h2>
            </div>

            <div class="workflow">

              <div class="workflow-step">
                <span>01</span>
                <h3>QUESTION</h3>
                <p>
                  Start with the problem instead of immediately choosing the
                  technology.
                </p>
              </div>

              <div class="workflow-step">
                <span>02</span>
                <h3>PROTOTYPE</h3>
                <p>
                  Build something tangible enough to interact with.
                </p>
              </div>

              <div class="workflow-step">
                <span>03</span>
                <h3>BREAK</h3>
                <p>
                  Find where the system becomes confusing, fragile, or
                  inaccessible.
                </p>
              </div>

              <div class="workflow-step">
                <span>04</span>
                <h3>ITERATE</h3>
                <p>
                  Improve the system around what humans actually experience.
                </p>
              </div>

            </div>

          </div>
        </section>


        <!-- 08 DESIGN PRINCIPLES -->
        <section class="section">
          <div class="section-number">08</div>

          <div class="section-content">

            <div class="section-heading">
              <span>DESIGN PRINCIPLES</span>
              <h2>THE<br />RULES.</h2>
            </div>

            <div class="principles">

              <div class="principle">
                <span>01</span>
                <strong>HUMANS FIRST</strong>
                <p>
                  Technology exists to serve people.
                </p>
              </div>

              <div class="principle">
                <span>02</span>
                <strong>MAKE IT UNDERSTANDABLE</strong>
                <p>
                  Complexity should not require obscurity.
                </p>
              </div>

              <div class="principle">
                <span>03</span>
                <strong>OPEN WHEN POSSIBLE</strong>
                <p>
                  Knowledge becomes more useful when people can inspect,
                  modify, and share it.
                </p>
              </div>

              <div class="principle">
                <span>04</span>
                <strong>LOCAL WHEN PRACTICAL</strong>
                <p>
                  Not everything needs to leave the device.
                </p>
              </div>

              <div class="principle">
                <span>05</span>
                <strong>ACCESSIBILITY IS DESIGN</strong>
                <p>
                  Accessibility isn't an optional layer added later.
                </p>
              </div>

              <div class="principle">
                <span>06</span>
                <strong>REUSE WHAT EXISTS</strong>
                <p>
                  Old hardware can still become part of something new.
                </p>
              </div>

            </div>

          </div>
        </section>


        <!-- 09 DETROIT -->
        <section class="section detroit-section">
          <div class="section-number">09</div>

          <div class="section-content">

            <div class="section-heading">
              <span>DETROIT</span>
              <h2>BUILT<br />WHERE I<br />LIVE.</h2>
            </div>

            <div class="section-text">

              <p>
                Detroit is more than a location in my work.
              </p>

              <p>
                It's part of how I think about technology.
              </p>

              <p>
                A city full of existing infrastructure, existing knowledge,
                existing people, and existing things that can be repaired,
                reused, rebuilt, and connected in new ways.
              </p>

              <p>
                That perspective carries directly into my approach to
                computing.
              </p>

              <div class="quote">
                BUILD WITH WHAT ALREADY EXISTS.
              </div>

            </div>

          </div>
        </section>


        <!-- 10 BARKLY LABS -->
        <section class="section barkly-section">
          <div class="section-number">10</div>

          <div class="section-content">

            <div class="section-heading">
              <span>BARKLY LABS</span>
              <h2>THE<br />PLACE<br />I'M BUILDING.</h2>
            </div>

            <div class="section-text">

              <p>
                Barkly Labs is the larger environment around these projects.
              </p>

              <p>
                It's intended to be a place where engineers, artists,
                researchers, designers, hobbyists, and curious people can
                experiment with technology without needing everything to fit
                into a traditional corporate box.
              </p>

              <p>
                Projects can be strange. They can be unfinished. They can
                overlap.
              </p>

              <p>
                The important part is that they're understandable,
                inspectable, and useful enough for someone else to build on.
              </p>

              <div class="barkly-terminal">
                <span>&gt; BARKLY_LABS</span>
                <span>&gt; OPEN_SOURCE</span>
                <span>&gt; HUMAN_CENTERED</span>
                <span>&gt; EXPERIMENTAL</span>
                <span>&gt; BUILDING_IN_PUBLIC</span>
              </div>

            </div>

          </div>
        </section>


        <!-- 11 ECOSYSTEM -->
        <section class="section">
          <div class="section-number">11</div>

          <div class="section-content">

            <div class="section-heading">
              <span>THE ECOSYSTEM</span>
              <h2>ONE IDEA.<br />MANY<br />INTERFACES.</h2>
            </div>

            <div class="ecosystem">

              <div class="eco-item">
                <strong>CYN-X</strong>
                <span>INTELLIGENCE</span>
              </div>

              <div class="eco-connector">+</div>

              <div class="eco-item">
                <strong>PAWBOARD</strong>
                <span>HARDWARE + SOCIAL</span>
              </div>

              <div class="eco-connector">+</div>

              <div class="eco-item">
                <strong>BARKLY LABS</strong>
                <span>COMMUNITY</span>
              </div>

            </div>

            <p class="ecosystem-description">
              Different projects can become different interfaces into the
              same larger philosophy: technology that adapts to humans.
            </p>

          </div>
        </section>


        <!-- 12 FUTURE -->
        <section class="section">
          <div class="section-number">12</div>

          <div class="section-content">

            <div class="section-heading">
              <span>WHAT'S NEXT</span>
              <h2>STILL<br />BUILDING.</h2>
            </div>

            <div class="future-grid">

              <div>
                <span>01</span>
                <p>
                  Expand CYN-X into a broader local AI environment.
                </p>
              </div>

              <div>
                <span>02</span>
                <p>
                  Turn PawBoard into a real modular platform for repurposed
                  hardware.
                </p>
              </div>

              <div>
                <span>03</span>
                <p>
                  Build reusable open-source infrastructure around the
                  projects.
                </p>
              </div>

              <div>
                <span>04</span>
                <p>
                  Create tools that make complicated systems easier for
                  ordinary humans to understand.
                </p>
              </div>

            </div>

          </div>
        </section>


        <!-- CTA -->
        <section class="cta">

          <div class="cta-label">END OF ABOUT_PAGE</div>

          <h2>
            THERE'S<br />
            MORE TO<br />
            BUILD.
          </h2>

          <p>
            This isn't a finished system.
            <br />
            It's a place to start.
          </p>

          <div class="cta-links">
            <a href="/projects">EXPLORE PROJECTS →</a>
            <a href="/docs">READ THE DOCS →</a>
          </div>

        </section>

      </main>


      <!-- FOOTER -->
      <footer>

        <div>
          BARKLY_LABS / PIPER
        </div>

        <div>
          HUMAN-CENTERED TECHNOLOGY
        </div>

        <div>
          © 2026
        </div>

      </footer>

    </div>


    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        {
          threshold: 0.08,
        }
      );

      document
        .querySelectorAll(".section, .project-card, .principle, .workflow-step")
        .forEach((element) => observer.observe(element));
    </script>

  </body>


  <style>

    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #050505;
      color: #f5f5f5;
      font-family:
        "IBM Plex Mono",
        "SFMono-Regular",
        Consolas,
        "Liberation Mono",
        monospace;
    }

    :global(a) {
      color: inherit;
      text-decoration: none;
    }

    .site-shell {
      min-height: 100vh;
      overflow: hidden;
      background:
        linear-gradient(
          rgba(255, 255, 255, 0.018) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.018) 1px,
          transparent 1px
        );
      background-size: 40px 40px;
    }


    /* HEADER */

    .header {
      height: 72px;
      border-bottom: 1px solid #262626;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5vw;
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(5, 5, 5, 0.94);
      backdrop-filter: blur(12px);
    }

    .logo {
      font-weight: 900;
      letter-spacing: -0.08em;
      font-size: 1rem;
    }

    .logo span {
      opacity: 0.4;
    }

    nav {
      display: flex;
      gap: 28px;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }

    nav a {
      opacity: 0.5;
      transition: opacity 0.2s ease;
    }

    nav a:hover,
    nav a.active {
      opacity: 1;
    }

    .status {
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      opacity: 0.55;
    }

    .status-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      background: #fff;
      border-radius: 50%;
      margin-right: 7px;
      box-shadow: 0 0 10px #fff;
    }


    /* HERO */

    .hero {
      min-height: 90vh;
      padding: 9vw 5vw 10vw;
      border-bottom: 1px solid #262626;
      position: relative;
    }

    .hero-label,
    .section-number {
      font-size: 0.65rem;
      letter-spacing: 0.14em;
      opacity: 0.45;
    }

    .hero-label {
      display: flex;
      gap: 20px;
      margin-bottom: 12vh;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.6fr;
      gap: 8vw;
      align-items: end;
    }

    h1 {
      font-size: clamp(5rem, 13vw, 13rem);
      line-height: 0.78;
      letter-spacing: -0.09em;
      margin: 0;
      font-weight: 900;
    }

    h1 span {
      -webkit-text-stroke: 1px #fff;
      color: transparent;
    }

    .hero-side {
      max-width: 460px;
      padding-bottom: 8px;
    }

    .terminal-line {
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      margin-bottom: 30px;
      opacity: 0.45;
    }

    .hero-side p,
    .section-text p {
      line-height: 1.8;
      color: #aaa;
      font-size: 0.9rem;
    }

    .location {
      margin-top: 40px;
      padding-top: 15px;
      border-top: 1px solid #333;
      font-size: 0.7rem;
    }

    .location span {
      display: block;
      opacity: 0.35;
      margin-bottom: 8px;
    }


    /* SECTIONS */

    .section {
      display: grid;
      grid-template-columns: 12% 88%;
      padding: 10vw 5vw;
      border-bottom: 1px solid #262626;

      opacity: 0;
      transform: translateY(30px);
      transition:
        opacity 0.8s ease,
        transform 0.8s ease;
    }

    .section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .section-content {
      max-width: 1300px;
      width: 100%;
    }

    .section-heading {
      display: grid;
      grid-template-columns: 0.5fr 1fr;
      gap: 4vw;
      margin-bottom: 6vw;
    }

    .section-heading > span {
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      opacity: 0.4;
    }

    h2 {
      margin: 0;
      font-size: clamp(3rem, 7vw, 8rem);
      line-height: 0.82;
      letter-spacing: -0.075em;
    }

    .section-text {
      max-width: 700px;
      margin-left: auto;
    }

    .quote {
      margin-top: 50px;
      padding: 30px;
      border-left: 2px solid #fff;
      font-size: 1.2rem;
      line-height: 1.5;
      color: #ddd;
    }


    /* INTERESTS */

    .interest-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid #333;
      border-left: 1px solid #333;
    }

    .interest {
      min-height: 110px;
      border-right: 1px solid #333;
      border-bottom: 1px solid #333;
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      font-size: 0.8rem;
    }

    .interest span {
      opacity: 0.3;
      font-size: 0.6rem;
    }


