---
import SEO from "../components/SEO.astro";
const year = new Date().getFullYear();
const home = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <title>Service Status | Barkly Labs</title>
    <meta name="description" content="A human-centered status page for Barkly Labs services." />
    <SEO title="Service Status | Barkly Labs" description="A human-centered status page for Barkly Labs services." />
  </head>
  <body>
    <header class="nav-wrap">
      <nav class="nav" aria-label="Main navigation">
        <a href={home} class="brand" aria-label="Barkly Labs home">
          <span class="brand-symbol" aria-hidden="true">◆</span><span>BARKLY LABS</span>
        </a>
        <div class="nav-links">
          <a href={`${home}#principles`}>PHILOSOPHY</a>
          <a href={`${home}#systems`}>SYSTEMS</a>
          <a href={`${home}#lab`}>THE LAB</a>
          <a href={`${home}#process`}>PROCESS</a>
          <a href={`${home}#community`}>COMMUNITY</a>
          <a href={`${home}#detroit`}>DETROIT</a>
        </div>
        <a href={`${home}#about`} class="nav-status"><span class="status-dot"></span> HUMAN-FIRST</a>
      </nav>
    </header>

    <main class="page-shell">
      <div class="eyebrow"><span>STATUS / 01</span><span class="eyebrow-line"></span><span>THE LAB</span></div>
      <section class="intro">
        <p class="kicker">BARKLY LABS · SERVICE STATUS</p>
        <h1>A LITTLE WINDOW<br /><span>INTO THE LAB.</span></h1>
        <p class="lead">A live look at the small systems that keep the work moving. Clear signals, no panic, and people always come first.</p>
      </section>

      <section class="status-overview" aria-labelledby="overview-title">
        <div class="overview-copy">
          <span class="section-kicker">CURRENT OVERVIEW</span>
          <h2 id="overview-title">Systems check</h2>
          <p id="summary" aria-live="polite">Status has not been checked yet.</p>
        </div>
        <button id="refresh" class="button button-primary" type="button"><span aria-hidden="true">↻</span> CHECK AGAIN</button>
      </section>

      <section class="services" aria-label="Hosted services">
        <article class="service-card" data-service="website" data-url={home} data-kind="page">
          <div class="card-top"><span class="service-index">01 / PUBLIC</span><span class="service-mark" aria-hidden="true">↗</span></div>
          <div class="service-icon" aria-hidden="true">◆</div>
          <p class="service-type">ASTRO · MAIN SITE</p>
          <h2>Barkly Labs Website</h2>
          <p class="service-description">The public front door to our human-centered technology work.</p>
          <div class="service-bottom"><span class="state-dot" aria-hidden="true"></span><span class="state-label" aria-live="polite">Not checked yet</span></div>
          <a class="card-link" href={home} aria-label="Open Barkly Labs website">OPEN WEBSITE <span aria-hidden="true">↗</span></a>
        </article>

        <article class="service-card" data-service="worklog" data-url={`${home}worklog/health`} data-kind="health">
          <div class="card-top"><span class="service-index">02 / WORKSPACE</span><span class="service-mark" aria-hidden="true">⌘</span></div>
          <div class="service-icon terminal-icon" aria-hidden="true">&gt;_</div>
          <p class="service-type">Barkly WORK LOGGER</p>
          <h2>Independent Work Log</h2>
          <p class="service-description">A Time recored of My Work hours.</p>
          <div class="service-bottom"><span class="state-dot" aria-hidden="true"></span><span class="state-label" aria-live="polite">Not checked yet</span></div>
          <a class="card-link" href={`${home}worklog/`} aria-label="Open Independent Work Log">OPEN WORK LOG <span aria-hidden="true">↗</span></a>
        </article>
      </section>

      <section class="human-note">
        <span class="note-mark" aria-hidden="true">✳</span>
        <div><p class="section-kicker">A HUMAN-FIRST SYSTEM</p><h2>People are people, not numbers.</h2><p>Status checks should make systems easier to understand—not make people feel like they have to understand everything at once.</p></div>
      </section>
      <p class="last-checked" id="last-checked">No checks run yet.</p>
    </main>

    <footer class="footer">
      <div class="footer-main"><div class="footer-brand"><div class="footer-logo">BARKLY</div><div class="footer-labs">LABS</div></div><div class="footer-tagline">WHERE IMAGINATION<br />BECOMES ENGINEERING.</div></div>
      <div class="footer-bottom"><span>© {year} BARKLY LABS</span><span>TECHNOLOGY SHOULD ADAPT TO HUMANS.</span><a href={home}>BACK TO MAIN SITE ↑</a></div>
    </footer>

    <script>
      const refreshButton = document.querySelector<HTMLButtonElement>("#refresh");
      const summary = document.querySelector<HTMLElement>("#summary");
      const lastChecked = document.querySelector<HTMLElement>("#last-checked");
      const cards = Array.from(document.querySelectorAll<HTMLElement>(".service-card"));

      function setState(card: HTMLElement, state: "online" | "offline" | "unknown", label: string) {
        card.dataset.state = state;
        const stateLabel = card.querySelector<HTMLElement>(".state-label");
        if (stateLabel) stateLabel.textContent = label;
      }

      async function checkService(card: HTMLElement) {
        const url = card.dataset.url;
        const kind = card.dataset.kind;
        if (!url) return "unknown" as const;
        setState(card, "unknown", "Checking…");
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 4500);
        try {
          const response = await fetch(url, { method: kind === "page" ? "HEAD" : "GET", cache: "no-store", signal: controller.signal });
          // A 401/403 still proves the service answered; it may simply require authentication.
          const healthy = response.ok || response.status === 401 || response.status === 403;
          setState(card, healthy ? "online" : "offline", healthy ? "Responding" : `HTTP ${response.status}`);
          return healthy ? "online" as const : "offline" as const;
        } catch {
          setState(card, "offline", "Could not reach service");
          return "offline" as const;
        } finally {
          window.clearTimeout(timeout);
        }
      }

      async function checkAll() {
        if (refreshButton) refreshButton.setAttribute("disabled", "true");
        if (summary) summary.textContent = "Checking the two services…";
        const results = await Promise.all(cards.map(checkService));
        const online = results.filter((result) => result === "online").length;
        if (summary) summary.textContent = online === results.length ? "Both services are responding." : `${online} of ${results.length} services are responding.`;
        if (lastChecked) lastChecked.textContent = `LAST CHECKED · ${new Date().toLocaleString()}`;
        if (refreshButton) refreshButton.removeAttribute("disabled");
      }

      refreshButton?.addEventListener("click", checkAll);
      checkAll();
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #050505; scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #050505; color: #f2f2f2; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible), :global(button:focus-visible) { outline: 2px solid #ff4fa3; outline-offset: 4px; }
  .nav-wrap { position: sticky; top: 0; z-index: 10; background: rgba(5,5,5,.94); backdrop-filter: blur(14px); }
  .nav { display:flex; align-items:center; justify-content:space-between; gap:24px; width:100%; padding:24px 5vw; border-bottom:1px solid rgba(255,255,255,.08); }
  .brand { display:flex; align-items:center; gap:10px; white-space:nowrap; font-family:"Courier New",monospace; font-size:11px; font-weight:700; letter-spacing:.18em; }
  .brand-symbol { color:#ff4fa3; font-size:14px; }
  .nav-links { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:clamp(12px, 1.8vw, 28px); }
  .nav-links a, .nav-status { color:rgba(255,255,255,.54); font-family:"Courier New",monospace; font-size:9px; letter-spacing:.12em; transition:color .2s; }
  .nav-links a:hover, .nav-status:hover { color:#ff4fa3; }
  .nav-status { display:flex; align-items:center; gap:8px; white-space:nowrap; }
  .status-dot { width:6px; height:6px; border-radius:50%; background:#ff4fa3; box-shadow:0 0 12px rgba(255,79,163,.7); }
  .page-shell { width:min(1120px, 90vw); margin:0 auto; padding:76px 0 90px; }
  .eyebrow { display:flex; align-items:center; gap:14px; color:#ff4fa3; font:10px "Courier New",monospace; letter-spacing:.16em; }
  .eyebrow-line { height:1px; width:52px; background:#ff4fa3; opacity:.7; }
  .intro { max-width:800px; padding:54px 0 48px; }
  .kicker, .section-kicker { color:#ff4fa3; font:10px "Courier New",monospace; letter-spacing:.16em; }
  h1 { margin:18px 0 20px; font-size:clamp(42px, 7vw, 82px); line-height:.98; letter-spacing:-.065em; font-weight:650; }
  h1 span { color:#ff4fa3; }
  .lead { max-width:610px; color:#a5a5aa; font-size:clamp(15px, 1.6vw, 18px); line-height:1.8; }
  .status-overview { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:22px 0; border-top:1px solid #262626; border-bottom:1px solid #262626; }
  .status-overview h2 { margin:8px 0 5px; font-size:22px; font-weight:550; }
  .status-overview p { margin:0; color:#a5a5aa; font-size:13px; }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:42px; padding:0 17px; border:1px solid #ff4fa3; font:10px "Courier New",monospace; letter-spacing:.1em; }
  .button-primary { background:#ff4fa3; color:#050505; transition:background .2s, color .2s; }
  .button-primary:hover { background:transparent; color:#ff4fa3; }
  .button:disabled { opacity:.55; cursor:wait; }
  .services { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:18px; padding-top:26px; }
  .service-card { position:relative; display:flex; flex-direction:column; min-height:340px; padding:24px; border:1px solid #2a2a2d; background:linear-gradient(145deg, #101012, #080809); transition:border-color .2s, transform .2s; }
  .service-card:hover { border-color:rgba(255,79,163,.55); transform:translateY(-2px); }
  .card-top { display:flex; justify-content:space-between; align-items:center; }
  .service-index, .service-type { color:#8d8d95; font:9px "Courier New",monospace; letter-spacing:.13em; }
  .service-mark { color:#ff4fa3; font-size:18px; }
  .service-icon { display:flex; align-items:center; justify-content:center; width:48px; height:48px; margin:27px 0 20px; border:1px solid rgba(255,79,163,.4); color:#ff4fa3; font-size:20px; }
  .terminal-icon { font:16px "Courier New",monospace; }
  .service-type { margin:0 0 8px; }
  .service-card h2 { margin:0 0 10px; font-size:23px; font-weight:550; letter-spacing:-.035em; }
  .service-description { margin:0; max-width:430px; color:#a5a5aa; font-size:13px; line-height:1.7; }
  .service-bottom { display:flex; align-items:center; gap:9px; margin-top:auto; padding:25px 0 17px; color:#d4d4d8; font:10px "Courier New",monospace; letter-spacing:.05em; }
  .state-dot { width:7px; height:7px; border-radius:50%; background:#858585; }
  .service-card[data-state="online"] .state-dot { background:#62c995; box-shadow:0 0 10px rgba(98,201,149,.35); }
  .service-card[data-state="offline"] .state-dot { background:#d7a04b; }
  .service-card[data-state="unknown"] .state-dot { background:#858585; }
  .card-link { display:flex; justify-content:space-between; align-items:center; padding-top:15px; border-top:1px solid #29292c; color:#ff4fa3; font:10px "Courier New",monospace; letter-spacing:.12em; }
  .card-link:hover { color:#fff; }
  .human-note { display:flex; gap:20px; align-items:flex-start; margin-top:64px; padding:28px; border:1px solid #29292c; background:#0b0b0d; }
  .note-mark { color:#ff4fa3; font-size:26px; }
  .human-note h2 { margin:8px 0; font-size:clamp(20px, 3vw, 30px); letter-spacing:-.04em; }
  .human-note p:last-child { max-width:650px; margin-bottom:0; color:#a5a5aa; font-size:13px; line-height:1.8; }
  .last-checked { margin-top:24px; color:#77777f; text-align:right; font:9px "Courier New",monospace; letter-spacing:.1em; }
  .footer { padding:40px 5vw 22px; border-top:1px solid rgba(255,255,255,.08); }
  .footer-main { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; padding-bottom:32px; }
  .footer-logo { font-size:32px; font-weight:800; letter-spacing:-.07em; }
  .footer-labs { color:#ff4fa3; font:10px "Courier New",monospace; letter-spacing:.35em; }
  .footer-tagline { color:#aaa; font:12px/1.7 "Courier New",monospace; letter-spacing:.12em; text-align:right; }
  .footer-bottom { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; padding-top:18px; border-top:1px solid #242424; color:#777; font:9px "Courier New",monospace; letter-spacing:.08em; }
  .footer-bottom a:hover { color:#ff4fa3; }
  @media (max-width: 900px) { .nav { align-items:flex-start; flex-wrap:wrap; } .nav-links { order:3; width:100%; justify-content:flex-start; } .nav-status { margin-left:auto; } }
  @media (max-width: 620px) { .page-shell { padding-top:48px; } .nav { padding:18px 5vw; } .nav-links { gap:12px 16px; } .nav-links a { font-size:8px; } .nav-status { font-size:8px; } .status-overview { align-items:flex-start; flex-direction:column; } .services { grid-template-columns:1fr; } .service-card { min-height:310px; } .human-note { padding:20px; } .footer-main { align-items:flex-start; flex-direction:column; } .footer-tagline { text-align:left; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior:auto; } *, *::before, *::after { transition:none !important; } }
</style>
