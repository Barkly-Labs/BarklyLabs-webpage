---
import SEO from "../components/SEO.astro";

const plans = [
  {
    number: "01",
    label: "FOUNDATION",
    title: "KEEP THE<br /><span>LAB RUNNING.</span>",
    description:
      "A flexible way for individuals to help Barkly Labs maintain the infrastructure that makes experimentation possible.",
    items: [
      "Computing infrastructure",
      "Software and development tools",
      "Hosting and domains",
      "Documentation infrastructure",
      "Open-source development",
    ],
    type: "paypal",
    paypalPlanId: "P-82X56570H82375259NK6QCCQ",
  },

  {
    number: "02",
    label: "BUILDER",
    title: "BUILD<br /><span>WITH US.</span>",
    description:
      "Support Barkly Labs more deeply and help fund experimentation, prototyping, documentation, and open development.",
    items: [
      "Research and prototyping",
      "Hardware experiments",
      "Software development",
      "Open-source infrastructure",
      "Community projects",
    ],
    type: "paypal",
    paypalPlanId: "P-1DX60509Y7679734HNK7ZPGY",
  },

  {
    number: "03",
    label: "FOUNDER",
    title: "GROW THE<br /><span>ECOSYSTEM.</span>",
    description:
      "For organizations, companies, and individuals who want to help Barkly Labs grow its long-term research and community ecosystem.",
    items: [
      "Major infrastructure",
      "Research programs",
      "Hardware development",
      "Community infrastructure",
      "Long-term experimentation",
    ],
    type: "link",
    href: "/sponsors",
    action: "EXPLORE SPONSORSHIP →",
  },
];
---

<html lang="en">
  <head>
    <meta
      name="twitter:description"
      content="Explore ways to participate in, support, and build with Barkly Labs."
    />
    <meta name="twitter:title" content="Barkly Labs — Plans" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta property="og:site_name" content="Barkly Labs" />
    <meta
      property="og:url"
      content="https://www.barklylabs.space/plans/"
    />
    <meta
      property="og:description"
      content="Explore ways to participate in, support, and build with Barkly Labs."
    />
    <meta property="og:title" content="Barkly Labs — Plans" />
    <meta property="og:type" content="website" />

    <link
      rel="canonical"
      href="https://www.barklylabs.space/plans/"
    />

    <meta name="robots" content="index, follow" />

    <meta
      name="description"
      content="Explore ways to participate in, support, and build with Barkly Labs."
    />

    <title>Barkly Labs — Plans</title>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <SEO />
  </head>

  <!-- PAYPAL SUBSCRIPTIONS -->
<script
  is:inline
  src="https://www.paypal.com/sdk/js?client-id=BAAEYRnviGT0I3FZPIawR4swzp0FRet0CH4CzGr0T8mWkLh0OQRdmbPFCCkbx7QZpe4FuuQvhzNKmBr014&vault=true&intent=subscription"
  data-sdk-integration-source="button-factory"
></script>

<script is:inline>
  function renderBarklyPayPalButtons() {
    if (!window.paypal) {
      console.error("Barkly Labs: PayPal SDK failed to load.");
      return;
    }

    const containers = document.querySelectorAll(
      ".paypal-button[data-paypal-plan-id]"
    );

    containers.forEach((container) => {
      const planId = container.getAttribute("data-paypal-plan-id");

      if (!planId) {
        console.error(
          "Barkly Labs: PayPal container is missing a plan ID.",
          container
        );
        return;
      }

      if (container.dataset.paypalRendered === "true") {
        return;
      }

      container.dataset.paypalRendered = "true";

      window.paypal.Buttons({
        style: {
          shape: "rect",
          color: "gold",
          layout: "vertical",
          label: "subscribe"
        },

        createSubscription: function (data, actions) {
          return actions.subscription.create({
            plan_id: planId
          });
        },

        onApprove: function (data) {
          console.log(
            "Barkly Labs subscription approved:",
            data.subscriptionID
          );
        },

        onError: function (error) {
          console.error(
            "Barkly Labs PayPal error:",
            error
          );

          container.dataset.paypalRendered = "false";
        }
      }).render(container);
    });
  }

  function waitForPayPal() {
    if (window.paypal) {
      renderBarklyPayPalButtons();
      return;
    }

    window.setTimeout(waitForPayPal, 250);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", waitForPayPal);
  } else {
    waitForPayPal();
  }
</script>

  <body>
    <div class="page">

      <!-- HEADER -->

      <header class="site-header">
        <div class="header-logo">
          <a href={import.meta.env.BASE_URL}>
            <span>BARKLY</span> <strong>LABS</strong>
          </a>
        </div>

        <div class="header-document">
          <span>PLANS</span>
          <span>/</span>
          <span>DOCUMENT 003</span>
        </div>
      </header>


      <!-- SIDE NAV -->

      <aside class="side-nav">
        <a href="#plans">
          <span>01</span>
          PLANS
        </a>

        <a href="#foundation">
          <span>02</span>
          FOUNDATION
        </a>

        <a href="#builder">
          <span>03</span>
          BUILDER
        </a>

        <a href="#partner">
          <span>04</span>
          PARTNER
        </a>

        <a href="#principles">
          <span>05</span>
          PRINCIPLES
        </a>

        <a href="#future">
          <span>06</span>
          FUTURE
        </a>
      </aside>


      <main>

        <!-- HERO -->

        <section class="hero" id="plans">
          <div class="section-meta">
            <span>BARKLY LABS</span>
            <span>PLANS / DOCUMENT 003</span>
          </div>

          <div class="hero-title">
            <h1>
              BUILD<br />
              <span>WITH US.</span>
            </h1>
          </div>

          <div class="hero-bottom">
            <p class="hero-copy">
              Barkly Labs is built as an ecosystem.
              There are different ways to participate,
              contribute, support the infrastructure,
              and help turn experiments into useful technology.
            </p>

            <div class="hero-mark">
              MANY<br />
              PATHS
            </div>
          </div>
        </section>


        <!-- INTRO -->

        <section class="content-section intro-section">
          <div class="section-heading">
            <span class="section-number">01</span>

            <div>
              <span class="eyebrow">THE IDEA</span>

              <h2>
                ONE LAB.<br />
                <span>MANY WAYS.</span>
              </h2>
            </div>
          </div>

          <div class="section-body">
            <p class="large-copy">
              There is no single way to belong in a laboratory.
            </p>

            <p>
              Some people contribute resources. Some build software.
              Some bring hardware, research, ideas, documentation,
              experience, or simply curiosity.
            </p>

            <p>
              Barkly's plans are designed around that reality.
            </p>

            <p>
              The goal is not to turn participation into a transaction.
              The goal is to make the different ways people can help
              understandable and accessible.
            </p>
          </div>
        </section>


        <!-- PLAN GRID -->

        <section class="plans-section" id="foundation">

          <div class="plans-heading">
            <span class="eyebrow">WAYS TO PARTICIPATE</span>

            <h2>
              FIND YOUR<br />
              <span>PATH.</span>
            </h2>

            <p>
              Choose the kind of involvement that makes sense for you,
              your organization, or your project.
            </p>
          </div>


          <div class="plans-grid">

            {
              plans.map((plan, index) => (
                <article
                  class={`plan-card ${index === 0 ? "featured" : ""}`}
                  id={
                    index === 0
                      ? "foundation"
                      : index === 1
                        ? "builder"
                        : "partner"
                  }
                >

                  <div class="plan-top">
                    <span class="plan-number">
                      {plan.number}
                    </span>

                    <span class="plan-label">
                      {plan.label}
                    </span>
                  </div>

                  <h3 set:html={plan.title} />

                  <p class="plan-description">
                    {plan.description}
                  </p>

                  <div class="plan-divider"></div>

                  <div class="plan-includes">
                    <span>CAN HELP ENABLE</span>

                    <ul>
                      {plan.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                {plan.type === "paypal" ? (
                <div class="paypal-wrapper">
                        <span class="paypal-label">SUPPORT WITH PAYPAL</span>

                        <div
                        class="paypal-button"
                        id={`paypal-button-container-${plan.paypalPlanId}`}
                        data-paypal-plan-id={plan.paypalPlanId}
                        ></div>
                    </div>
                    ) : (
                    <div class="plan-action">
                        <a href={`${import.meta.env.BASE_URL}sponsors`}>
                        {plan.action}
                        </a>
                    </div>
                    )}
                </article>
              ))
            }

          </div>
        </section>


        <!-- FOUNDATION -->

        <section
          class="content-section detail-section"
          id="foundation-detail"
        >
          <div class="section-heading">
            <span class="section-number">02</span>

            <div>
              <span class="eyebrow">FOUNDATION</span>

              <h2>
                KEEP THE<br />
                <span>LAB ALIVE.</span>
              </h2>
            </div>
          </div>

          <div class="detail-content">

            <p class="large-copy">
              Infrastructure is part of the work.
            </p>

            <p>
              Servers, hosting, development tools, domains, computing
              resources, documentation systems, test equipment, and
              countless small pieces of infrastructure make
              experimentation possible.
            </p>

            <p>
              Foundation support helps Barkly maintain those systems
              so that projects can continue being built instead of
              constantly stopping to rebuild their foundations.
            </p>

            <div class="detail-callout">
              <span>THE PRINCIPLE</span>

              <p>
                Support the infrastructure that lets people
                build what comes next.
              </p>
            </div>

          </div>
        </section>


        <!-- BUILDER -->

        <section
          class="content-section detail-section builder-section"
          id="builder"
        >
          <div class="section-heading">
            <span class="section-number">03</span>

            <div>
              <span class="eyebrow">BUILDER</span>

              <h2>
                MAKE<br />
                <span>THINGS REAL.</span>
              </h2>
            </div>
          </div>

          <div class="detail-content">

            <p class="large-copy">
              Experiments need somewhere to happen.
            </p>

            <p>
              Builder support can help turn concepts into prototypes,
              prototypes into working systems, and working systems
              into documented projects.
            </p>

            <p>
              This can include hardware, software, AI systems,
              interfaces, research environments, test equipment,
              computing resources, and experimental infrastructure.
            </p>

            <div class="builder-list">

              <div>
                <span>01</span>
                <strong>SOFTWARE</strong>
                <p>
                  Applications, APIs, tools, interfaces,
                  documentation systems, and open-source projects.
                </p>
              </div>

              <div>
                <span>02</span>
                <strong>HARDWARE</strong>
                <p>
                  Prototypes, electronics, embedded systems,
                  test equipment, and physical computing.
                </p>
              </div>

              <div>
                <span>03</span>
                <strong>RESEARCH</strong>
                <p>
                  Experiments, benchmarks, standards, studies,
                  and technical investigation.
                </p>
              </div>

              <div>
                <span>04</span>
                <strong>DOCUMENTATION</strong>
                <p>
                  Knowledge infrastructure that allows work
                  to remain useful after an experiment ends.
                </p>
              </div>

            </div>

          </div>
        </section>


        <!-- PARTNER -->

        <section
          class="content-section detail-section"
          id="partner"
        >
          <div class="section-heading">
            <span class="section-number">04</span>

            <div>
              <span class="eyebrow">LAB PARTNER</span>

              <h2>
                BUILD THE<br />
                <span>ECOSYSTEM.</span>
              </h2>
            </div>
          </div>

          <div class="detail-content">

            <p class="large-copy">
              Some projects need more than one builder.
            </p>

            <p>
              Organizations, companies, researchers, educational
              institutions, and other groups can work with Barkly
              through sponsorship, equipment, infrastructure,
              research collaboration, or project partnerships.
            </p>

            <p>
              Partnerships can be structured around a specific
              project or around the broader laboratory.
            </p>

            <div class="partner-grid">

              <div>
                <span>SPONSORSHIP</span>
                <p>
                  Support a specific project, research effort,
                  or area of laboratory development.
                </p>
              </div>

              <div>
                <span>EQUIPMENT</span>
                <p>
                  Provide hardware, tools, computing resources,
                  or other equipment that enables experimentation.
                </p>
              </div>

              <div>
                <span>RESEARCH</span>
                <p>
                  Collaborate on experiments, technical research,
                  standards, or human-centered engineering.
                </p>
              </div>

              <div>
                <span>INFRASTRUCTURE</span>
                <p>
                  Help create the physical and digital systems
                  that allow the laboratory to grow.
                </p>
              </div>

            </div>

            <div class="action-row">
              <a
                href={import.meta.env.BASE_URL + "sponsors"}
                class="support-button"
              >
                SPONSOR THE LAB →
              </a>
            </div>

          </div>
        </section>


        <!-- PRINCIPLES -->

        <section
          class="content-section principles-section"
          id="principles"
        >
          <div class="section-heading">
            <span class="section-number">05</span>

            <div>
              <span class="eyebrow">THE BARKLY MODEL</span>

              <h2>
                SUPPORT<br />
                <span>WITH PURPOSE.</span>
              </h2>
            </div>
          </div>

          <div class="principles-content">

            <p class="large-copy">
              Resources should become visible work.
            </p>

            <p>
              Barkly Labs wants support to connect to real infrastructure,
              real experiments, real documentation, and real opportunities
              for people to build.
            </p>

            <div class="principles-grid">

              <div class="principle">
                <span>01</span>
                <strong>TRANSPARENT</strong>
                <p>
                  Make it possible to understand what the laboratory
                  is building and what resources make that work possible.
                </p>
              </div>

              <div class="principle">
                <span>02</span>
                <strong>HUMAN FIRST</strong>
                <p>
                  Technology remains grounded in human needs,
                  accessibility, understanding, autonomy, and dignity.
                </p>
              </div>

              <div class="principle">
                <span>03</span>
                <strong>REUSABLE</strong>
                <p>
                  Infrastructure and knowledge should become foundations
                  that make future projects easier to build.
                </p>
              </div>

              <div class="principle">
                <span>04</span>
                <strong>EXPERIMENTAL</strong>
                <p>
                  Barkly is allowed to try things, learn from failure,
                  and change direction when evidence demands it.
                </p>
              </div>

            </div>

          </div>
        </section>


        <!-- FUTURE -->

        <section
          class="content-section future-section"
          id="future"
        >
          <div class="section-heading">
            <span class="section-number">06</span>

            <div>
              <span class="eyebrow">WHAT COMES NEXT</span>

              <h2>
                THE LAB<br />
                <span>GROWS.</span>
              </h2>
            </div>
          </div>

          <div class="future-content">

            <p class="large-copy">
              These plans are a starting point, not a finished system.
            </p>

            <p>
              As Barkly Labs grows, additional programs, partnerships,
              memberships, research opportunities, equipment programs,
              and community pathways can be developed around the needs
              of the people actually using the laboratory.
            </p>

            <p>
              The infrastructure should grow with the work.
            </p>

            <div class="future-mark">
              <span>BARKLY LABS / PLAN SYSTEM</span>

              <p>
                BUILD THE FOUNDATION.<br />
                BUILD THE SYSTEM.<br />
                BUILD WHAT COMES NEXT.
              </p>
            </div>

          </div>
        </section>


        <!-- FINAL -->

        <section class="final-section">

          <div class="final-label">
            BARKLY LABS / PLANS
          </div>

          <h2>
            THERE IS<br />
            <span>ROOM TO BUILD.</span>
          </h2>

          <p>
            THE LAB IS OPEN.
          </p>

        </section>

      </main>


      <!-- FOOTER -->

      <footer class="site-footer">
        <span>BARKLY LABS</span>
        <span>HUMAN FIRST</span>
        <span>DOCUMENT 003</span>
      </footer>

    </div>
  </body>
</html>


<style>

    .plan-action {
  width: 100%;
  margin-top: auto;
  padding-top: 2rem;
}

.plan-action a {
  display: block;
  width: 100%;
  padding: 1rem 1.25rem;
  border: 1px solid #fff;
  color: #fff;
  text-decoration: none;
  text-align: center;
  font-weight: 700;
  letter-spacing: 0.08em;
  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.plan-action a:hover {
  background: #ff2f92;
  border-color: #ff2f92;
  color: #000;
}

/* PAYPAL */

.paypal-wrapper {
  width: 100%;
  margin-top: auto;
  padding-top: 35px;
}

.paypal-label {
  display: block;
  margin-bottom: 12px;
  color: var(--pink);
  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.paypal-button {
  width: 100%;
  min-height: 50px;
}

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {
  margin: 0;
  background: #050505;
  color: #f1f1f1;
  font-family: Arial, Helvetica, sans-serif;
}

:root {
  --bg: #050505;
  --panel: #0a0a0a;
  --panel-raised: #0f0f0f;
  --panel-hover: #131313;

  --text: #f1f1f1;
  --white: #f1f1f1;
  --muted: #a1a1a1;
  --dim: #686868;
  --faint: #444;

  --line: rgba(255, 255, 255, 0.12);
  --line-strong: rgba(255, 255, 255, 0.25);

  --pink: #ff2f92;
  --pink-soft: rgba(255, 47, 146, 0.1);
  --pink-line: rgba(255, 47, 146, 0.42);

  --max: 1500px;
}


/* HEADER */

.site-header {
  height: 72px;
  padding: 0 4vw;

  border-bottom: 1px solid var(--line);

  display: flex;
  align-items: center;
  justify-content: space-between;

  font-family: "Courier New", monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.header-logo a {
  color: var(--white);
  text-decoration: none;

  font-size: 14px;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.header-logo a span {
  color: var(--pink);
}

.header-logo a strong {
  color: var(--white);
}

.header-document {
  display: flex;
  gap: 10px;
  color: var(--dim);
}

.header-document span:first-child {
  color: var(--white);
}

.header-document span:last-child {
  color: var(--pink);
}


/* SIDE NAV */

.side-nav {
  position: fixed;
  left: 24px;
  top: 50%;
  z-index: 10;

  transform: translateY(-50%);

  display: flex;
  flex-direction: column;
  gap: 14px;

  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.side-nav a {
  display: flex;
  gap: 9px;

  color: var(--dim);
  text-decoration: none;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.side-nav a span {
  color: var(--pink);
}

.side-nav a:hover {
  color: var(--white);
  transform: translateX(3px);
}


/* HERO */

.hero {
  max-width: var(--max);
  min-height: 720px;

  margin: 0 auto;
  padding: 55px 10vw 100px;

  display: flex;
  flex-direction: column;
}

.section-meta {
  display: flex;
  gap: 110px;

  color: var(--dim);

  font-family: "Courier New", monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
}

.section-meta span:first-child {
  color: var(--pink);
}

.hero-title {
  margin-top: 35px;
}

.hero-title h1 {
  margin: 0;

  font-size: clamp(76px, 10vw, 150px);
  line-height: 0.88;

  letter-spacing: -0.075em;
  font-weight: 800;
}

.hero-title h1 span {
  color: var(--pink);
}

.hero-bottom {
  margin-top: 90px;

  display: grid;
  grid-template-columns:
    minmax(0, 760px)
    minmax(0, 1fr);

  gap: 80px;
  align-items: end;
}

.hero-copy {
  max-width: 800px;
  margin: 0;

  color: var(--muted);

  font-size: clamp(20px, 2vw, 29px);
  line-height: 1.55;
}

.hero-mark {
  justify-self: end;

  color: var(--pink);

  font-size: 32px;
  line-height: 0.9;

  font-weight: 800;
  letter-spacing: -0.05em;
}


/* GENERAL SECTIONS */

.content-section {
  max-width: var(--max);

  margin: 0 auto;
  padding: 130px 10vw;

  border-top: 1px solid var(--line);

  display: grid;

  grid-template-columns:
    minmax(280px, 0.8fr)
    minmax(0, 1.2fr);

  gap: 80px;
}


/* HEADINGS */

.section-heading {
  min-width: 0;

  display: flex;
  gap: 25px;
}

.section-heading > div:last-child {
  min-width: 0;
}

.section-number {
  flex-shrink: 0;

  color: var(--pink);

  font-family: "Courier New", monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
}

.eyebrow {
  display: block;

  margin-bottom: 20px;

  color: var(--dim);

  font-family: "Courier New", monospace;
  font-size: 10px;
  letter-spacing: 0.14em;
}

.section-heading h2 {
  max-width: 100%;
  margin: 0;

  font-size: clamp(45px, 5vw, 78px);
  line-height: 0.92;

  letter-spacing: -0.06em;
}

.section-heading h2 span {
  color: var(--pink);
}


/* BODY */

.section-body,
.detail-content,
.principles-content,
.future-content {
  min-width: 0;
  max-width: 800px;
}

.section-body p,
.detail-content p,
.principles-content p,
.future-content p {
  color: var(--muted);

  font-size: 18px;
  line-height: 1.7;
}

.large-copy {
  color: var(--white) !important;

  font-size: 30px !important;
  line-height: 1.35 !important;

  letter-spacing: -0.02em;
}


/* PLANS */

.plans-section {
  max-width: var(--max);

  margin: 0 auto;
  padding: 130px 10vw;

  border-top: 1px solid var(--line);
}

.plans-heading {
  max-width: 900px;
  margin-bottom: 80px;
}

.plans-heading h2 {
  margin: 0;

