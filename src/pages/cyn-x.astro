---
const systems = [
  {
    number: "01",
    name: "CYN-X CORE",
    tag: "INTELLIGENCE LAYER",
    description:
      "A shared layer connecting intelligent systems, interfaces, services, and physical devices.",
    items: [
      "Computers",
      "Phones",
      "Displays",
      "Speakers",
      "Cameras",
      "Sensors",
      "Wearables",
      "Robotics",
      "Custom hardware",
      "Software services",
    ],
  },
  {
    number: "02",
    name: "LOCAL AI",
    tag: "PRIVATE INFERENCE",
    description:
      "AI designed to run locally where practical, keeping intelligence closer to the people and systems using it.",
    items: [
      "Local models",
      "Private inference",
      "Personal assistants",
      "Adaptive intelligence",
      "Memory systems",
      "Personality systems",
    ],
  },
  {
    number: "03",
    name: "MULTIMODAL",
    tag: "MANY WAYS TO INTERACT",
    description:
      "CYN-X explores interaction across text, vision, devices, environments, and physical computing.",
    items: [
      "Computer vision",
      "AI interfaces",
      "Visual understanding",
      "Environmental awareness",
      "Robotics integration",
      "Human-AI collaboration",
    ],
  },
  {
    number: "04",
    name: "TOOLS + SYSTEMS",
    tag: "BUILD WITH IT",
    description:
      "CYN-X is designed to work alongside projects rather than exist as an isolated chatbot.",
    items: [
      "Software development",
      "APIs",
      "Automation",
      "Developer tools",
      "Dashboards",
      "Infrastructure",
    ],
  },
];

const capabilities = [
  "Local AI",
  "Personal Assistants",
  "Adaptive Intelligence",
  "Memory",
  "Personality",
  "Multimodal Interaction",
  "Computer Vision",
  "Robotics",
  "AI Interfaces",
  "AI-Assisted Development",
  "Human-AI Collaboration",
  "Private Inference",
];

const lifecycle = [
  "Idea",
  "Research",
  "Experiment",
  "Prototype",
  "Community Testing",
  "Engineering",
  "Productization",
  "Release",
  "Feedback",
  "Continued Development",
];

const principles = [
  {
    number: "01",
    title: "HUMAN FIRST",
    text: "CYN-X should support people instead of forcing people to reorganize their lives around technology.",
  },
  {
    number: "02",
    title: "UNDERSTANDABLE",
    text: "Systems should remain understandable. Documentation is part of the engineering, not an afterthought.",
  },
  {
    number: "03",
    title: "PRIVATE WHERE PRACTICAL",
    text: "Local and private infrastructure can keep intelligence closer to the people, projects, and environments using it.",
  },
  {
    number: "04",
    title: "EXPERIMENTAL",
    text: "Prototypes, strange ideas, failures, and unfinished experiments are allowed to contribute to the system.",
  },
];

const interfaces = [
  "DESKTOP",
  "MOBILE",
  "WEB",
  "VOICE",
  "VISION",
  "HARDWARE",
  "ROBOTICS",
  "SENSORS",
];

const year = 2026;

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="CYN-X — a human-centered intelligent system developed by BARKLY LABS."
    />
    <title>CYN-X — BARKLY LABS</title>
  </head>
  <body>

    <!-- CYN-X SYSTEM BOOT -->
    <section class="cyn-boot" id="cynBoot">
      <div class="boot-noise"></div>
      <div class="boot-grid"></div>
      <div class="boot-topbar">
        <span>BARKLY LABS</span>
        <span>CYN-X // INITIALIZATION</span>
        <span id="boot-clock">00:00:00</span>
      </div>
      <div class="boot-terminal">
        <div class="boot-terminal-header">
          <span>CYN-X CORE TERMINAL</span>
          <span class="terminal-status">LOCAL SYSTEM</span>
        </div>
        <div class="boot-terminal-body" id="bootTerminal">
          <div class="boot-line"><span class="boot-prefix">&gt;</span> BARKLY LABS SYSTEM BOOT <strong>OK</strong></div>
          <div class="boot-line"><span class="boot-prefix">&gt;</span> INITIALIZING CYN-X CORE <strong>OK</strong></div>
          <div class="boot-line"><span class="boot-prefix">&gt;</span> LOADING INTELLIGENCE LAYER <strong>OK</strong></div>
          <div class="boot-line"><span class="boot-prefix">&gt;</span> LOADING PERSONALITY MATRIX <strong>OK</strong></div>
          <div class="boot-line"><span class="boot-prefix">&gt;</span> INITIALIZING MEMORY SYSTEMS <strong>OK</strong></div>
          <div class="boot-line"><span class="boot-prefix">&gt;</span> CONNECTING INTERFACES <strong>OK</strong></div>
          <div class="boot-line"><span class="boot-prefix">&gt;</span> CHECKING HUMAN-CENTERED SYSTEMS <strong>OK</strong></div>
          <div class="boot-line"><span class="boot-prefix">&gt;</span> LOCAL INFERENCE <strong>READY</strong></div>
        </div>
      </div>
      <div class="boot-center">
        <div class="boot-eyebrow">BARKLY LABS // INTELLIGENT SYSTEM</div>
        <div class="boot-logo">
          <div class="boot-logo-main">CYN-X</div>
          <div class="boot-logo-sub">CORE INITIALIZATION</div>
        </div>
        <div class="boot-progress">
          <div class="boot-progress-track">
            <div class="boot-progress-fill" id="bootProgress"></div>
          </div>
          <div class="boot-progress-meta">
            <span id="bootProgressText">0%</span>
            <span>SYSTEM INITIALIZATION</span>
          </div>
        </div>
        <div class="boot-ready" id="bootReady">CYN-X CORE // ONLINE</div>
      </div>
      <div class="boot-bottom">
        <div>HUMAN-CENTERED INTELLIGENCE</div>
        <div id="bootStatus">INITIALIZING...</div>
      </div>
      <button class="boot-skip" id="bootSkip" type="button">
        SKIP
        <span>→</span>
      </button>
    </section>

    <!-- NAVIGATION -->
    <header class="site-header">
      <a class="brand" href="/">
        <span>BARKLY</span>
        <span>LABS</span>
      </a>
      <nav>
        <a href="/about">ABOUT</a>
        <a href="#core">CORE</a>
        <a href="#capabilities">CAPABILITIES</a>
        <a href="#architecture">ARCHITECTURE</a>
        <a href="#principles">PRINCIPLES</a>
      </nav>
      <div class="status">
        <span class="status-dot"></span>
        CYN-X // ONLINE
      </div>
    </header>
    <main>
      <!-- HERO -->
      <section class="hero section" id="about">
        <div class="hero-grid"></div>
        <div class="eyebrow reveal">BARKLY LABS // CYN-X</div>
        <h1 class="hero-title reveal">
          INTELLIGENCE<br />
          <span>THAT ADAPTS.</span>
        </h1>
        <div class="hero-bottom reveal">
          <p class="hero-description">
            CYN-X is a human-centered intelligent system exploring what AI can
            become when it is designed around an ongoing relationship with its
            user, environment, tools, and projects.
          </p>
          <div class="hero-mark">
            <span>CYN</span>
            <span class="x">X</span>
          </div>
        </div>
      </section>
      <!-- CORE STATEMENT -->
      <section class="statement section reveal">
        <div class="section-number">01 / THE IDEA</div>
        <div class="statement-content">
          <p class="statement-large">
            ONE INTELLIGENT<br />
            <span>ECOSYSTEM.</span>
          </p>
          <p class="statement-small">
            MANY INTERFACES.
          </p>
        </div>
      </section>
      <!-- CYN-X CORE -->
      <section class="core section" id="core">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">02 / CYN-X CORE</div>
            <h2>THE INTELLIGENCE LAYER</h2>
          </div>
          <p>
            CYN-X Core is the long-term connecting layer between intelligent
            systems, interfaces, services, and physical devices.
          </p>
        </div>
        <div class="core-visual reveal">
          <div class="core-ring ring-one"></div>
          <div class="core-ring ring-two"></div>
          <div class="core-ring ring-three"></div>
          <div class="core-center">
            <span>CYN-X</span>
            <small>CORE</small>
          </div>
          <div class="orbit orbit-one">AI</div>
          <div class="orbit orbit-two">VISION</div>
          <div class="orbit orbit-three">TOOLS</div>
          <div class="orbit orbit-four">DEVICES</div>
          <div class="orbit orbit-five">DATA</div>
          <div class="orbit orbit-six">PEOPLE</div>
        </div>
        <div class="interface-grid reveal">
          {interfaces.map((interfaceName, index) => (
            <div class="interface-item">
              <span>0{index + 1}</span>
              <strong>{interfaceName}</strong>
            </div>
          ))}
        </div>
      </section>
      <!-- SYSTEMS -->
      <section class="systems section" id="architecture">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">03 / SYSTEMS</div>
            <h2>BUILT AS A SYSTEM</h2>
          </div>
          <p>
            CYN-X is not intended to be one isolated application. It is an
            ecosystem of connected capabilities.
          </p>
        </div>
        <div class="system-list">
          {systems.map((system) => (
            <article class="system-card reveal">
              <div class="system-top">
                <span class="system-number">{system.number}</span>
                <span class="system-tag">{system.tag}</span>
              </div>
              <h3>{system.name}</h3>
              <p>{system.description}</p>
              <div class="system-items">
                {system.items.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
      <!-- CAPABILITIES -->
      <section class="capabilities section" id="capabilities">
        <div class="section-number reveal">04 / CAPABILITIES</div>
        <div class="capability-heading reveal">
          <h2>
            MORE THAN<br />
            <span>A CHATBOT.</span>
          </h2>
          <p>
            CYN-X explores intelligent systems that can participate in real
            projects, understand different forms of input, work with tools,
            and connect with the environments around them.
          </p>
        </div>
        <div class="capability-cloud reveal">
          {capabilities.map((capability, index) => (
            <div class="capability">
              <span>0{index + 1}</span>
              {capability}
            </div>
          ))}
        </div>
      </section>
      <!-- HUMAN RELATIONSHIP -->
      <section class="relationship section reveal">
        <div class="relationship-label">THE QUESTION</div>
        <blockquote>
          “What can an AI system become when it is designed around an ongoing
          relationship with its user, environment, tools, and projects?”
        </blockquote>
        <div class="relationship-footer">
          <span>CYN-X / RESEARCH DIRECTION</span>
          <span>01 — 04</span>
        </div>
      </section>
      <!-- DEVELOPMENT LOOP -->
      <section class="lifecycle section">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">05 / DEVELOPMENT</div>
            <h2>BUILD. LEARN. ITERATE.</h2>
          </div>
          <p>
            CYN-X follows an iterative development philosophy where research,
            experimentation, documentation, testing, and feedback remain part
            of the system.
          </p>
        </div>
        <div class="lifecycle-grid reveal">
          {lifecycle.map((stage, index) => (
            <div class="lifecycle-step">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{stage}</strong>
            </div>
          ))}
        </div>
      </section>
      <!-- PRINCIPLES -->
      <section class="principles section" id="principles">
        <div class="section-number reveal">06 / DESIGN PRINCIPLES</div>
        <div class="principles-list">
          {principles.map((principle) => (
            <article class="principle reveal">
              <div class="principle-number">{principle.number}</div>
              <div>
                <h3>{principle.title}</h3>
                <p>{principle.text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
      <!-- ETHICS -->
      <section class="ethics section reveal">
        <div class="section-number">07 / RESPONSIBLE TECHNOLOGY</div>
        <div class="ethics-layout">
          <div>
            <h2>
              INTELLIGENCE<br />
              WITH <span>CONTEXT.</span>
            </h2>
          </div>
          <div class="ethics-copy">
            <p>
              CYN-X is intended to consider the consequences of technology
              throughout development.
            </p>
            <div class="ethics-grid">
              <span>PRIVACY</span>
              <span>SECURITY</span>
              <span>CONSENT</span>
              <span>ACCESSIBILITY</span>
              <span>TRANSPARENCY</span>
              <span>RESPONSIBLE AI</span>
              <span>HUMAN OVERSIGHT</span>
              <span>DATA MINIMIZATION</span>
              <span>CREATOR OWNERSHIP</span>
              <span>FAIR COMPENSATION</span>
            </div>
          </div>
        </div>
      </section>
      <!-- HUMAN FIRST -->
      <section class="human section reveal">
        <div class="human-grid"></div>
        <div class="section-number">08 / HUMAN-CENTERED</div>
        <div class="human-content">
          <p class="human-kicker">THE CORE PRINCIPLE</p>
          <h2>
            TECHNOLOGY<br />
            SHOULD ADAPT<br />
            <span>TO HUMANS.</span>
          </h2>
          <p class="human-description">
            People have different energy levels, abilities, interests, working
            styles, and needs. CYN-X is designed around the idea that technology
            should reduce unnecessary effort rather than create additional
            burdens.
          </p>
        </div>
      </section>
      <!-- CURRENT ECOSYSTEM -->
      <section class="ecosystem section">
        <div class="section-heading reveal">
          <div>
            <div class="section-number">09 / ECOSYSTEM</div>
            <h2>CONNECTED PROJECTS</h2>
          </div>
          <p>
            CYN-X exists inside a broader technology ecosystem spanning
            software, vision, embedded systems, hardware, and creative tools.
          </p>
        </div>
        <div class="ecosystem-grid reveal">
          <a class="ecosystem-card" href="/projects">
            <span>01</span>
            <strong>CYN-X</strong>
            <small>INTELLIGENT SYSTEM</small>
          </a>
          <a class="ecosystem-card" href="/projects">
            <span>02</span>
            <strong>SECUSERVE</strong>
            <small>COMPUTER VISION</small>
          </a>
          <a class="ecosystem-card" href="/projects">
            <span>03</span>
            <strong>SMART GARDEN</strong>
            <small>EMBEDDED SYSTEMS</small>
          </a>
          <a class="ecosystem-card" href="/projects">
            <span>04</span>
            <strong>PAWBOARD</strong>
            <small>HUMAN-CENTERED INTERFACE</small>
          </a>
        </div>
      </section>
      <!-- FUTURE -->
      <section class="future section reveal">
        <div class="section-number">10 / THE FUTURE</div>
        <div class="future-content">
          <h2>
            ONE SYSTEM.<br />
            <span>MANY POSSIBILITIES.</span>
          </h2>
          <p>
            CYN-X can grow from software into an ecosystem connecting AI,
            hardware, interfaces, robotics, creative technology, and the
            people building with it.
          </p>
        </div>
        <div class="future-line">
          <span>AI</span>
          <i></i>
          <span>SOFTWARE</span>
          <i></i>
          <span>HARDWARE</span>
          <i></i>
          <span>PEOPLE</span>
          <i></i>
          <span>COMMUNITY</span>
        </div>
      </section>
      <!-- CTA -->
      <section class="cta section reveal">
        <div class="cta-eyebrow">BARKLY LABS // CYN-X</div>
        <h2>
          BUILD WITH<br />
          <span>INTELLIGENCE.</span>
        </h2>
        <div class="cta-actions">
          <a href="/docs" class="button primary">
            READ THE DOCUMENTATION
            <span>→</span>
          </a>
          <a href="/projects" class="button secondary">
            EXPLORE PROJECTS
            <span>↗</span>
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>BARKLY LABS</strong>
        <span>CYN-X // INTELLIGENT SYSTEM</span>
      </div>
      <div class="footer-center">
        TECHNOLOGY SHOULD ADAPT TO HUMANS.
      </div>
      <div class="footer-meta">
        <span>DETROIT, MICHIGAN</span>
        <span>© {year}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #050505;
    --surface: #0b0b0b;
    --surface-2: #101010;
    --line: rgba(255, 255, 255, 0.12);
    --line-strong: rgba(255, 255, 255, 0.25);
    --text: #f4f4f4;
    --muted: #8c8c8c;
    --accent: #ffffff;
    --max: 1400px;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      Arial,
      Helvetica,
      sans-serif;
    overflow-x: hidden;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  button {
    font: inherit;
  }
  .section {
    width: min(calc(100% - 48px), var(--max));
    margin: 0 auto;
    position: relative;
  }

  /* INTRO */

  /* CYN-X SYSTEM BOOT */
  .cyn-boot {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #000;
    color: #f4f4f4;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Arial, Helvetica, sans-serif;
  }
  .boot-noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.08;
    background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, #fff 3px);
  }
  .boot-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    background-image:
      linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .boot-topbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    border-bottom: 1px solid rgba(255,255,255,0.12);
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #777;
  }
  .boot-topbar span:nth-child(2) { color: #aaa; }
  .boot-topbar span:last-child { justify-self: end; }
  .boot-terminal {
    position: absolute;
    top: 105px;
    left: 32px;
    width: min(480px, calc(100vw - 64px));
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(5,5,5,0.65);
  }
  .boot-terminal-header {
    padding: 10px 12px;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    font-family: monospace;
    font-size: 8px;
    letter-spacing: 0.1em;
    color: #666;
  }
  .terminal-status { color: #999; }
  .boot-terminal-body { padding: 14px 12px; }
  .boot-line {
    display: grid;
    grid-template-columns: 15px 1fr auto;
    gap: 5px;
    margin: 8px 0;
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.05em;
    color: #777;
    opacity: 0;
    transform: translateX(-8px);
  }
  .boot-line.visible {
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .boot-prefix { color: #aaa; }
  .boot-line strong { color: #eee; font-weight: 400; }
  .boot-center {
    position: relative;
    z-index: 2;
    width: min(850px, calc(100vw - 48px));
    text-align: center;
  }
  .boot-eyebrow {
    margin-bottom: 35px;
    font-family: monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: #666;
  }
  .boot-logo-main {
    font-size: clamp(5rem, 15vw, 13rem);
    font-weight: 900;
    line-height: 0.75;
    letter-spacing: -0.1em;
  }
  .boot-logo-sub {
    margin-top: 22px;
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.3em;
    color: #777;
  }
  .boot-progress {
    width: min(620px, 90%);
    margin: 70px auto 0;
  }
  .boot-progress-track {
    width: 100%;
    height: 2px;
    background: rgba(255,255,255,0.12);
    overflow: hidden;
  }
  .boot-progress-fill {
    width: 0%;
    height: 100%;
    background: #fff;
    transition: width 0.08s linear;
  }
  .boot-progress-meta {
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: #666;
  }
  .boot-ready {
    margin-top: 25px;
    font-family: monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: #fff;
    opacity: 0;
    transform: translateY(5px);
  }
  .boot-ready.visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .boot-bottom {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: #555;
  }
  #bootStatus { color: #888; }
  .boot-skip {
    position: absolute;
    right: 24px;
    bottom: 55px;
    z-index: 10;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,0.2);
    background: transparent;
    color: #aaa;
    cursor: pointer;
    font-family: monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    transition: background 0.2s, color 0.2s;
  }
  .boot-skip span { margin-left: 10px; }
  .boot-skip:hover {
    background: #fff;
    color: #000;
  }
  .cyn-boot.exit {
    animation: cynBootExit 0.9s cubic-bezier(0.77, 0, 0.18, 1) forwards;
  }

  @keyframes cynBootExit {
    0% { opacity: 1; transform: scale(1); }
    60% { opacity: 1; transform: scale(1.025); }
    100% { opacity: 0; visibility: hidden; transform: scale(1.06); }
  }
  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--line);
    background: rgba(5, 5, 5, 0.8);
    backdrop-filter: blur(14px);
  }
  .brand {
    display: flex;
    flex-direction: column;
    width: max-content;
    font-size: 12px;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .site-header nav {
    display: flex;
    gap: 25px;
