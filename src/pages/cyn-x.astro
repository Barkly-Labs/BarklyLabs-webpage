</style>

<script>
  const boot = document.getElementById("cynBoot");
  const bootProgress = document.getElementById("bootProgress");
  const bootProgressText = document.getElementById("bootProgressText");
  const bootReady = document.getElementById("bootReady");
  const bootStatus = document.getElementById("bootStatus");
  const bootSkip = document.getElementById("bootSkip");
  const bootLines = document.querySelectorAll(".boot-line");
  let finished = false;
  bootLines.forEach((line, index) => {
    setTimeout(() => line.classList.add("visible"), 350 + index * 260);
  });
  let progress = 0;
  const progressTimer = setInterval(() => {
    if (finished) {
      clearInterval(progressTimer);
      return;
    }
    const remaining = 100 - progress;
    const increment = remaining > 30 ? Math.random() * 7 : Math.random() * 2.5;
    progress = Math.min(100, progress + increment);
    const rounded = Math.floor(progress);
    if (bootProgress) bootProgress.style.width = `${rounded}%`;
    if (bootProgressText) bootProgressText.textContent = `${rounded}%`;
    if (bootStatus) {
      if (rounded < 25) bootStatus.textContent = "BOOTING CORE...";
      else if (rounded < 50) bootStatus.textContent = "LOADING INTELLIGENCE...";
      else if (rounded < 75) bootStatus.textContent = "CONNECTING SYSTEMS...";
      else if (rounded < 100) bootStatus.textContent = "FINALIZING...";
      else bootStatus.textContent = "SYSTEM READY";
    }
    if (progress >= 100) {
      clearInterval(progressTimer);
      finishBoot();
    }
  }, 65);
  function finishBoot() {
    if (finished) return;
    finished = true;
    bootReady?.classList.add("visible");
    if (bootStatus) bootStatus.textContent = "CYN-X CORE // ONLINE";
    setTimeout(() => boot?.classList.add("exit"), 850);
  }
  bootSkip?.addEventListener("click", () => {
    if (finished) return;
    finished = true;
    if (bootProgress) bootProgress.style.width = "100%";
    if (bootProgressText) bootProgressText.textContent = "100%";
    if (bootStatus) bootStatus.textContent = "SYSTEM READY";
    boot?.classList.add("exit");
  });
  const bootClock = document.getElementById("boot-clock");
  function updateBootClock() {
    if (!bootClock) return;
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, "0");
    const minutes = String(now.getMinutes()).padStart(2, "0");
    const seconds = String(now.getSeconds()).padStart(2, "0");
    bootClock.textContent = `${hours}:${minutes}:${seconds}`;
  }
  updateBootClock();
  setInterval(updateBootClock, 1000);
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reducedMotion) {
    bootLines.forEach((line) => line.classList.add("visible"));
    if (bootProgress) bootProgress.style.width = "100%";
    if (bootProgressText) bootProgressText.textContent = "100%";
    setTimeout(() => finishBoot(), 300);
  }
  const revealElements = document.querySelectorAll(".reveal");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 },
  );
  revealElements.forEach((element) => observer.observe(element));
</script>
