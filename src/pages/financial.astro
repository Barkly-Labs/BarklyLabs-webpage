---
const financialSystems = [
  {
    number: "01",
    title: "DOCUMENT INTAKE",
    description:
      "Bring financial documents into the lab and preserve their original source.",
    tags: ["UPLOAD", "SOURCE PRESERVATION", "CLASSIFICATION"],
  },

  {
    number: "02",
    title: "EXTRACTION",
    description:
      "Convert supported financial documents into structured machine-readable data.",
    tags: ["OCR", "PARSING", "JSON"],
  },

  {
    number: "03",
    title: "RECONCILIATION",
    description:
      "Compare extracted records against known transactions and identify unresolved differences.",
    tags: ["TRANSACTIONS", "MATCHING", "REVIEW"],
  },

  {
    number: "04",
    title: "REPORTING",
    description:
      "Turn structured records into understandable financial reports and summaries.",
    tags: ["REPORTS", "PERIODS", "EXPORT"],
  },
];

const pipeline = [
  ["01", "UPLOAD", "Original financial document enters the system."],
  ["02", "PRESERVE", "Original source is retained for traceability."],
  ["03", "EXTRACT", "Financial information is converted into structured data."],
  ["04", "VALIDATE", "The system checks structure and identifies uncertainty."],
  ["05", "REVIEW", "A human can inspect and correct the result."],
  ["06", "COMMIT", "Approved information becomes part of the financial record."],
  ["07", "REPORT", "Structured records can produce financial outputs."],
];

const principles = [
  {
    title: "SOURCE FIRST",
    text:
      "Derived financial information should remain connected to the document it came from.",
  },

  {
    title: "HUMANS STAY IN THE LOOP",
    text:
      "Automated extraction can assist with processing without silently becoming the final authority.",
  },

  {
    title: "MAKE IT UNDERSTANDABLE",
    text:
      "Financial information should be presented in a form people can inspect, question, and understand.",
  },

  {
    title: "MINIMIZE DATA",
    text:
      "Only the information necessary for the intended financial workflow should be processed and retained.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>BARKLY LABS — Financial Systems</title>

    <meta
      name="description"
      content="Barkly Labs financial systems for document intake, structured extraction, reconciliation, reporting, and human review."
    />
  </head>

  <body>
    <!-- =========================================================
         NAVIGATION
         ========================================================= -->

    <header class="site-header">
      <a
        href="/"
        class="header-logo"
        aria-label="Barkly Labs home"
      >
        <span>BARKLY</span>
        <span>LABS</span>
      </a>

      <nav
        class="header-nav"
        aria-label="Financial systems navigation"
      >
        <a href="#overview">OVERVIEW</a>
        <a href="#systems">SYSTEMS</a>
        <a href="#pipeline">PIPELINE</a>
        <a href="#principles">PRINCIPLES</a>
      </nav>

      <div class="header-status">
        <span class="status-dot"></span>
        FINANCIAL SYSTEM
      </div>
    </header>

    <!-- =========================================================
         SIDE NAV
         ========================================================= -->

    <aside class="side-nav">
      <a href="#overview">
        <span>01</span>
        OVERVIEW
      </a>

      <a href="#systems">
        <span>02</span>
        SYSTEMS
      </a>

      <a href="#pipeline">
        <span>03</span>
        PIPELINE
      </a>

      <a href="#principles">
        <span>04</span>
        PRINCIPLES
      </a>

      <a href="#operations">
        <span>05</span>
        OPERATIONS
      </a>
    </aside>

    <main>
      <!-- =======================================================
           HERO
           ======================================================= -->

      <section class="hero" id="overview">
        <div class="section-meta">
          <span>BARKLY LABS</span>
          <span>FINANCIAL SYSTEM / DOCUMENT 004</span>
        </div>

        <div class="hero-title">
          <span class="eyebrow">
            BARKLY / FINANCIAL INFRASTRUCTURE
          </span>

          <h1>
            MAKE THE
            <br />
            NUMBERS
            <br />
            <span>UNDERSTANDABLE.</span>
          </h1>
        </div>

        <div class="hero-bottom">
          <p class="hero-copy">
            A financial document and record system designed to
            turn messy source material into structured,
            reviewable information.
          </p>

          <div class="hero-mark">
            FINANCIAL<br />
            SYSTEMS
          </div>
        </div>
      </section>

      <!-- =======================================================
           INTRO
           ======================================================= -->

      <section class="content-section intro-section">
        <div class="section-heading">
          <span class="section-number">02</span>

          <div>
            <span class="eyebrow">THE IDEA</span>

            <h2>
              DATA SHOULD
              <br />
              <span>EXPLAIN ITSELF.</span>
            </h2>
          </div>
        </div>

        <div class="section-body">
          <p class="large-copy">
            Financial administration shouldn't require a
            human to manually translate every document
            into every system.
          </p>

          <p>
            The Financial Systems layer is intended to provide
            structured intake, extraction, validation,
            review, reconciliation, and reporting while
            keeping the original source available.
          </p>

          <p>
            Automation handles repetitive work.
            People remain able to inspect what happened.
          </p>
        </div>
      </section>

      <!-- =======================================================
           SYSTEMS
           ======================================================= -->

      <section class="content-section" id="systems">
        <div class="section-heading">
          <span class="section-number">03</span>

          <div>
            <span class="eyebrow">THE SYSTEM</span>

            <h2>
              ONE WORKFLOW.
              <br />
              <span>MANY TOOLS.</span>
            </h2>
          </div>
        </div>

        <div class="system-grid">
          {financialSystems.map((system) => (
            <article class="system-card">
              <div class="system-top">
                <span>{system.number}</span>

                <span>
                  FINANCIAL INFRASTRUCTURE
                </span>
              </div>

              <h3>{system.title}</h3>

              <p>
                {system.description}
              </p>

              <div class="tag-list">
                {system.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- =======================================================
           PIPELINE
           ======================================================= -->

      <section
        class="content-section pipeline-section"
        id="pipeline"
      >
        <div class="section-heading">
          <span class="section-number">04</span>

          <div>
            <span class="eyebrow">PROCESS</span>

            <h2>
              DOCUMENT
              <br />
              <span>→ DATA.</span>
            </h2>
          </div>
        </div>

        <p class="section-lead">
          The system turns financial documents into structured
          information through a visible, reviewable pipeline.
        </p>

        <div class="pipeline">
          {pipeline.map((step) => (
            <article class="pipeline-step">
              <span class="pipeline-number">
                {step[0]}
              </span>

              <div>
                <h3>{step[1]}</h3>

                <p>{step[2]}</p>
              </div>

              <span class="pipeline-arrow">
                →
              </span>
            </article>
          ))}
        </div>
      </section>

      <!-- =======================================================
           OPERATIONS / SEPARATE APPLICATION
           ======================================================= -->

      <section
        class="content-section operations-section"
        id="operations"
      >
        <div class="section-heading">
          <span class="section-number">05</span>

          <div>
            <span class="eyebrow">
              FINANCIAL OPERATIONS
            </span>

            <h2>
              THE SYSTEM
              <br />
              <span>UNDER THE DOCUMENT.</span>
            </h2>
          </div>
        </div>

        <div class="operations-layout">
          <div class="operations-copy">
            <p class="large-copy">
              The documentation explains the system.
              The Financial System application does the work.
            </p>

            <p>
              Financial document intake, extraction,
              validation, review, reconciliation, and
              reporting belong to the operational system
              rather than this documentation page.
            </p>

            <p>
              Keeping the interface separate allows the
              architecture to remain understandable while
              the actual financial workflow can evolve
              independently.
            </p>
          </div>

          <div class="system-launch">
            <div class="launch-header">
              <div>
                <span class="panel-label">
                  BARKLY LABS / APPLICATION
                </span>

                <strong>
                  FINANCIAL SYSTEM
                </strong>
              </div>

              <span class="status-live">
                ● SYSTEM
              </span>
            </div>

            <div class="launch-body">
              <span class="launch-number">
                FINANCIAL
              </span>

              <h3>
                OPEN THE
                <br />
                <span>FINANCIAL SYSTEM.</span>
              </h3>

              <p>
                Open the operational interface for
                document intake, review, financial
                records, and reporting.
              </p>

              <a
                href="/financial"
                class="launch-button"
              >
                OPEN FINANCIAL SYSTEM
                <span>↗</span>
              </a>
            </div>

            <div class="launch-footer">
              <span>
                DOCUMENTATION
              </span>

              <span>
                APPLICATION →
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- =======================================================
           PRINCIPLES
           ======================================================= -->

      <section
        class="content-section"
        id="principles"
      >
        <div class="section-heading">
          <span class="section-number">06</span>

          <div>
            <span class="eyebrow">
              PAW-HC / FINANCIAL SYSTEMS
            </span>

            <h2>
              AUTOMATE THE
              <br />
              <span>BORING PARTS.</span>
            </h2>
          </div>
        </div>

        <div class="principles-grid">
          {principles.map((principle, index) => (
            <article class="principle-card">
              <span class="card-number">
                0{index + 1}
              </span>

              <h3>
                {principle.title}
              </h3>

              <p>
                {principle.text}
              </p>
            </article>
          ))}
        </div>
      </section>

    <!-- =======================================================
     FINAL
     ======================================================= -->

<section class="final-section">
  <span class="eyebrow">
    BARKLY LABS / FINANCIAL INFRASTRUCTURE
  </span>

  <h2>
    THE COMPUTER
    <br />
    DOES THE
    <span>TRANSLATION.</span>
  </h2>

  <p>
    People stay in control of the result.
  </p>

  <a
    href="/financial"
    class="final-system-button"
  >
    OPEN FINANCIAL SYSTEM
    <span>↗</span>
  </a>
</section>
</main>

    <style>
      :global(:root) {
        --bg: #050505;
        --panel: #0a0a0a;
        --panel-raised: #0f0f0f;
        --panel-hover: #131313;

        --text: #f1f1f1;
        --white: #f1f1f1;

        --muted: #a1a1a1;
        --dim: #686868;
        --faint: #444;

        --line: rgba(255, 255, 255, 0.12);
        --line-strong: rgba(255, 255, 255, 0.25);

        --pink: #ff2f92;
        --pink-soft: rgba(255, 47, 146, 0.1);
        --pink-line: rgba(255, 47, 146, 0.42);

        --max: 1500px;
      }

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
        background: var(--bg);
      }

      :global(body) {
        margin: 0;
        background: var(--bg);
        color: var(--text);

        font-family:
          Inter,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      /* =========================================================
         HEADER
         ========================================================= */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;

        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;

        min-height: 70px;
        padding: 0 40px;

        background: rgba(5, 5, 5, 0.94);
        border-bottom: 1px solid var(--line);

        backdrop-filter: blur(14px);
      }

      .header-logo {
        display: inline-flex;
        gap: 0.18em;
        width: fit-content;

        font-size: 14px;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      .header-logo span:first-child {
        color: var(--pink);
      }

      .header-logo span:last-child {
        color: var(--white);
      }

      .header-nav {
        display: flex;
        gap: 28px;

        font-family:
          "IBM Plex Mono",
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 10px;
        letter-spacing: 0.12em;
      }

      .header-nav a {
        color: var(--muted);
        transition: color 160ms ease;
      }

      .header-nav a:hover {
        color: var(--pink);
      }

      .header-status {
        justify-self: end;

        display: flex;
        align-items: center;
        gap: 8px;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 9px;
        letter-spacing: 0.12em;
        color: var(--muted);
      }

      .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;
        background: var(--pink);

        box-shadow:
          0 0 12px rgba(255, 47, 146, 0.5);
      }

      /* =========================================================
         SIDE NAV
         ========================================================= */

      .side-nav {
        position: fixed;
        left: 28px;
        top: 50%;

        transform: translateY(-50%);
        z-index: 20;

        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .side-nav a {
        display: flex;
        gap: 9px;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 9px;
        letter-spacing: 0.08em;
        color: var(--dim);
      }

      .side-nav a:hover {
        color: var(--pink);
      }

      .side-nav span {
        color: var(--pink);
      }

      /* =========================================================
         MAIN
         ========================================================= */

      main {
        width: min(100%, var(--max));
        margin: 0 auto;
      }

      /* =========================================================
         HERO
         ========================================================= */

      .hero {
        min-height: 88vh;

        padding: 80px 8vw 90px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        border-bottom: 1px solid var(--line);
      }

      .section-meta,
      .eyebrow {
        display: flex;
        gap: 18px;

        font-family:
          "IBM Plex Mono",
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 10px;
        letter-spacing: 0.12em;
        color: var(--muted);
      }

      .hero-title {
        margin-top: 13vh;
      }

      .hero-title h1 {
        max-width: 1100px;
        margin: 28px 0 0;

        font-size: clamp(70px, 10vw, 155px);
        line-height: 0.86;
        letter-spacing: -0.065em;
      }

      .hero-title h1 span {
        color: var(--pink);
      }

      .hero-bottom {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;
        gap: 80px;

        margin-top: 100px;
      }

      .hero-copy {
        max-width: 680px;

        font-size: clamp(18px, 2vw, 26px);
        line-height: 1.35;
        color: var(--muted);
      }

      .hero-mark {
        align-self: end;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 11px;
        line-height: 1.5;
        letter-spacing: 0.1em;

        color: var(--pink);
      }

      /* =========================================================
         CONTENT SECTIONS
         ========================================================= */

      .content-section {
        padding: 150px 8vw;
        border-bottom: 1px solid var(--line);
      }

      .section-heading {
        display: grid;
        grid-template-columns: 80px minmax(0, 1fr);
        gap: 40px;
      }

      .section-number {
        padding-top: 9px;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 11px;
        color: var(--pink);
      }

      .section-heading h2 {
        margin: 18px 0 0;
        max-width: 900px;

        font-size: clamp(58px, 8vw, 125px);
        line-height: 0.9;
        letter-spacing: -0.06em;
      }

      .section-heading h2 span {
        color: var(--pink);
      }

      .section-body {
        max-width: 760px;
        margin: 90px 0 0 auto;
      }

      .large-copy {
        font-size: clamp(26px, 3vw, 42px);
        line-height: 1.15;
        letter-spacing: -0.03em;
      }

      .section-body p:not(.large-copy) {
        max-width: 650px;
        margin-top: 30px;

        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      /* =========================================================
         SYSTEM CARDS
         ========================================================= */

      .system-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;

        margin-top: 100px;

        background: var(--line);
        border: 1px solid var(--line);
      }

      .system-card {
        min-height: 310px;
        padding: 36px;

        background: var(--panel);

        transition:
          background 180ms ease,
          transform 180ms ease;
      }

      .system-card:hover {
        background: var(--panel-hover);
      }

      .system-top {
        display: flex;
        justify-content: space-between;
        gap: 20px;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 9px;
        letter-spacing: 0.1em;
        color: var(--dim);
      }

      .system-top span:first-child {
        color: var(--pink);
      }

      .system-card h3 {
        margin: 80px 0 18px;

        font-size: clamp(28px, 3vw, 48px);
        letter-spacing: -0.04em;
      }

      .system-card p {
        max-width: 520px;

        color: var(--muted);
        line-height: 1.6;
      }

      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;

        margin-top: 30px;
      }

      .tag-list span {
        padding: 7px 9px;

        border: 1px solid var(--line);

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 8px;
        letter-spacing: 0.08em;
        color: var(--dim);
      }

      /* =========================================================
         PIPELINE
         ========================================================= */

      .section-lead {
        max-width: 760px;
        margin: 80px 0 70px auto;

        color: var(--muted);
        font-size: 19px;
        line-height: 1.6;
      }

      .pipeline {
        border-top: 1px solid var(--line);
      }

      .pipeline-step {
        display: grid;
        grid-template-columns: 70px 1fr 30px;
        gap: 30px;
        align-items: center;

        padding: 30px 0;

        border-bottom: 1px solid var(--line);
      }

      .pipeline-number {
        font-family:
          "IBM Plex Mono",
          monospace;

        color: var(--pink);
        font-size: 10px;
      }

      .pipeline-step h3 {
        margin: 0 0 8px;

        font-size: 22px;
        letter-spacing: -0.03em;
      }

      .pipeline-step p {
        margin: 0;

        color: var(--muted);
        line-height: 1.5;
      }

      .pipeline-arrow {
        color: var(--pink);
      }

      /* =========================================================
         OPERATIONS / APPLICATION LINK
         ========================================================= */

      .operations-layout {
        display: grid;
        grid-template-columns:
          minmax(0, 0.9fr)
          minmax(420px, 1.1fr);

        gap: 100px;
        align-items: start;

        margin-top: 90px;
      }

      .operations-copy {
        max-width: 650px;
      }

      .operations-copy p:not(.large-copy) {
        margin-top: 30px;

        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      .system-launch {
        background: var(--panel);
        border: 1px solid var(--line-strong);
      }

      .launch-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: 25px 30px;

        border-bottom: 1px solid var(--line);
      }

      .panel-label {
        display: block;
        margin-bottom: 8px;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 8px;
        letter-spacing: 0.1em;
        color: var(--dim);
      }

      .launch-header strong {
        font-size: 14px;
        letter-spacing: 0.05em;
      }

      .status-live {
        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 9px;
        color: var(--pink);
      }

      .launch-body {
        padding: 50px 30px 40px;
      }

      .launch-number {
        display: block;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 9px;
        letter-spacing: 0.12em;
        color: var(--pink);
      }

      .launch-body h3 {
        margin: 45px 0 25px;

        font-size: clamp(38px, 5vw, 70px);
        line-height: 0.9;
        letter-spacing: -0.05em;
      }

      .launch-body h3 span {
        color: var(--pink);
      }

      .launch-body p {
        max-width: 500px;

        margin: 0 0 35px;

        color: var(--muted);
        line-height: 1.6;
      }

      .launch-button {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 35px;

        min-width: 260px;
        padding: 15px 18px;

        background: var(--pink);
        border: 1px solid var(--pink);

        color: #050505;

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 9px;
        letter-spacing: 0.08em;

        transition:
          background 180ms ease,
          color 180ms ease;
      }

      .launch-button:hover {
        background: transparent;
        color: var(--pink);
      }

      .launch-footer {
        display: flex;
        justify-content: space-between;

        padding: 18px 22px;

        border-top: 1px solid var(--line);

        font-family:
          "IBM Plex Mono",
          monospace;

        font-size: 8px;
        letter-spacing: 0.08em;
        color: var(--dim);
      }

      /* =========================================================
         PRINCIPLES
         ========================================================= */

      .principles-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));

        margin-top: 100px;

        border-top: 1px solid var(--line);
        border-left: 1px solid var(--line);
      }

      .principle-card {
        min-height: 270px;
        padding: 34px;

        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .card-number {
        font-family:
          "IBM Plex Mono",
          monospace;

        color: var(--pink);
        font-size: 10px;
      }

      .principle-card h3 {
        margin: 65px 0 15px;

        font-size: 25px;
        letter-spacing: -0.03em;
      }

      .principle-card p {
        max-width: 500px;

        color: var(--muted);
        line-height: 1.6;
      }

      /* =========================================================
         FINAL
         ========================================================= */

      .final-section {
        padding: 180px 8vw;

        border-bottom: 1px solid var(--line);
      }

      .final-section h2 {
        max-width: 1100px;
        margin: 35px 0;

        font-size: clamp(65px, 9vw, 140px);
        line-height: 0.87;
        letter-spacing: -0.06em;
      }

      .final-section h2 span {
        color: var(--pink);
