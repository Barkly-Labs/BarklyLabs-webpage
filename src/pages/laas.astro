---
const year = 2026;

const services = [
  {
    number: "01",
    name: "COMPUTE",
    tag: "RESEARCH INFRASTRUCTURE",
    description:
      "Computing resources for experimentation, development, simulation, AI workloads, and research systems.",
    items: [
      "CPU / GPU COMPUTE",
      "AI WORKLOADS",
      "LOCAL INFERENCE",
      "SIMULATION",
      "DEVELOPMENT ENVIRONMENTS",
    ],
  },
  {
    number: "02",
    name: "NETWORKING",
    tag: "CONNECTED INFRASTRUCTURE",
    description:
      "Network infrastructure connecting machines, devices, laboratories, services, and people.",
    items: [
      "LAB NETWORKS",
      "DEVICE CONNECTION",
      "SERVICE NETWORKING",
      "REMOTE ACCESS",
      "SYSTEM MONITORING",
    ],
  },
  {
    number: "03",
    name: "ENGINEERING",
    tag: "BUILDING SYSTEMS",
    description:
      "Reusable engineering environments for software, hardware, embedded systems, robotics, and experimentation.",
    items: [
      "SOFTWARE",
      "HARDWARE",
      "EMBEDDED SYSTEMS",
      "ROBOTICS",
      "PROTOTYPING",
    ],
  },
  {
    number: "04",
    name: "AI SYSTEMS",
    tag: "INTELLIGENT INFRASTRUCTURE",
    description:
      "AI infrastructure designed to support people, projects, research, interfaces, and connected systems.",
    items: [
      "CYN-X",
      "LOCAL AI",
      "COMPUTER VISION",
      "AI INTERFACES",
      "HUMAN-AI COLLABORATION",
    ],
  },
  {
    number: "05",
    name: "DOCUMENTATION",
    tag: "KNOWLEDGE INFRASTRUCTURE",
    description:
      "Documentation is part of the infrastructure. Systems should be understandable enough to operate, modify, and improve.",
    items: [
      "TECHNICAL DOCUMENTATION",
      "REFERENCE ARCHITECTURES",
      "OPERATIONS",
      "RESEARCH NOTES",
      "SYSTEM KNOWLEDGE",
    ],
  },
  {
    number: "06",
    name: "SECURITY + SAFETY",
    tag: "RESPONSIBLE INFRASTRUCTURE",
    description:
      "Security, privacy, safety, consent, and human oversight are treated as components of the system itself.",
    items: [
      "SECURITY",
      "PRIVACY",
      "ACCESS CONTROL",
      "SAFETY",
      "HUMAN OVERSIGHT",
    ],
  },
];

const lifecycle = [
  ["01", "DEFINE", "Identify the research problem, people, requirements, and constraints."],
  ["02", "DESIGN", "Design the infrastructure, interfaces, architecture, and operating model."],
  ["03", "BUILD", "Construct the physical and digital systems required for the work."],
  ["04", "DOCUMENT", "Record how the system works so other people can understand it."],
  ["05", "OPERATE", "Run the infrastructure and learn from real-world use."],
  ["06", "IMPROVE", "Iterate on the infrastructure as new information becomes available."],
  ["07", "SHARE", "Make reusable knowledge, tooling, and architecture available to others."],
];

const principles = [
  {
    number: "01",
    title: "INFRASTRUCTURE SHOULD BE REUSABLE",
    text:
      "Research infrastructure should not have to be rebuilt from zero for every project.",
  },
  {
    number: "02",
    title: "DOCUMENTATION IS INFRASTRUCTURE",
    text:
      "A system that cannot be understood, operated, or modified by people is incomplete.",
  },
  {
    number: "03",
    title: "PEOPLE STAY IN THE LOOP",
    text:
      "Automation and intelligent systems should expand human capability while preserving human oversight.",
  },
  {
    number: "04",
    title: "BUILD FOR MODIFICATION",
    text:
      "LAAS should provide building blocks that can be adapted to different laboratories, projects, and communities.",
  },
];

const architecture = [
  "PEOPLE",
  "RESEARCH",
  "COMPUTE",
  "NETWORK",
  "AI",
  "HARDWARE",
  "SOFTWARE",
  "DOCUMENTATION",
  "SECURITY",
  "COMMUNITY",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>LAAS — BARKLY LABS</title>

    <meta
      name="description"
      content="Laboratory as a Service — reusable research infrastructure from Barkly Labs."
    />

    <meta name="theme-color" content="#050505" />
  </head>

  <body>
    <!-- =========================================================
         NAVIGATION
         ========================================================= -->

    <nav class="nav">
      <a href="/" class="brand" aria-label="Barkly Labs home">
        <span class="brand-symbol">◆</span>
        <span>BARKLY LABS</span>
      </a>

      <div class="nav-center">
        <span class="nav-context">LAAS / INFRASTRUCTURE</span>
      </div>

      <div class="nav-links">
        <a href="#services">SERVICES</a>
        <a href="#architecture">ARCHITECTURE</a>
        <a href="#process">PROCESS</a>
        <a href="#principles">PRINCIPLES</a>
      </div>

      <a href="/" class="nav-status">
        <span class="status-dot"></span>
        BARKLY LABS
      </a>
    </nav>

    <main>
      <!-- =======================================================
           HERO
           ======================================================= -->

      <section class="hero">
        <div class="hero-grid"></div>

        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>
        <div class="hero-orbit orbit-three"></div>

        <div class="hero-content">
          <div class="eyebrow">
            <span>01</span>
            BARKLY / LAAS
          </div>

          <h1>
            LABORATORY
            <span>AS A</span>
            SERVICE.
          </h1>

          <p class="hero-copy">
            Research infrastructure should not have to be rebuilt from zero
            every time someone wants to experiment.
          </p>

          <p class="hero-copy secondary-copy">
            LAAS explores a reusable infrastructure layer surrounding research:
            computing, networking, engineering tools, documentation, AI,
            security, safety, and collaboration.
          </p>

          <div class="hero-actions">
            <a href="#services" class="button button-primary">
              EXPLORE THE INFRASTRUCTURE
              <span>↓</span>
            </a>

            <a href="#architecture" class="button button-secondary">
              VIEW ARCHITECTURE
            </a>
          </div>
        </div>

        <div class="hero-side">
          <span>LABORATORY AS A SERVICE</span>
          <span>RESEARCH INFRASTRUCTURE</span>
          <span>BARKLY LABS</span>
        </div>

        <div class="hero-bottom">
          <span>LAAS / SYSTEM 01</span>
          <span class="scroll-line"></span>
        </div>
      </section>

      <!-- =======================================================
           INTRO
           ======================================================= -->

      <section class="section intro-section">
        <div class="section-heading">
          <div class="section-number">02</div>

          <div>
            <span class="section-kicker">THE IDEA</span>

            <h2>
              A LAB SHOULD BE
              <span>MORE THAN A BUILDING.</span>
            </h2>
          </div>
        </div>

        <div class="intro-layout">
          <div class="intro-large">
            Research requires more than physical space.
          </div>

          <div class="intro-copy">
            <p>
              A functioning laboratory depends on the infrastructure
              surrounding the research itself.
            </p>

            <p>
              That includes computing, networks, engineering tools,
              documentation, security, AI systems, reference architectures,
              safety practices, technical standards, and the knowledge created
              through experimentation.
            </p>

            <p>
              LAAS treats those components as infrastructure that can be
              designed, maintained, reused, and improved.
            </p>
          </div>
        </div>
      </section>

      <!-- =======================================================
           SERVICES
           ======================================================= -->

      <section id="services" class="section services-section">
        <div class="section-heading">
          <div class="section-number">03</div>

          <div>
            <span class="section-kicker">THE INFRASTRUCTURE</span>

            <h2>
              BUILDING
              <span>BLOCKS.</span>
            </h2>
          </div>
        </div>

        <div class="services-intro">
          <p>
            LAAS is not one laboratory design. It is an infrastructure model
            that can be adapted to different laboratories, projects,
            organizations, and communities.
          </p>

          <span class="service-mark">
            R&amp;D<br />
            INFRA
          </span>
        </div>

        <div class="services-grid">
          {
            services.map((service) => (
              <article class="service-card">
                <div class="service-card-top">
                  <span class="card-number">{service.number}</span>
                  <span class="service-tag">{service.tag}</span>
                </div>

                <h3>{service.name}</h3>

                <p>{service.description}</p>

                <div class="service-items">
                  {service.items.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- =======================================================
           ARCHITECTURE
           ======================================================= -->

      <section id="architecture" class="section architecture-section">
        <div class="architecture-background"></div>

        <div class="section-heading">
          <div class="section-number">04</div>

          <div>
            <span class="section-kicker">REFERENCE ARCHITECTURE</span>

            <h2>
              THE
              <span>LAB STACK.</span>
            </h2>
          </div>
        </div>

        <div class="architecture-layout">
          <div class="architecture-copy">
            <p class="large-copy">
              The laboratory becomes a system.
            </p>

            <p>
              Physical infrastructure, digital infrastructure, intelligent
              systems, documentation, and people can operate as connected
              layers rather than isolated components.
            </p>

            <p>
              The exact implementation can change. The architecture provides
              the shared foundation.
            </p>
          </div>

          <div class="architecture-stack">
            {
              architecture.map((layer, index) => (
                <div class="architecture-layer">
                  <span>0{index + 1}</span>
                  <strong>{layer}</strong>
                  <i></i>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =======================================================
           PROCESS
           ======================================================= -->

      <section id="process" class="section process-section">
        <div class="section-heading">
          <div class="section-number">05</div>

          <div>
            <span class="section-kicker">INFRASTRUCTURE LIFECYCLE</span>

            <h2>
              BUILD.
              <span>LEARN.</span>
            </h2>
          </div>
        </div>

        <div class="lifecycle">
          {
            lifecycle.map(([number, title, description]) => (
              <article class="lifecycle-step">
                <div class="lifecycle-number">{number}</div>

                <div class="lifecycle-content">
                  <h3>{title}</h3>
                  <p>{description}</p>
                </div>

                <span class="lifecycle-arrow">→</span>
              </article>
            ))
          }
        </div>
      </section>

      <!-- =======================================================
           PRINCIPLES
           ======================================================= -->

      <section id="principles" class="section principles-section">
        <div class="section-heading">
          <div class="section-number">06</div>

          <div>
            <span class="section-kicker">DESIGN PRINCIPLES</span>

            <h2>
              INFRASTRUCTURE
              <span>FOR PEOPLE.</span>
            </h2>
          </div>
        </div>

        <div class="principles-grid">
          {
            principles.map((principle) => (
              <article class="principle-card">
                <span class="card-number">{principle.number}</span>

                <h3>{principle.title}</h3>

                <p>{principle.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- =======================================================
           ECOSYSTEM
           ======================================================= -->

      <section class="section ecosystem-section">
        <div class="ecosystem-mark">LAAS</div>

        <div class="ecosystem-content">
          <span class="section-kicker">BARKLY / ECOSYSTEM</span>

          <h2>
            BUILD ONCE.
            <span>LEARN TOGETHER.</span>
          </h2>

          <p>
            The long-term vision is a network of laboratories and builders
            contributing improvements back into a shared ecosystem.
          </p>

          <div class="ecosystem-loop">
            <span>LAB</span>
            <b>→</b>
            <span>RESEARCH</span>
            <b>→</b>
            <span>DOCUMENTATION</span>
            <b>→</b>
            <span>IMPROVEMENT</span>
            <b>→</b>
            <span>SHARING</span>
            <b>→</b>
            <span>NEW LABS</span>
          </div>
        </div>
      </section>

      <!-- =======================================================
           CTA
           ======================================================= -->

      <section class="section cta-section">
        <div class="cta-grid"></div>

        <div class="cta-content">
          <span class="section-kicker">07 / THE VISION</span>

          <h2>
            A LAB
            <span>DOESN'T HAVE TO START FROM ZERO.</span>
          </h2>

          <p>
            LAAS is a long-term vision for reusable research infrastructure
            that can grow alongside the people building it.
          </p>

          <div class="cta-actions">
            <a href="/" class="button button-primary">
              RETURN TO BARKLY LABS
              <span>↗</span>
            </a>

            <a href="#services" class="button button-secondary">
              EXPLORE INFRASTRUCTURE
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="footer">
      <div class="footer-main">
        <div class="footer-brand">
          <div class="footer-logo">BARKLY</div>
          <div class="footer-labs">LAAS</div>
        </div>

        <div class="footer-tagline">
          LABORATORY
          <br />
          AS A SERVICE.
        </div>
      </div>

      <div class="footer-bottom">
        <span>© {year} BARKLY LABS</span>
        <span>DETROIT, MICHIGAN</span>
        <span>RESEARCH INFRASTRUCTURE</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #050505;
    --surface: #0b0b0b;
    --surface-2: #101010;
    --line: rgba(255, 255, 255, 0.12);
    --line-strong: rgba(255, 255, 255, 0.25);
    --text: #f2f2f2;
    --muted: #8c8c8c;
    --dim: #555;
    --max: 1400px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    overflow-x: hidden;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 100;
    opacity: 0.025;
    background-image:
      linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: #f2f2f2;
    color: #050505;
  }

  /* =========================================================
     NAV
     ========================================================= */

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;

    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 28px;

    min-height: 72px;
    padding: 0 4vw;

    border-bottom: 1px solid var(--line);

    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;

    font-family: "Courier New", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .brand-symbol {
    font-size: 13px;
  }

  .nav-context {
    color: var(--dim);
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
  }

  .nav-links {
    display: flex;
    gap: 22px;
  }

  .nav-links a,
  .nav-status {
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #aaa;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-status:hover {
    color: #fff;
  }

  .nav-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #eee;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #eee;
    box-shadow: 0 0 12px rgba(255,255,255,.5);
  }

  /* =========================================================
     HERO
     ========================================================= */

  .hero {
    position: relative;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;

    padding: 120px 7vw 130px;

    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid,
  .cta-grid {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);

    background-size: 80px 80px;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 20%,
      black 80%,
      transparent
    );

    opacity: 0.35;
  }

  .hero-orbit {
    position: absolute;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-one {
    width: 700px;
    height: 700px;
    right: -220px;
    top: -180px;
  }

  .orbit-two {
    width: 500px;
    height: 500px;
    right: -110px;
    top: -80px;
  }

  .orbit-three {
    width: 320px;
    height: 320px;
    right: -20px;
    top: 10px;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(820px, 100%);
  }

  .eyebrow,
  .section-kicker {
    display: flex;
    gap: 14px;
    align-items: center;

    margin-bottom: 28px;

    color: #777;
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
  }

  .eyebrow span {
    color: #ddd;
  }

  .hero h1 {
    max-width: 900px;

    margin: 0;

    font-size: clamp(65px, 10vw, 145px);
    line-height: 0.84;
    letter-spacing: -0.075em;
    font-weight: 800;
  }

  .hero h1 span {
    display: block;
    color: #777;
  }

  .hero-copy {
    max-width: 650px;
    margin: 42px 0 0;

    color: #aaa;
    font-size: 15px;
    line-height: 1.8;
  }

  .secondary-copy {
    margin-top: 15px;
    color: #666;
  }

  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 38px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;

    padding: 14px 17px;

    border: 1px solid #555;

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 0.13em;

    transition:
      background .2s ease,
      color .2s ease,
      border-color .2s ease,
      transform .2s ease;
  }

  .button:hover {
    transform: translateX(4px);
  }

  .button-primary {
    background: #f2f2f2;
    border-color: #f2f2f2;
    color: #050505;
  }

  .button-primary:hover {
    background: transparent;
    color: #f2f2f2;
  }

  .button-secondary {
    color: #ddd;
  }

  .button-secondary:hover {
    background: #f2f2f2;
    color: #050505;
    border-color: #f2f2f2;
  }

  .hero-side {
    position: absolute;
    right: 4vw;
    bottom: 115px;

    display: flex;
    flex-direction: column;
    gap: 8px;

    color: #555;
    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: .15em;
    text-align: right;
  }

  .hero-bottom {
    position: absolute;
    bottom: 35px;
    left: 7vw;

    display: flex;
    align-items: center;
    gap: 18px;

    color: #555;
    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: .15em;
  }

  .scroll-line {
    width: 90px;
    height: 1px;
    background: #555;
  }

  /* =========================================================
     GENERAL SECTIONS
     ========================================================= */

  .section {
    position: relative;
    max-width: var(--max);
    margin: 0 auto;
    padding: 130px 7vw;

    border-bottom: 1px solid var(--line);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 28px;
    margin-bottom: 70px;
  }

  .section-number {
    color: #444;
    font-family: "Courier New", monospace;
    font-size: 11px;
    padding-top: 8px;
  }

  .section-heading h2 {
    margin: 0;

    max-width: 900px;

    font-size: clamp(48px, 7vw, 100px);
    line-height: .87;
    letter-spacing: -.065em;
  }

  .section-heading h2 span {
    display: block;
    color: #666;
  }

  /* =========================================================
     INTRO
     ========================================================= */

  .intro-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
  }

  .intro-large {
    max-width: 650px;

    font-size: clamp(30px, 4vw, 58px);
    line-height: 1;
    letter-spacing: -.045em;
  }

  .intro-copy {
    max-width: 570px;
  }

  .intro-copy p {
    margin: 0 0 25px;

    color: #999;
    font-size: 14px;
    line-height: 1.9;
  }

  /* =========================================================
     SERVICES
     ========================================================= */

  .services-section {
    max-width: none;
  }

  .services-intro {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 50px;
    align-items: end;

    margin-bottom: 55px;
  }

  .services-intro p {
    max-width: 650px;
    color: #999;
    line-height: 1.8;
    font-size: 14px;
  }

  .service-mark {
    color: #444;
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: .16em;
    text-align: right;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .service-card {
    min-height: 380px;
    padding: 35px;

    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);

    background: rgba(255,255,255,.012);

    transition: background .25s ease;
  }

  .service-card:hover {
    background: rgba(255,255,255,.035);
  }

  .service-card-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 55px;
  }

  .card-number,
  .service-tag {
    color: #555;
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: .14em;
  }

  .service-card h3 {
    margin: 0 0 20px;

    font-size: clamp(28px, 4vw, 54px);
    line-height: .9;
    letter-spacing: -.055em;
  }

